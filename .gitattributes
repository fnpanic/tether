# Files copied to Linux relays and Macs as they are: keep LF on Windows checkouts too.
*.sh text eol=lf
server/systemd/* text eol=lf
server/caddy/Caddyfile text eol=lf

# Patches are applied to LF checkouts of upstream (scripts/bootstrap.sh): keep them LF everywhere.
patches/*.patch text eol=lf

# Monitoring config and installer, copied to the Linux nodes as they are.
deploy/monitoring/** text eol=lf
# Kernel settings copied to Linux relays.
server/sysctl/* text eol=lf

# Paseo relay files, copied to the Hetzner node as they are.
paseo-tunnel/relay/** text eol=lf
