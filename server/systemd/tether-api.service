[Unit]
Description=Tether relay API (policy, heartbeat, diagnostics, releases)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tether-api
Group=tether-api
# RELAY_HOST from server.env (install.sh): this relay's public host name(s), comma-separated.
# Signed requests of current apps name the relay they are for and are refused without it; the
# other values in server.env are not read by tether-api. api.env, read last, may override it.
EnvironmentFile=-/etc/tether/server.env
# ADMIN_PUB_KEY=<base64 Ed25519 key>[,<key>…]; empty disables the admin endpoints.
# Optional: AUDIT_RETENTION_DAYS (default 90, 0 = store no audit records), AUDIT_MAX_MB (default 50),
# TETHER_SIG_V1=off (refuse the older request signatures that are not bound to a relay, once
# every Tether Manage and technician app signs the new way).
# Device status: STATUS=off (every status route answers 503, Retry-After: 3600),
# STATUS_TARGET_RPS (posts per second the devices are paced to, default 10),
# STATUS_MAX_DEVICES (enrolled devices at most, default 20000; more needs a larger MemoryMax,
# docs/scaling.md).
EnvironmentFile=/etc/tether/api.env
ExecStart=/usr/local/bin/tether-api --data /var/lib/tether-api --listen 127.0.0.1:21120
Restart=always
RestartSec=3
MemoryMax=64M
LimitNOFILE=65536
# Files group-readable for Caddy (group tether-api), nothing for others.
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tether-api
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
