[Unit]
Description=Tether relay HTTPS/WebSocket front end (Caddy, TCP 443)
After=network-online.target tether-hbbs.service tether-hbbr.service
Wants=network-online.target

[Service]
Type=simple
User=tether-https
Group=tether-https
EnvironmentFile=/etc/tether/server.env
Environment=XDG_DATA_HOME=/var/lib/tether-https XDG_CONFIG_HOME=/var/lib/tether-https
ExecStart=/usr/local/bin/caddy run --config /etc/tether/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
LimitNOFILE=1048576
# Bind 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tether-https

[Install]
WantedBy=multi-user.target
