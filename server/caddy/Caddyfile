# Tether relay front end: everything clients need over TCP 443 (TLS + WebSocket).
# {$RELAY_HOST} comes from /etc/tether/server.env.
{
	admin off
	# Prometheus metrics of the HTTP server (requests, latency), read at 127.0.0.1:21125 below.
	metrics
}

# Metrics for Prometheus, localhost only (docs/monitoring.md). The admin API (which would serve
# them otherwise) stays off.
http://:21125 {
	bind 127.0.0.1
	metrics /metrics
}

{$RELAY_HOST} {
	tls {
		issuer acme {
			# Certificate via TLS-ALPN-01 on 443 only: no port 80 needed.
			disable_http_challenge
		}
	}

	# Rendezvous (hbbs) and relay (hbbr) WebSocket endpoints. Only Caddy can reach these ports.
	# The client IP they use: hbbs takes the last X-Forwarded-For hop (the peer Caddy saw), hbbr
	# X-Real-IP, which Caddy overwrites so a client-sent one never reaches them.
	handle /ws/id {
		reverse_proxy 127.0.0.1:21118 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}
	handle /ws/relay {
		reverse_proxy 127.0.0.1:21119 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	# Relay readiness for the other relays' hbbs (HA, docs/relay-ha.md): 200 "ready sessions=N",
	# 503 while hbbr drains.
	handle /readyz/relay {
		rewrite * /readyz
		reverse_proxy 127.0.0.1:21121
	}

	# Public key hbbs signs with (one base64 line; 404 without a signing key). Tether Manage reads
	# it to see that this relay switched during a server key rotation (docs/key-rotation.md).
	handle /rendezvous/pubkey {
		rewrite * /pubkey
		reverse_proxy 127.0.0.1:21122
	}

	# Relay API (tether-api). Caddy ignores client-sent X-Forwarded-For and sets the real peer.
	# Caddy reads the first 600 KiB of a body before it connects to tether-api, so a slow client
	# waits here, not in one of tether-api's workers: more than tether-api reads into memory
	# (512 KiB + 1; `512k` would be 512 000 bytes). Of the two uploads tether-api streams to disk
	# (release, diagnostics) only that start is held in memory, the rest streams through;
	# tether-api limits how many run at once and how slowly.
	handle /api/* {
		reverse_proxy 127.0.0.1:21120 {
			request_buffers 600KiB
			# Shorter than tether-api keeps an idle connection (30 s), so Caddy closes it first.
			transport http {
				keepalive 20s
			}
		}
	}

	# Optional extras from the monitoring installer (deploy/monitoring/install.sh): /_metrics/* for
	# the Prometheus on the other node, /grafana/* on the monitoring node. None by default.
	import /etc/tether/caddy.d/*.caddy

	# Private custom-app download links (GET /q/<token>[/mac|/windows], the macOS profile
	# /q/m/<mac id>; docs/api.md "Custom apps"). No access log
	# is configured: the tokens are secrets.
	# tether-api checks the token and names a prepared file (X-Accel-Redirect); Caddy sends it,
	# so a slow download does not hold one of tether-api's 32 workers. qcache/ is not under
	# download/, so it is reachable only this way.
	handle /q/* {
		reverse_proxy 127.0.0.1:21120 {
			request_buffers 600KiB
			transport http {
				keepalive 20s
			}
			header_up X-Tether-Accel 1
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /var/lib/tether-api
				rewrite * {rp.header.X-Accel-Redirect}
				header Content-Type {rp.header.Content-Type}
				header Content-Disposition {rp.header.Content-Disposition}
				header Cache-Control no-store
				header X-Content-Type-Options nosniff
				file_server
			}
		}
	}

	# Release downloads and update manifests written by tether-api. Caddy (user tether-https)
	# reads them through membership in group tether-api; see install.sh.
	handle /download/* {
		# The signed release index: tether-api serves it with ETag "<serial>" (equal on every
		# relay, so If-None-Match works across relays) and counts the fetches. releases-v2.json:
		# the same index with xz copies, read by TetherQS 0.5.31 / Tether 0.5.33 on. monitor.json:
		# the device-status agent's index (own app names, same rules).
		@index path_regexp ^/download/[a-z0-9-]+/(releases(-v2)?|monitor)\.json$
		handle @index {
			reverse_proxy 127.0.0.1:21120 {
				request_buffers 600KiB
				transport http {
					keepalive 20s
				}
			}
		}
		handle {
			root * /var/lib/tether-api
			@manifest path */latest.json
			header @manifest Cache-Control "no-cache"
			# No `precompressed gzip`: it sent browsers the TetherQS exe gzip-encoded with a 206 status
			# to a plain GET, and download scanners (Zscaler's sandbox) never finished analysing it
			# (2026-11-09). The TetherQS updater fetches TetherQS-<v>.exe.gz by its own URL and unpacks
			# it itself (apps/quick update.rs), so it keeps the 35 -> 15 MB saving.
			file_server
		}
	}

	# Download page, if one was published; otherwise the plain marker text.
	handle / {
		root * /var/lib/tether-api/download
		@page file /index.html
		handle @page {
			rewrite * /index.html
			file_server
		}
		handle {
			respond "Tether relay" 200
		}
	}

	handle {
		respond "Tether relay" 200
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
