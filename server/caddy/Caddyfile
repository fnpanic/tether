# Tether relay front end: everything clients need over TCP 443 (TLS + WebSocket).
# {$RELAY_HOST} comes from /etc/tether/server.env.
{
	admin off
}

{$RELAY_HOST} {
	tls {
		issuer acme {
			# Certificate via TLS-ALPN-01 on 443 only: no port 80 needed.
			disable_http_challenge
		}
	}

	# Rendezvous (hbbs) and relay (hbbr) WebSocket endpoints. Only Caddy can reach these ports.
	handle /ws/id {
		reverse_proxy 127.0.0.1:21118 {
			flush_interval -1
		}
	}
	handle /ws/relay {
		reverse_proxy 127.0.0.1:21119 {
			flush_interval -1
		}
	}

	# Relay readiness for the other relays' hbbs (HA, docs/relay-ha.md): 200 "ready sessions=N",
	# 503 while hbbr drains.
	handle /readyz/relay {
		rewrite * /readyz
		reverse_proxy 127.0.0.1:21121
	}

	# Relay API (tether-api). Caddy ignores client-sent X-Forwarded-For and sets the real peer.
	handle /api/* {
		reverse_proxy 127.0.0.1:21120
	}

	# Release downloads and update manifests written by tether-api. Caddy (user tether-https)
	# reads them through membership in group tether-api; see install.sh.
	handle /download/* {
		root * /var/lib/tether-api
		@manifest path */latest.json
		header @manifest Cache-Control "no-cache"
		file_server
	}

	# Download page, if one was published; otherwise the plain marker text.
	handle / {
		root * /var/lib/tether-api/download
		@page file /index.html
		handle @page {
			rewrite * /index.html
			file_server
		}
		handle {
			respond "Tether relay" 200
		}
	}

	handle {
		respond "Tether relay" 200
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
