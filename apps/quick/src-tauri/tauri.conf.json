{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TetherQS",
  "mainBinaryName": "TetherQS",
  "version": "0.5.27",
  "identifier": "net.tether.quick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": "macos/entitlements.plist",
      "infoPlist": "macos/Info.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
