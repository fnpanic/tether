+#[derive(Clone, Default)]
+pub struct TauriHandler {
+    key: Arc<RwLock<String>>,
+    /// Bitmask of codec ids decoded by the webview (see `super::CODEC_*`).
+    pub passthrough: Arc<AtomicU8>,
+    /// Passthrough frames never reach the core's video threads, so they are recorded here.
+    rec: Arc<Mutex<PassthroughRecording>>,
+}
+
+#[derive(Default)]
+struct PassthroughRecording {
+    on: bool,
+    peer_id: String,
+    /// Display sizes from peer info; the recorder needs them for the container header.
+    sizes: Vec<(usize, usize)>,
+    recorders: HashMap<usize, Recorder>,
+}
+
+impl TauriHandler {
+    pub fn key(&self) -> String {
+        self.key.read().unwrap().clone()
+    }
+
+    pub(super) fn record_passthrough(&self, display: usize, frame: &video_frame::Union) {
+        let mut r = self.rec.lock().unwrap();
+        if !r.on {
+            return;
+        }
+        let (w, h) = r.sizes.get(display).copied().unwrap_or((0, 0));
+        if !r.recorders.contains_key(&display) {
+            let ctx = RecorderContext {
+                server: false,
+                id: r.peer_id.clone(),
+                dir: crate::ui_interface::video_save_directory(false),
+                display_idx: display,
+                camera: false,
+                tx: None,
+            };
+            match Recorder::new(ctx) {
+                Ok(rec) => {
+                    r.recorders.insert(display, rec);
+                }
+                Err(e) => {
+                    log::error!("recorder for display {display}: {e}");
+                    r.on = false;
+                    return;
+                }
+            }
+        }
+        if let Some(rec) = r.recorders.get_mut(&display) {
+            // Frames before the first key frame are rejected; that only skips them.
+            rec.write_frame(frame, w, h).ok();
+        }
+    }
+
+    fn emit(&self, name: &str, payload: Value) {
+        emit(&self.key(), name, payload);
+    }
+}
+
+pub(super) fn new_session(
+    key: &str,
+    peer_id: &str,
+    password: &str,
+    conn_type: &str,
+    force_relay: bool,
+) -> Session<TauriHandler> {
+    let handler = TauriHandler::default();
+    *handler.key.write().unwrap() = key.to_owned();
+    handler.rec.lock().unwrap().peer_id = peer_id.to_owned();
+    let session: Session<TauriHandler> = Session {
+        password: password.to_owned(),
+        server_keyboard_enabled: Arc::new(RwLock::new(true)),
+        server_file_transfer_enabled: Arc::new(RwLock::new(true)),
+        server_clipboard_enabled: Arc::new(RwLock::new(true)),
+        reconnect_count: Arc::new(AtomicUsize::new(0)),
+        ui_handler: handler,
+        ..Default::default()
+    };
+    session.lc.write().unwrap().initialize(
+        peer_id.to_owned(),
+        super::conn_type_from_str(conn_type),
+        None,
+        force_relay,
+        None,
+        None,
+        None,
+    );
+    session
+}
