+/// A frame no connection took within this long means the path in front of it is full.
+pub const BACKLOG_MS: u128 = 1000;
+
+impl VideoQoS {
+    /// Tether: the video loop waited `waited_ms` (>= BACKLOG_MS) for a connection to take the
+    /// previous frame, i.e. the stream/link in front of it is full. This is seen on the host at
+    /// once, while the TestDelay probes behind the same backlog take seconds to confirm it and
+    /// the ratio then comes down one 3 s cooldown at a time: on a Mac host (H.265) a switch to
+    /// full-screen content froze the picture in ~3 s steps for ~11 s (docs/performance.md).
+    /// Halve the bitrate now (at most once a second); without ABR halve the fps instead.
+    /// Returns true when it changed something.
+    pub fn on_send_backlog(&mut self, waited_ms: u128) -> bool {
