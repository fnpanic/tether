+/// Tether: the latest `ReleaseHint` of every relay as the option `tether-release-hint`
+/// (`host=G/spread;…`, parsed by `tether_trust::release::parse_hints`). The app's update checker
+/// polls it: in-process (TetherQS), or through the option mirror of the UI process (technician app,
+/// where this runs in the `--server` process).
+fn store_release_hint(host: &str, generation: u64, spread_secs: u32) {
+    static HINTS: std::sync::Mutex<std::collections::BTreeMap<String, (u64, u32)>> =
+        std::sync::Mutex::new(std::collections::BTreeMap::new());
+    // Host name only (`wss://h/ws/id`, `h:21116` → `h`), as the app's API host list has it.
+    let h = host.strip_prefix("wss://").or_else(|| host.strip_prefix("ws://")).unwrap_or(host);
+    let h = h.split(['/', ':']).next().unwrap_or(h);
+    let host: String = h.chars().filter(|c| !matches!(c, ';' | '=') && !c.is_whitespace()).collect();
+    let value = {
+        let mut h = HINTS.lock().unwrap_or_else(|e| e.into_inner());
+        if h.get(&host) == Some(&(generation, spread_secs)) {
+            return;
+        }
+        h.insert(host, (generation, spread_secs));
+        h.iter().map(|(k, (g, s))| format!("{k}={g}/{s}")).collect::<Vec<_>>().join(";")
+    };
+    log::info!("release hint: {value}");
+    Config::set_option("tether-release-hint".to_owned(), value);
+}
