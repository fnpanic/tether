+
+    pub(super) fn encoded(vf: &VideoFrame, took: Duration) {
+        use video_frame::Union::*;
+        let frames = match &vf.union {
+            Some(Vp8s(f)) | Some(Vp9s(f)) | Some(Av1s(f)) | Some(H264s(f)) | Some(H265s(f)) => &f.frames,
+            _ => return,
