+/// Tether, Settings > Install as service: asks for an administrator, writes both launchd files,
+/// starts the root daemon and waits for the result. This process hosts until now and holds the
+/// IPC socket, so the agent (`--server`) is loaded only once it has exited, and Tether is then
+/// reopened: on `true` the caller must quit.
+pub fn install_daemon() -> bool {
+    if !is_installed() {
+        log::error!("install daemon: not running from /Applications");
+        return false;
+    }
+    let body = |name: &str| {
+        PRIVILEGES_SCRIPTS_DIR
+            .get_file(name)
+            .and_then(|f| f.contents_utf8())
+            .map(correct_app_name)
+    };
+    let (Some(script), Some(daemon), Some(agent)) =
+        (body("install.scpt"), body("daemon.plist"), body("agent.plist"))
+    else {
+        return false;
+    };
+    let status = Command::new("osascript")
+        .arg("-e")
+        .arg(script)
+        .arg(daemon)
+        .arg(agent)
+        .arg(&get_active_username())
+        .status();
+    let installed = is_installed_daemon(false);
+    log::info!("install daemon: osascript {:?}, installed: {}", status, installed);
+    if !installed {
+        return false;
+    }
+    let agent_plist = format!("/Library/LaunchAgents/{}_server.plist", crate::get_full_name());
+    let app = format!("/Applications/{}.app", crate::get_app_name());
+    Command::new("/bin/sh")
+        .arg("-c")
+        .arg("while kill -0 \"$1\" 2>/dev/null; do sleep 0.2; done; launchctl load -w \"$2\"; sleep 3; open \"$3\"")
+        .arg("sh")
+        .arg(std::process::id().to_string())
+        .arg(agent_plist)
+        .arg(app)
+        .spawn()
+        .map_err(|e| log::error!("install daemon: handoff failed: {}", e))
+        .is_ok()
+}
+
+/// Tether, launchd roles (`--service` as root, `--server`): an update replaces the app bundle
+/// under the running process. Once the binary on disk is another file and no session runs, exit
+/// with a failure code, so that launchd (KeepAlive) starts the new one.
+pub fn exit_when_replaced() {
+    use std::os::unix::fs::MetadataExt;
+    let Ok(exe) = std::env::current_exe() else {
+        return;
+    };
+    let file = move || std::fs::metadata(&exe).map(|m| (m.ino(), m.mtime())).ok();
+    let Some(started) = file() else {
+        return;
+    };
+    std::thread::spawn(move || loop {
+        std::thread::sleep(std::time::Duration::from_secs(10));
+        if file().is_some_and(|now| now != started)
+            && crate::server::AUTHED_CONNS.lock().unwrap().is_empty()
+        {
+            log::info!("the app was replaced on disk: exit, launchd starts the new one");
+            std::process::exit(1);
+        }
+    });
+}
