index 0000000..e997338
--- /dev/null
+++ b/src/tauri_ui/mod.rs
@@ -0,0 +1,328 @@
+//! Tether (Tauri) UI bridge. Replaces the Sciter `ui` module when built with `--features tauri`.
+//!
+//! The embedding app installs a [`UiSink`]; every UI callback from the session layer, the
+//! connection manager and the video path is forwarded to it as JSON events or binary frames.
+
+pub mod cm;
+pub mod files;
+pub mod remote;
+
+use std::{
+    collections::HashMap,
+    sync::{atomic::Ordering, Arc, Mutex, RwLock},
+};
+
+use base::message_proto::*;
+use hbb_common::{log, rendezvous_proto::ConnType};
+use serde_json::{json, Value};
+
+use crate::{
+    client::{Interface, QualityStatus},
+    ui_session_interface::{InvokeUiSession, Session},
+};
+
+pub use remote::TauriHandler;
+pub type TauriSession = Session<TauriHandler>;
+
+lazy_static::lazy_static! {
+    /// Session receiving raw keyboard grabs (read by `keyboard.rs`).
+    pub static ref CUR_SESSION: Arc<Mutex<Option<Session<TauriHandler>>>> = Default::default();
+    static ref SINK: RwLock<Option<Arc<dyn UiSink>>> = RwLock::new(None);
+    static ref SESSIONS: RwLock<HashMap<String, Session<TauriHandler>>> = Default::default();
+}
+
+/// Implemented by the embedding app (Tauri) to receive everything the core wants to show.
+pub trait UiSink: Send + Sync + 'static {
+    /// A JSON event for a remote session window, keyed by the app's session key.
+    fn session_event(&self, session: &str, name: &str, payload: Value);
+    /// One binary video packet, see [`encode_video_header`] for the layout.
+    fn video(&self, session: &str, packet: Vec<u8>);
+    /// Incoming-connection manager event (host side).
+    fn cm_event(&self, name: &str, payload: Value);
+}
+
+pub fn set_sink(sink: Arc<dyn UiSink>) {
+    *SINK.write().unwrap() = Some(sink);
+}
+
+pub(crate) fn sink() -> Option<Arc<dyn UiSink>> {
+    SINK.read().unwrap().clone()
+}
+
+// ---------------------------------------------------------------------------------------------
+// Video packets
+// ---------------------------------------------------------------------------------------------
+
+/// Packet kinds.
+pub const PKT_ENCODED: u8 = 0;
+pub const PKT_RGBA: u8 = 1;
+/// Codec ids inside an encoded packet.
+pub const CODEC_VP8: u8 = 1;
+pub const CODEC_VP9: u8 = 2;
+pub const CODEC_AV1: u8 = 3;
+pub const CODEC_H264: u8 = 4;
+pub const CODEC_H265: u8 = 5;
+pub const HEADER_LEN: usize = 16;
+
+/// 16-byte little-endian header followed by the payload:
+/// `kind u8 | codec u8 | flags u8 (bit0 key, bit1 bgra) | display u8 | w u32 | h u32 | pts u32`.
+pub fn encode_video_header(
+    kind: u8,
+    codec: u8,
+    flags: u8,
+    display: usize,
+    w: u32,
+    h: u32,
+    pts: i64,
+    payload_len: usize,
+) -> Vec<u8> {
+    let mut v = Vec::with_capacity(HEADER_LEN + payload_len);
+    v.push(kind);
+    v.push(codec);
+    v.push(flags);
+    v.push(display.min(255) as u8);
+    v.extend_from_slice(&w.to_le_bytes());
+    v.extend_from_slice(&h.to_le_bytes());
+    v.extend_from_slice(&(pts as u32).to_le_bytes());
+    v
+}
+
+fn codec_bit(codec: u8) -> u8 {
+    1 << codec
+}
+
+/// Called from the client io loop for every received video frame. Returns `true` when the
+/// frame was forwarded to the webview decoder and must not be decoded natively.
+pub fn video_passthrough<T: InvokeUiSession>(handler: &T, vf: &VideoFrame) -> bool {
+    let Some(h) = (handler as &dyn std::any::Any).downcast_ref::<TauriHandler>() else {
+        return false;
+    };
+    let (codec, frames) = match &vf.union {
+        Some(video_frame::Union::Vp8s(f)) => (CODEC_VP8, f),
+        Some(video_frame::Union::Vp9s(f)) => (CODEC_VP9, f),
+        Some(video_frame::Union::Av1s(f)) => (CODEC_AV1, f),
+        Some(video_frame::Union::H264s(f)) => (CODEC_H264, f),
+        Some(video_frame::Union::H265s(f)) => (CODEC_H265, f),
+        _ => return false,
+    };
+    if h.passthrough.load(Ordering::Relaxed) & codec_bit(codec) == 0 {
+        return false;
+    }
+    let Some(sink) = sink() else { return false };
+    let key = h.key();
+    for f in frames.frames.iter() {
+        let mut pkt = encode_video_header(
+            PKT_ENCODED,
+            codec,
+            f.key as u8,
+            vf.display as usize,
+            0,
+            0,
+            f.pts,
+            f.data.len(),
+        );
+        pkt.extend_from_slice(&f.data);
+        sink.video(&key, pkt);
+    }
+    true
+}
+
+// ---------------------------------------------------------------------------------------------
+// Sessions (viewer side)
+// ---------------------------------------------------------------------------------------------
+
+pub fn session_start(key: &str, peer_id: &str, password: &str, conn_type: &str, force_relay: bool) {
+    let session = remote::new_session(key, peer_id, password, conn_type, force_relay);
+    SESSIONS
+        .write()
+        .unwrap()
+        .insert(key.to_owned(), session.clone());
+    session.reconnect(force_relay);
+}
+
+pub fn session(key: &str) -> Option<Session<TauriHandler>> {
+    SESSIONS.read().unwrap().get(key).cloned()
+}
+
+pub fn session_close(key: &str) {
+    if let Some(s) = SESSIONS.write().unwrap().remove(key) {
+        s.close();
+        let mut cur = CUR_SESSION.lock().unwrap();
+        if cur.as_ref().map(|c| c.ui_handler.key() == key).unwrap_or(false) {
+            *cur = None;
+        }
+    }
+}
+
+/// Mark the session as the one receiving keyboard focus.
+pub fn session_focus(key: &str) {
+    *CUR_SESSION.lock().unwrap() = session(key);
+}
+
+/// Formats (`vp8`,`vp9`,`av1`,`h264`,`h265`) the webview can decode with WebCodecs.
+pub fn session_set_webcodecs(key: &str, formats: &[String]) {
+    let mut mask = 0u8;
+    let mut external = 0u8;
+    for f in formats {
+        match f.as_str() {
+            "vp8" => mask |= codec_bit(CODEC_VP8),
+            "vp9" => mask |= codec_bit(CODEC_VP9),
+            "av1" => mask |= codec_bit(CODEC_AV1),
+            "h264" => {
+                mask |= codec_bit(CODEC_H264);
+                external |= scrap::codec::EXTERNAL_DECODING_H264;
+            }
+            "h265" => {
+                mask |= codec_bit(CODEC_H265);
+                external |= scrap::codec::EXTERNAL_DECODING_H265;
+            }
+            _ => {}
+        }
+    }
+    scrap::codec::EXTERNAL_DECODING.store(external, Ordering::Relaxed);
+    if let Some(s) = session(key) {
+        s.ui_handler.passthrough.store(mask, Ordering::Relaxed);
+        s.send(crate::client::Data::Message(
+            s.lc.read().unwrap().update_supported_decodings(),
+        ));
+    }
+}
+
+/// The webview failed to decode `format`: decode it natively from now on and ask for a key frame.
+pub fn session_webcodecs_failed(key: &str, codec: u8, display: i32) {
+    if let Some(s) = session(key) {
+        s.ui_handler
+            .passthrough
+            .fetch_and(!codec_bit(codec), Ordering::Relaxed);
+        log::warn!("webcodecs failed for codec {codec}, falling back to native decoding");
+        s.refresh_video(display);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Main window helpers (thin re-exports of the crate-private ui_interface)
+// ---------------------------------------------------------------------------------------------
+
+pub mod api {
+    pub use crate::ui_interface::{
+        generate2fa, get_async_job_status, get_connect_status, get_option, get_options,
+        has_valid_2fa, verify2fa,
+        get_local_option, set_local_option, is_installed, set_option, temporary_password,
+        update_temporary_password, UiStatus,
+    };
+
+    /// Starts the background thread that mirrors server status/options into this UI process.
+    pub fn start_status_sync() {
+        crate::ui_interface::start_option_status_sync();
+    }
+
+    pub fn disable_2fa() {
+        crate::ui_interface::set_option("2fa".to_owned(), String::new());
+    }
+
+    pub fn get_id() -> String {
+        crate::ipc::get_id()
+    }
+
+    pub fn set_permanent_password(pw: String) -> bool {
+        crate::ui_interface::set_permanent_password_with_result(pw)
+    }
+
+    pub fn get_peer_name(id: &str) -> String {
+        let c = crate::ui_interface::get_peer(id.to_owned());
+        if !c.info.hostname.is_empty() {
+            c.info.hostname
+        } else {
+            c.info.username
+        }
+    }
+
+    /// Recent peers, newest first: `(id, hostname, username, platform)`.
+    pub fn recent_peers(limit: usize) -> Vec<serde_json::Value> {
+        hbb_common::config::PeerConfig::peers(None)
+            .into_iter()
+            .take(limit)
+            .map(|(id, _, p)| {
+                serde_json::json!({
+                    "id": id,
+                    "hostname": p.info.hostname,
+                    "username": p.info.username,
+                    "platform": p.info.platform,
+                })
+            })
+            .collect()
+    }
+
+    pub fn remove_peer(id: &str) {
+        hbb_common::config::PeerConfig::remove(id);
+    }
+
+    pub fn install_service() {
+        crate::ui_interface::install_me(
+            "desktopicon startmenu".to_owned(),
+            crate::ui_interface::install_path(),
+            false,
+            false,
+        );
+    }
+
+    /// Blocking HTTPS PUT of a file through the core's proxy/TLS-aware client.
+    pub fn http_put_file(url: &str, bearer: &str, path: &std::path::Path) -> Result<(), String> {
+        let client = crate::hbbs_http::create_http_client_with_url_strict(url)
+            .map_err(|e| e.to_string())?;
+        let file = std::fs::File::open(path).map_err(|e| e.to_string())?;
+        // The blocking client's 30 s default would cut off large recordings.
+        let mut req = client
+            .put(url)
+            .timeout(std::time::Duration::from_secs(3600))
+            .body(file);
+        if !bearer.is_empty() {
+            req = req.bearer_auth(bearer);
+        }
+        let res = req.send().map_err(|e| e.to_string())?;
+        if res.status().is_success() {
+            Ok(())
+        } else {
+            Err(format!("HTTP {}", res.status()))
+        }
+    }
+
+    pub fn app_name() -> String {
+        crate::get_app_name()
+    }
+
+    pub fn version() -> String {
+        crate::VERSION.to_owned()
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Sciter-module shims required by shared non-flutter code
+// ---------------------------------------------------------------------------------------------
+
+pub(crate) fn emit(key: &str, name: &str, payload: Value) {
+    if let Some(s) = sink() {
+        s.session_event(key, name, payload);
+    }
+}
+
+pub(crate) fn quality_json(qs: &QualityStatus) -> Value {
+    json!({
