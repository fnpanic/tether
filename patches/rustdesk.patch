diff --git a/libs/enigo/src/macos/hid_post.rs b/libs/enigo/src/macos/hid_post.rs
new file mode 100644
index 0000000..bce2920
--- /dev/null
+++ b/libs/enigo/src/macos/hid_post.rs
@@ -0,0 +1,138 @@
+//! Left-button drags through IOKit's HID event path (`IOHIDPostEvent`).
+//!
+//! The Screenshot app's selection (Cmd+Shift+5) grows only by the deltas of drags that enter at the
+//! HID level: a CGEvent drag moves the pointer but draws no rectangle there, while Cmd+Shift+4 and
+//! ordinary apps accept both. Presses and releases stay CGEvents (a HID click does not reach
+//! system dialogs such as the permission prompts). Checked on macOS 15 (2026-11-10).
+//! Every function returns false when the HID path is unavailable; the caller then posts the
+//! CGEvent as before.
+
+use std::os::raw::{c_char, c_void};
+use std::sync::{Mutex, OnceLock};
+
+const NX_MOUSEMOVED: u32 = 5;
+const NX_LMOUSEDRAGGED: u32 = 6;
+const K_NX_EVENT_DATA_VERSION: u32 = 2;
+const K_IOHID_SET_CURSOR_POSITION: u32 = 0x2;
+const K_IOHID_PARAM_CONNECT_TYPE: u32 = 1;
+
+#[repr(C)]
+struct IOGPoint {
+    x: i16,
+    y: i16,
+}
+
+/// `NXEventData` (a union of at most 48 bytes); its `mouseMove` member: dx at 0, dy at 4.
+#[repr(C, align(8))]
+struct EventData([u8; 64]);
+
+#[link(name = "IOKit", kind = "framework")]
+extern "C" {
+    fn IOServiceMatching(name: *const c_char) -> *mut c_void;
+    fn IOServiceGetMatchingService(main_port: u32, matching: *mut c_void) -> u32;
+    fn IOServiceOpen(service: u32, owning_task: u32, connect_type: u32, connect: *mut u32) -> i32;
+    fn IOObjectRelease(object: u32) -> i32;
+    fn IOHIDPostEvent(connect: u32, event_type: u32, location: IOGPoint, event_data: *const EventData, event_data_version: u32, event_flags: u32, options: u32) -> i32;
+}
+
+extern "C" {
+    static mach_task_self_: u32;
+    fn CGEventSourceCounterForEventType(state_id: i32, event_type: u32) -> u32;
+}
+
+const CG_HID_SYSTEM_STATE: i32 = 1;
+
+/// Where the last HID event put the pointer: a drag carries the step from there as its delta.
+static LAST: Mutex<(f64, f64)> = Mutex::new((0.0, 0.0));
+
+/// The IOHIDSystem connection, opened once; `None` when it cannot be opened.
+fn connection() -> Option<u32> {
+    static CONNECT: OnceLock<Option<u32>> = OnceLock::new();
+    *CONNECT.get_or_init(|| unsafe {
+        let service = IOServiceGetMatchingService(0, IOServiceMatching(b"IOHIDSystem\0".as_ptr() as *const c_char));
+        if service == 0 {
+            log::warn!("IOHIDSystem not found: left-button drags use CGEvent");
+            return None;
+        }
+        let mut connect = 0u32;
+        let r = IOServiceOpen(service, mach_task_self_, K_IOHID_PARAM_CONNECT_TYPE, &mut connect);
+        IOObjectRelease(service);
+        if r != 0 {
+            log::warn!("IOHIDSystem not opened ({r:#x}): left-button drags use CGEvent");
+            return None;
+        }
+        Some(connect)
+    })
+}
+
+/// `NXEventData.mouseMove` with the step (dx, dy).
+fn move_data(dx: f64, dy: f64) -> EventData {
+    let mut d = EventData([0; 64]);
+    d.0[0..4].copy_from_slice(&(dx.round() as i32).to_ne_bytes());
+    d.0[4..8].copy_from_slice(&(dy.round() as i32).to_ne_bytes());
+    d
+}
+
+fn post(event_type: u32, x: f64, y: f64, dx: f64, dy: f64, flags: u32) -> bool {
+    let Some(connect) = connection() else { return false };
+    let clamp = |v: f64| v.round().clamp(i16::MIN as f64, i16::MAX as f64) as i16;
+    let r = unsafe { IOHIDPostEvent(connect, event_type, IOGPoint { x: clamp(x), y: clamp(y) }, &move_data(dx, dy), K_NX_EVENT_DATA_VERSION, flags, K_IOHID_SET_CURSOR_POSITION) };
+    if r != 0 {
+        hbb_common_throttled_warn(event_type, r);
+        return false;
+    }
+    *LAST.lock().unwrap() = (x, y);
+    true
+}
+
+/// At most one warning per minute: a failing HID path would otherwise log every drag step.
+fn hbb_common_throttled_warn(event_type: u32, r: i32) {
+    static LAST_WARN: Mutex<Option<std::time::Instant>> = Mutex::new(None);
+    let mut last = LAST_WARN.lock().unwrap();
+    if last.map_or(true, |t| t.elapsed() > std::time::Duration::from_secs(60)) {
+        *last = Some(std::time::Instant::now());
+        log::warn!("IOHIDPostEvent {event_type} failed ({r:#x}), using CGEvent");
+    }
+}
+
+/// Right before the left button goes down at (x, y) (global points): the pointer got there by
+/// CGEvents, which the HID side does not see, so a HID move to the same point (button still up)
+/// lets the first drag's delta start from here.
+///
+/// The HID path is slower than a CGEvent: without the wait the move reaches the app after the
+/// press, as a plain move with the button down, and WebKit views then drop the text selection the
+/// drag should make (seen: a WKWebView text field, 2026-11-11). So wait until the window server
+/// has counted the move.
+pub fn left_pressed(x: f64, y: f64, flags: u32) -> bool {
+    let moves = || unsafe { CGEventSourceCounterForEventType(CG_HID_SYSTEM_STATE, NX_MOUSEMOVED) };
+    let before = moves();
+    if !post(NX_MOUSEMOVED, x, y, 0.0, 0.0, flags) {
+        return false;
+    }
+    // shortcut: 30 ms cap, then the press goes out anyway (a late press is worse than a lost selection).
+    let start = std::time::Instant::now();
+    while moves() == before && start.elapsed() < std::time::Duration::from_millis(30) {
+        std::thread::sleep(std::time::Duration::from_micros(500));
+    }
+    log::trace!("HID sync move counted after {:?}", start.elapsed());
+    true
+}
+
+/// A drag with the left button held, to (x, y).
+pub fn left_dragged(x: f64, y: f64, flags: u32) -> bool {
+    let (lx, ly) = *LAST.lock().unwrap();
+    post(NX_LMOUSEDRAGGED, x, y, x - lx, y - ly, flags)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn move_data_layout() {
+        let d = move_data(20.4, -13.0);
+        assert_eq!(i32::from_ne_bytes(d.0[0..4].try_into().unwrap()), 20);
+        assert_eq!(i32::from_ne_bytes(d.0[4..8].try_into().unwrap()), -13);
+        assert!(d.0[8..].iter().all(|b| *b == 0));
+    }
+}
