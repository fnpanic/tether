+
+/// Codecs decoded outside this process (e.g. by a webview's WebCodecs), advertised to the peer
+/// even when no native decoder exists.
+pub static EXTERNAL_DECODING: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+pub const EXTERNAL_DECODING_H264: u8 = 1;
+pub const EXTERNAL_DECODING_H265: u8 = 2;
+
+/// Tether: keep software AV1 on hosts with <= 4 GB RAM instead of falling back to VP8. Measured on a
+/// GPU-less 1080p VM while dragging a window at the same ~1.4 Mbit/s target (docs/performance.md):
+/// AV1 ~19 fps at ~22 ms/frame, VP8 ~3 fps (rate control drops frames: VP8 needs far more bits for
+/// screen content). The AV1 speed test (`test_av1`) still guards hosts too slow for AV1.
+pub fn keep_av1_on_low_memory(auto_codec: CodecFormat) -> bool {
+    cfg!(feature = "tauri") && auto_codec == CodecFormat::AV1
+}
+
+#[cfg(all(test, feature = "tauri"))]
+mod tether_tests {
+    use super::*;
+
+    #[test]
+    fn low_memory_keeps_av1_but_not_vp9() {
+        assert!(keep_av1_on_low_memory(CodecFormat::AV1));
+        assert!(!keep_av1_on_low_memory(CodecFormat::VP9));
+    }
+}
