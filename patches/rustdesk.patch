+        let avg = w.enc_us.iter().map(|&u| u as f64).sum::<f64>() / w.enc_us.len().max(1) as f64;
+        log::info!(
+            "fluxrt video/min: {:?} {:.1} fps, encode avg {:.1} p95 {:.1} max {:.1} ms, {:.0} kbit/s, largest frame {} KB, {} key, {} no output, wait >=1s {} (3s timeout {}, max {} ms); qos fps {fps} ratio {ratio:.3} target {kbps} kbit/s",
+            w.codec,
+            w.frames as f64 / secs,
+            avg / 1000.0,
+            ms(p95),
+            ms(w.enc_us.last().copied().unwrap_or_default()),
+            w.bytes as f64 * 8.0 / 1000.0 / secs,
+            w.max_frame / 1024,
+            w.keys,
+            w.empty,
+            w.backlogs,
+            w.timeouts,
+            w.max_wait.as_millis(),
+        );
+        // Before the encoder: avg / p95 ms of each step ("-" = not known for this capturer).
+        let stat = |v: &mut Vec<u32>| {
+            if v.is_empty() {
