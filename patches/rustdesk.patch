@@ -0,0 +1,87 @@
+//! Host-side connection manager: incoming connection requests, permissions, chat.
+
+use serde_json::{json, Value};
+
+use crate::ui_cm_interface::{start_ipc, Client, ConnectionManager, InvokeUiCM};
+
+#[derive(Clone, Default)]
+pub struct TauriCmHandler;
+
+fn emit(name: &str, payload: Value) {
+    if let Some(s) = super::sink() {
+        s.cm_event(name, payload);
+    }
+}
+
+impl InvokeUiCM for TauriCmHandler {
+    fn add_connection(&self, client: &Client) {
+        emit("add_connection", serde_json::to_value(client).unwrap_or(Value::Null));
+    }
+
+    fn remove_connection(&self, id: i32, close: bool) {
+        emit("remove_connection", json!({ "id": id, "close": close }));
+    }
+
+    fn new_message(&self, id: i32, text: String) {
+        emit("chat", json!({ "id": id, "text": text }));
+    }
+
+    fn change_theme(&self, dark: String) {
+        emit("theme", json!({ "dark": dark }));
+    }
+
+    fn change_language(&self) {}
+
+    fn show_elevation(&self, show: bool) {
+        emit("elevation", json!({ "show": show }));
+    }
+
+    fn update_voice_call_state(&self, client: &Client) {
+        emit("voice_call", serde_json::to_value(client).unwrap_or(Value::Null));
+    }
+
+    fn file_transfer_log(&self, action: &str, log: &str) {
+        emit("file_log", json!({ "action": action, "log": log }));
+    }
+}
+
+/// Start listening for connections from the local `--server` process. Call once in `--cm` mode.
+pub fn start() {
+    #[cfg(target_os = "linux")]
+    std::thread::spawn(crate::ipc::start_pa);
+    let cm = ConnectionManager {
+        ui_handler: TauriCmHandler,
+    };
+    std::thread::spawn(move || start_ipc(cm));
+}
+
+pub use crate::ui_cm_interface::{
+    authorize, can_elevate, close, elevate_portable, send_chat, switch_permission,
+};
+
+lazy_static::lazy_static! {
+    static ref RECORD_CONSENT_TEXT: std::sync::RwLock<String> =
+        std::sync::RwLock::new("The technician wants to record this session. Allow?".to_owned());
+}
+
+/// Question shown to the local user when a viewer wants to record (policy `recording.consent-text`).
+pub fn set_record_consent_text(text: String) {
+    if !text.trim().is_empty() {
+        *RECORD_CONSENT_TEXT.write().unwrap() = text;
+    }
+}
+
+/// A viewer asked to record connection `conn_id`; it may only once the user allows it.
+pub(crate) fn record_consent_request(conn_id: i32, peer_name: String) {
+    let text = RECORD_CONSENT_TEXT.read().unwrap().clone();
+    emit(
+        "record_consent_request",
+        json!({ "conn_id": conn_id, "peer_name": peer_name, "text": text }),
+    );
+}
+
+/// The user's answer. Allow grants the connection's `recording` permission (the viewer then starts
+/// its recorder); deny re-sends it as off, which the viewer reports as declined.
+pub fn record_consent(conn_id: i32, allow: bool) {
+    switch_permission(conn_id, "recording".to_owned(), allow);
+}
