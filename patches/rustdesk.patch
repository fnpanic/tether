@@ -31,10 +31,31 @@ message VideoFrame {
     EncodedVideoFrames h265s = 11;
     EncodedVideoFrames vp8s = 12;
     EncodedVideoFrames av1s = 13;
+    // Tether: exact pixels of what stands still, only for viewers with SupportedDecoding.exact_stills.
+    ExactStrips exact = 20;
   }
   int32 display = 14;
 }
 
+// Tether: `height` full-width rows from row `y`: zstd of RGB, each pixel minus the one to its left;
+// `hash` names these rows.
+message ExactStrip {
+  uint32 y = 1;
+  uint32 height = 2;
+  bytes data = 3;
+  uint32 hash = 4;
+}
+
+// Tether: strips of a picture `width` wide, cut every `rows` rows. `strips`: new exact rows.
+// `same` (sent right after a video frame, without strips): the strips the viewer already holds
+// and puts back over that frame, as pairs of first row and hash.
+message ExactStrips {
+  uint32 width = 1;
+  uint32 rows = 2;
+  repeated ExactStrip strips = 3;
+  repeated uint32 same = 4;
+}
+
 message DisplayInfo {
   sint32 x = 1;
   sint32 y = 2;
