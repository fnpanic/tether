+                .backlog_cut_instant
+                .is_some_and(|t| self.since(t) < Duration::from_secs(1))
+        {
+            return false;
+        }
+        self.backlog_cut_instant = Some(self.now());
+        if self.can_reduce_bitrate() {
+            let min = self.min_ratio();
+            self.ratio = (self.ratio * 0.5).max(min);
+            // The periodic controller starts a cooldown, and replies to probes sent before the
+            // cut must not cut again (bitrate) or brake the fps on top of it.
+            self.adjust_ratio_instant = self.now();
+            self.reset_send_counters();
+            for user in self.users.values_mut() {
+                user.delay.replies_after_bitrate_reduction = Some(0);
+            }
+        } else {
