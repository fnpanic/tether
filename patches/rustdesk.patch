+
+/// Tether: the quantizer ceiling for a quality ratio `b` (ratio x 100). At normal quality the
+/// codec's own ceiling stays; once QoS has lowered the ratio below 0.5 because the path cannot
+/// keep up, the ceiling rises towards 63 so heavy content (a photo, a full-screen change) still
+/// fits the bitrate: a coarser picture for a moment instead of multi-second frames and freezes.
+pub fn overload_q_max(b: u32, q_max: u32) -> u32 {
+    const KNEE: u32 = 50;
+    if b >= KNEE || q_max >= 63 {
+        return q_max;
+    }
+    q_max + (63 - q_max) * (KNEE - b) / KNEE
+}
+
