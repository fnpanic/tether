+/// (composed by the system until picked up), and how long the copy to memory took, in
+/// microseconds; 0 = the capturer does not know. Set by the Windows.Graphics.Capture path.
+pub static CAPTURE_AGE_US: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
