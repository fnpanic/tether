+#[cfg(all(test, feature = "tauri"))]
+mod server_race_tests {
+    use super::{first_ok_staggered, order_servers};
+    use hbb_common::{
+        anyhow::anyhow,
+        futures::future::{BoxFuture, FutureExt},
+        tokio,
+        tokio::time::{sleep, Duration, Instant},
+        ResultType,
+    };
+
+    fn after(ms: u64, r: Result<&'static str, &'static str>) -> BoxFuture<'static, ResultType<&'static str>> {
+        async move {
+            sleep(Duration::from_millis(ms)).await;
+            r.map_err(|e| anyhow!(e))
+        }
+        .boxed()
+    }
+
+    const STAGGER: Duration = Duration::from_millis(500);
+
+    #[tokio::test]
+    async fn failed_server_hands_over_at_once() {
+        let t = Instant::now();
+        let got = first_ok_staggered(vec![after(20, Err("connect failed")), after(20, Ok("b"))], STAGGER).await;
+        assert_eq!(got.unwrap(), "b");
+        assert!(t.elapsed() < Duration::from_millis(300));
+    }
+
+    #[tokio::test]
+    async fn hanging_server_is_overtaken_after_the_stagger() {
+        let t = Instant::now();
+        let got = first_ok_staggered(vec![after(60_000, Ok("a")), after(20, Ok("b"))], STAGGER).await;
+        assert_eq!(got.unwrap(), "b");
+        assert!(t.elapsed() < Duration::from_millis(900));
+    }
+
+    #[tokio::test]
+    async fn healthy_primary_never_starts_the_others() {
+        let got = first_ok_staggered(vec![after(50, Ok("a")), after(0, Ok("b"))], STAGGER).await;
+        assert_eq!(got.unwrap(), "a");
+    }
+
+    #[tokio::test]
+    async fn all_failed_reports_offline_over_transport_errors() {
+        let got = first_ok_staggered(
+            vec![after(10, Err("connection refused")), after(10, Err("Remote desktop is offline"))],
+            STAGGER,
+        )
+        .await;
+        assert_eq!(got.unwrap_err().to_string(), "Remote desktop is offline");
+        let got = first_ok_staggered(vec![after(10, Err("a down")), after(5, Err("b down"))], STAGGER).await;
+        assert_eq!(got.unwrap_err().to_string(), "a down");
+    }
+
+    #[test]
+    fn last_good_server_goes_first() {
+        let s = |v: &[&str]| v.iter().map(|x| x.to_string()).collect::<Vec<_>>();
+        assert_eq!(order_servers(s(&["a:1", "b:1"]), "b:1"), s(&["b:1", "a:1"]));
+        assert_eq!(order_servers(s(&["a:1", "b:1"]), ""), s(&["a:1", "b:1"]));
+    }
+}
