+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const NONE: Duration = Duration::ZERO;
+
+    fn exact(m: &Message) -> &ExactStrips {
+        match &m.video_frame().union {
+            Some(video_frame::Union::Exact(s)) => s,
+            _ => panic!("not exact strips"),
+        }
+    }
+
+    fn rows(m: &Option<Message>) -> Vec<(u32, u32)> {
+        m.as_ref().map_or(Vec::new(), |m| exact(m).strips.iter().map(|s| (s.y, s.height)).collect())
+    }
+
+    #[test]
+    fn strip_round_trip_with_a_wide_stride() {
+        // 3x2 picture, stride 16 (4 bytes of padding per row), BGRA.
+        let mut bgra = vec![0u8; 32];
+        let px = [[10u8, 20, 30], [10, 20, 30], [250, 0, 7], [1, 2, 3], [255, 255, 255], [0, 0, 0]];
+        for (i, p) in px.iter().enumerate() {
+            let o = (i / 3) * 16 + (i % 3) * 4;
+            bgra[o..o + 4].copy_from_slice(&[p[2], p[1], p[0], 0]);
+        }
+        let f = filtered(&bgra, 16, 3, 0, 2);
+        assert_eq!(&f[3..6], &[0, 0, 0]); // the second pixel equals the first
+        let rgba = exact_rows(&f, 3, 2).unwrap();
+        for (i, p) in px.iter().enumerate() {
+            assert_eq!(&rgba[i * 4..i * 4 + 4], &[p[0], p[1], p[2], 255]);
+        }
+        assert!(exact_rows(&f, 3, 3).is_none());
+    }
+
+    #[test]
+    fn strips_cover_the_picture_once_in_one_message_and_respect_rate_and_budget() {
+        // 4 px wide, 20 rows: strips of 8, 8 and 4 rows.
+        let t = Instant::now();
+        let pic = vec![7u8; 16 * 20];
+        let mut e = ExactStill::default();
+        e.keep_pixels(Some((&pic, 4, 20, 16)), t);
+        let m = e.strips_at(0, 1e9, 1 << 20, NONE, t);
+        assert_eq!(rows(&m), [(0, 8), (8, 8), (16, 4)]);
+        assert_eq!((exact(m.as_ref().unwrap()).width, exact(m.as_ref().unwrap()).rows), (4, 8));
+        // Sent ahead of a tiny rate: nothing more for now; and nothing is left anyway.
+        assert!(e.strips_at(0, 1.0, 1 << 20, NONE, t).is_none());
+        e.debt = 0.0;
+        assert!(e.strips_at(0, 1e9, 1 << 20, NONE, t).is_none());
+        // A budget of one byte: one strip per pass.
+        let mut e = ExactStill::default();
+        e.keep_pixels(Some((&pic, 4, 20, 16)), t);
+        for want in [vec![(0, 8)], vec![(8, 8)], vec![(16, 4)], vec![]] {
+            assert_eq!(rows(&e.strips_at(0, 1e9, 1, NONE, t)), want);
+            e.debt = 0.0;
+        }
+    }
+
+    #[test]
+    fn only_changed_strips_are_sent_again_and_the_rest_is_named_as_held() {
+        let t = Instant::now();
+        let mut e = ExactStill::default();
+        // 3 px wide with a stride of 16: 4 bytes of padding behind each row.
+        let mut pic = vec![7u8; 16 * 20];
+        e.keep_pixels(Some((&pic, 3, 20, 16)), t);
+        // Nothing held before anything was sent; the viewers are told once (they may remember
+        // strips from before), not again while nothing changes.
+        assert!(exact(&e.list_if_changed(0).unwrap()).same.is_empty());
+        assert!(e.list_if_changed(0).is_none());
+        let first = e.strips_at(0, 1e9, 1 << 20, NONE, t).unwrap();
+        let hash = |y: u32| exact(&first).strips.iter().find(|s| s.y == y).unwrap().hash;
+        // The same picture again, with other bytes in the padding behind each row: all held.
+        for r in 0..20 {
+            pic[r * 16 + 12] = r as u8;
+        }
+        e.keep_pixels(Some((&pic, 3, 20, 16)), t);
+        assert_eq!(exact(&e.list_if_changed(0).unwrap()).same, [0, hash(0), 8, hash(8), 16, hash(16)]);
+        assert!(e.list_if_changed(0).is_none());
+        e.debt = 0.0;
+        assert!(e.strips_at(0, 1e9, 1 << 20, NONE, t).is_none());
+        // A change in row 9: the middle strip is no longer held and is the only one sent again.
+        pic[9 * 16 + 4] = 99;
+        e.keep_pixels(Some((&pic, 3, 20, 16)), t);
+        assert_eq!(exact(&e.list_if_changed(0).unwrap()).same, [0, hash(0), 16, hash(16)]);
+        e.debt = 0.0;
+        let again = e.strips_at(0, 1e9, 1 << 20, NONE, t).unwrap();
+        assert_eq!(rows(&Some(again.clone())), [(8, 8)]);
+        assert_ne!(exact(&again).strips[0].hash, hash(8));
+        // A key frame went out (the viewers dropped their list): the same list is sent again.
+        e.relist();
+        assert_eq!(exact(&e.list_if_changed(0).unwrap()).same, [0, hash(0), 8, exact(&again).strips[0].hash, 16, hash(16)]);
+        assert!(e.list_if_changed(0).is_none());
+        // Other viewers: nothing is held and they are told, even though the list was empty before.
+        e.forget();
+        assert!(exact(&e.list_if_changed(0).unwrap()).same.is_empty());
+        e.forget();
+        assert!(exact(&e.list_if_changed(0).unwrap()).same.is_empty());
+        e.debt = 0.0;
+        assert_eq!(rows(&e.strips_at(0, 1e9, 1 << 20, NONE, t)).len(), 3);
+        assert_eq!(exact(&e.list_if_changed(0).unwrap()).same.len(), 6);
+        // Another size, or no pixels: nothing is held.
+        e.keep_pixels(Some((&pic[..16 * 16], 3, 16, 16)), t);
+        assert!(exact(&e.list_if_changed(0).unwrap()).same.is_empty());
+        e.keep_pixels(None, t);
+        assert!(e.list_if_changed(0).is_none() && e.strips_at(0, 1e9, 1 << 20, NONE, t).is_none());
+    }
+
+    #[test]
+    fn a_strip_waits_until_it_has_stood_still_while_another_keeps_changing() {
+        let t = Instant::now();
+        let sec = Duration::from_secs(1);
+        let mut e = ExactStill::default();
+        let mut pic = vec![7u8; 16 * 20];
+        e.keep_pixels(Some((&pic, 4, 20, 16)), t);
+        // Too early for all of them.
+        assert!(e.strips_at(0, 1e9, 1 << 20, sec, t + sec / 2).is_none());
+        // A cursor blinks in the last strip every half second: the other two become exact.
+        pic[17 * 16] = 1;
+        e.keep_pixels(Some((&pic, 4, 20, 16)), t + sec / 2);
+        assert_eq!(rows(&e.strips_at(0, 1e9, 1 << 20, sec, t + sec)), [(0, 8), (8, 8)]);
+        pic[17 * 16] = 2;
+        e.keep_pixels(Some((&pic, 4, 20, 16)), t + sec);
+        e.debt = 0.0;
+        assert!(e.strips_at(0, 1e9, 1 << 20, sec, t + sec * 3 / 2).is_none());
+        // The cursor stops: a second later its strip follows.
+        e.debt = 0.0;
+        assert_eq!(rows(&e.strips_at(0, 1e9, 1 << 20, sec, t + sec * 2)), [(16, 4)]);
+    }
+}
