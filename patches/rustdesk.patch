+/// Tether: remember a remote connection's companion secret (see `is_file_transfer_of_authed_session`).
+fn companion_register(conn_id: i32, secret: &[u8], file: bool) {
+    let alive = ALIVE_CONNS.lock().unwrap().clone();
+    let mut m = FT_COMPANIONS.lock().unwrap();
+    m.retain(|id, _| alive.contains(id));
+    if secret.len() >= 16 {
+        m.insert(conn_id, (secret.to_vec(), file));
+    }
+}
+
+fn companion_set_file(conn_id: i32, file: bool) {
+    if let Some(e) = FT_COMPANIONS.lock().unwrap().get_mut(&conn_id) {
+        e.1 = file;
+    }
+}
+
+/// Constant-time comparison of two companion secrets.
+fn same_secret(a: &[u8], b: &[u8]) -> bool {
+    a.len() == b.len() && a.iter().zip(b.iter()).fold(0u8, |d, (x, y)| d | (x ^ y)) == 0
+}
+
+/// Tether: how long after an accepted remote connection ended the same client may come back in
+/// without a second accept or password (a dropped network, a reloaded window). A one-time
+/// password has changed by then, so this is the only way back in that the technician has.
+const RESUME_WINDOW: Duration = Duration::from_secs(120);
+
+/// Tether: an accepted remote session (by click or by password), for `is_resume_of_authed_session`.
+struct ResumeTicket {
+    secret: Vec<u8>,
+    conn_id: i32,
+    /// None while that connection runs.
+    ended: Option<Instant>,
+    /// As the host user last set them for that connection.
+    perms: ResumePerms,
+}
+
+/// keyboard, clipboard, audio, file, restart, recording, block_input, privacy_mode
+type ResumePerms = [bool; 8];
+
+impl ResumeTicket {
+    fn admits(&self, secret: &[u8], conn_alive: bool) -> bool {
+        self.valid(conn_alive) && secret.len() >= 16 && same_secret(&self.secret, secret)
+    }
+    // Never ended but gone: its `on_close` was missed, treat it as expired.
+    fn valid(&self, conn_alive: bool) -> bool {
+        self.ended.map_or(conn_alive, |t| t.elapsed() < RESUME_WINDOW)
+    }
+}
+
+/// Returns the connection of this session that still runs: the caller closes it.
+fn resume_register(key: SessionKey, conn_id: i32, secret: &[u8], perms: ResumePerms) -> Option<i32> {
+    let alive = ALIVE_CONNS.lock().unwrap().clone();
+    let mut m = RESUME_TICKETS.lock().unwrap();
+    m.retain(|_, t| t.valid(alive.contains(&t.conn_id)));
+    if secret.len() < 16 {
+        return None;
+    }
+    m.insert(key, ResumeTicket { secret: secret.to_vec(), conn_id, ended: None, perms })
+        .filter(|old| old.ended.is_none() && old.conn_id != conn_id && same_secret(&old.secret, secret))
+        .map(|old| old.conn_id)
+}
+
+fn resume_set_perms(conn_id: i32, perms: ResumePerms) {
+    for t in RESUME_TICKETS.lock().unwrap().values_mut() {
+        if t.conn_id == conn_id {
+            t.perms = perms;
+        }
+    }
+}
+
+fn resume_forget(conn_id: i32) {
+    RESUME_TICKETS.lock().unwrap().retain(|_, t| t.conn_id != conn_id);
+}
+
+/// Tether: at most one recording consent prompt per 10 s, however often the viewer asks.
+#[cfg(feature = "tauri")]
+fn record_request_due(last: &mut Option<Instant>) -> bool {
+    let due = last.map_or(true, |t| t.elapsed() > Duration::from_secs(10));
+    if due {
+        *last = Some(Instant::now());
+    }
+    due
+}
+
+fn resume_ended(conn_id: i32) {
+    for t in RESUME_TICKETS.lock().unwrap().values_mut() {
+        if t.conn_id == conn_id && t.ended.is_none() {
+            t.ended = Some(Instant::now());
+        }
+    }
+}
+
+#[cfg(test)]
+mod resume_test {
+    use super::*;
+
+    #[test]
+    fn a_resume_needs_the_secret_and_a_live_or_recent_session() {
+        let s = vec![7u8; 16];
+        let live = ResumeTicket { secret: s.clone(), conn_id: 1, ended: None, perms: [true; 8] };
+        // Still running (a link that died on the client's side only): admitted, and the old
+        // connection is closed in its favour, see the next test.
+        assert!(live.admits(&s, true));
+        assert!(!live.admits(&s, false), "gone without on_close: expired");
+        assert!(!live.admits(&[7u8; 15], true), "short secret");
+        let mut other = s.clone();
+        other[15] = 8;
+        assert!(!live.admits(&other, true), "wrong secret");
+        assert!(!live.admits(&[], true), "client without a secret");
+        let recent = ResumeTicket { ended: Some(Instant::now()), ..live };
+        assert!(recent.admits(&s, false));
+        let old = ResumeTicket { ended: Instant::now().checked_sub(RESUME_WINDOW + Duration::from_secs(1)), ..recent };
+        assert!(old.ended.is_some() && !old.admits(&s, false), "window over");
+    }
+
+    fn key(session_id: u64) -> SessionKey {
+        SessionKey { peer_id: "resume-test".to_owned(), name: "".to_owned(), session_id }
+    }
+
+    #[test]
+    fn a_resume_replaces_the_running_connection_and_keeps_its_permissions() {
+        let s = vec![7u8; 16];
+        let (old, new) = (i32::MAX - 11, i32::MAX - 10);
+        let _alive = (raii::ConnectionID::new(old), raii::ConnectionID::new(new));
+        assert_eq!(resume_register(key(1), old, &s, [true; 8]), None);
+        // The host user switches keyboard and file off.
+        let mut perms = [true; 8];
+        (perms[0], perms[3]) = (false, false);
+        resume_set_perms(old, perms);
+        assert_eq!(RESUME_TICKETS.lock().unwrap().get(&key(1)).map(|t| t.perms), Some(perms));
+        // The reconnect while the old connection still runs: that one is to be closed.
+        assert_eq!(resume_register(key(1), new, &s, perms), Some(old));
+        // Another secret on this session key is a new session, not a resume: nothing is closed,
+        // and the ticket is now its own (the latest login that was let in owns the key).
+        assert_eq!(resume_register(key(1), old, &[8u8; 16], perms), None);
+        resume_forget(old);
+    }
+
+    #[test]
+    fn a_session_the_viewer_closed_is_not_resumed() {
+        let id = i32::MAX - 12;
+        let _alive = raii::ConnectionID::new(id);
+        resume_register(key(2), id, &[7u8; 16], [true; 8]);
+        resume_ended(id);
+        assert!(RESUME_TICKETS.lock().unwrap().contains_key(&key(2)), "a dropped connection resumes");
+        resume_forget(id);
+        assert!(!RESUME_TICKETS.lock().unwrap().contains_key(&key(2)));
+    }
+
+    #[cfg(feature = "tauri")]
+    #[test]
+    fn recording_requests_are_throttled() {
+        let mut last = None;
+        assert!(record_request_due(&mut last));
+        assert!(!record_request_due(&mut last));
+        last = Instant::now().checked_sub(Duration::from_secs(11));
+        assert!(last.is_some() && record_request_due(&mut last));
+    }
+}
+
+/// Debug builds, `TETHER_DEV_KEYLOG=<file>`: received key events are appended as JSON lines and
+/// not injected (keyboard e2e, apps/desktop/e2e/keyboard-e2e.mjs).
+#[cfg(debug_assertions)]
+fn dev_keylog(path: &std::ffi::OsStr, me: &KeyEvent) {
+    use std::io::Write;
+    let (kind, v) = match &me.union {
+        Some(key_event::Union::ControlKey(c)) => ("control", format!("{:?}", c.enum_value())),
+        Some(key_event::Union::Chr(c)) => ("chr", c.to_string()),
+        Some(key_event::Union::Unicode(c)) => ("unicode", c.to_string()),
+        Some(key_event::Union::Seq(s)) => ("seq", s.clone()),
+        _ => ("none", String::new()),
+    };
+    let line = serde_json::json!({ "mode": me.mode.value(), "kind": kind, "v": v, "down": me.down, "press": me.press });
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f, "{line}");
+    }
+}
