+/// Tether direct-path lookup: "who has id X" and the host's answer (its direct listener port).
+const TETHER_FIND: &str = "tether-find";
+const TETHER_HERE: &str = "tether-here";
+
+/// The host accepts direct connections (the app sets `direct-server` from policy `network.direct`).
+fn direct_host_enabled() -> bool {
+    Config::get_option(config::keys::OPTION_DIRECT_SERVER) == "Y"
+}
+
+/// Tether: find `id` on the LAN. Broadcasts a lookup on every IPv4 interface and returns the
+/// first answer's address with the port it names, or None after `wait`. The answer is not
+/// trusted: the caller connects there and the key exchange proves (or disproves) the host.
+#[cfg(not(target_os = "ios"))]
+pub fn find_peer(id: &str, wait: std::time::Duration) -> Option<SocketAddr> {
+    let sockets = create_broadcast_sockets();
+    let mut msg = Message::new();
+    msg.set_peer_discovery(PeerDiscovery {
+        cmd: TETHER_FIND.to_owned(),
+        id: id.to_owned(),
+        ..Default::default()
+    });
+    let out = msg.write_to_bytes().ok()?;
+    let to = SocketAddr::from(([255, 255, 255, 255], get_broadcast_port()));
+    // Also each subnet's directed broadcast, from the socket bound on that subnet: Windows may send
+    // 255.255.255.255 out of one adapter only, which misses Hyper-V/VPN adapters (vEthernet).
+    let directed: Vec<(Ipv4Addr, Ipv4Addr)> = default_net::get_interfaces()
+        .iter()
+        .flat_map(|i| i.ipv4.clone())
+        .filter(|n| !n.addr.is_loopback() && n.prefix_len > 0 && n.prefix_len < 31)
+        .map(|n| (n.addr, Ipv4Addr::from(u32::from(n.addr) | !u32::from(n.netmask))))
+        .collect();
+    let send = || {
+        for s in &sockets {
+            let local = match s.local_addr() {
+                Ok(SocketAddr::V4(a)) => *a.ip(),
+                _ => Ipv4Addr::UNSPECIFIED,
+            };
+            if local.is_loopback() {
+                continue;
+            }
+            s.send_to(&out, to).ok();
+            for (_, b) in directed.iter().filter(|(ip, _)| *ip == local) {
+                s.send_to(&out, SocketAddr::from((*b, get_broadcast_port()))).ok();
+            }
+        }
+    };
+    for s in &sockets {
+        s.set_nonblocking(true).ok();
+    }
+    send();
+    let start = Instant::now();
+    let mut resent = false;
+    while start.elapsed() < wait {
+        for s in &sockets {
+            let mut buf = [0u8; 512];
+            while let Ok((len, from)) = s.recv_from(&mut buf) {
+                let Ok(m) = Message::parse_from_bytes(&buf[..len]) else { continue };
+                if let Some(rendezvous_message::Union::PeerDiscovery(p)) = m.union {
+                    if p.cmd == TETHER_HERE && p.id == id {
+                        if let Ok(port) = p.misc.parse::<u16>() {
+                            if port > 0 {
+                                log::info!("LAN lookup: {id} at {} in {:?}", from.ip(), start.elapsed());
+                                return Some(SocketAddr::new(from.ip(), port));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        // One resend covers a lost broadcast; UDP on a LAN rarely loses two.
+        if !resent && start.elapsed() > std::time::Duration::from_millis(100) {
+            send();
+            resent = true;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    None
+}
