+            assert!((r(h2) - r(h1)).abs() <= r(h1) * 0.1, "ratio drifted: {what}");
+            assert!((f(h2) - f(h1)).abs() <= 2.0, "fps drifted: {what}");
+            assert!(worst(h2) as f64 <= worst(h1) as f64 * 1.15 + 1000.0, "stalls grew: {what}");
+        }
+    }
+}
+
+/// Mac host, H.265: a switch from office content to full-screen content above what the link
+/// carries froze the picture in ~3 s steps for ~11 s while the delay probes confirmed it. The
+/// host sees the full link at once (the connection does not take the next frame).
+#[test]
+fn sim_switch_to_heavy_content_drains_fast_with_backlog_signal() {
+    for encoder in [EncoderModel::Cbr, EncoderModel::FixedRate] {
+        let mut worst = [0u32; 2];
+        for seed in SEEDS {
+            for (i, backlog) in [false, true].into_iter().enumerate() {
+                let sc = Scenario {
+                    name: "switch_to_heavy",
+                    seconds: 120,
+                    limit: 60,
+                    quality: Quality::Balanced,
+                    abr: true,
+                    content: Content::OfficeThenVideo(60_000),
+                    encoder,
+                    link: clean_link(1500.0),
+                    seed,
+                    backlog,
+                };
+                let r = run(&sc);
+                worst[i] = worst[i].max(longest_queue_span(&r.trace, 60_000, 1000));
+            }
+        }
+        println!("longest queue >= 1 s after the switch, worst seed: without {} ms, with backlog signal {} ms", worst[0], worst[1]);
+        assert!(worst[1] * 5 <= worst[0], "backlog signal must drain much faster: {worst:?}");
+        assert!(worst[1] <= 6000, "long backlog: {worst:?}");
+    }
+}
