+/// Used by `client/file_trait.rs` on non-flutter builds.
+pub fn make_fd(id: i32, entries: &Vec<FileEntry>, only_count: bool) -> sciter::Value {
+    let mut m = sciter::Value::map();
+    m.set_item("id", id);
+    let mut n: u64 = 0;
+    let mut a = sciter::Value::array(0);
+    for entry in entries {
+        n += entry.size;
+        if only_count {
+            continue;
+        }
+        let mut e = sciter::Value::map();
+        e.set_item("name", entry.name.to_owned());
+        e.set_item("type", entry.entry_type.value());
+        e.set_item("time", entry.modified_time as f64);
+        e.set_item("size", entry.size as f64);
+        a.push(e);
+    }
+    if !only_count {
+        m.set_item("entries", a);
+    }
+    m.set_item("num_entries", entries.len() as i32);
+    m.set_item("total_size", n as f64);
+    m
+}
