diff --git a/libs/scrap/src/dxgi/wgc.rs b/libs/scrap/src/dxgi/wgc.rs
new file mode 100644
index 0000000..56a1f29
--- /dev/null
+++ b/libs/scrap/src/dxgi/wgc.rs
@@ -0,0 +1,175 @@
+//! Windows.Graphics.Capture reader for hosts whose duplicated desktop image lives in system memory
+//! (`DXGI_OUTDUPL_DESC::DesktopImageInSystemMemory`: GPU-less machines such as Hyper-V VMs, WARP /
+//! display-only adapters). There, Desktop Duplication hands out frames in which an application
+//! that is presenting at that moment (Edge redrawing an animated page or a video) is only partly
+//! drawn: full-width bands of the window background in 15-50 % of frames on such pages, with
+//! MapDesktopSurface and with a staging copy alike. The screen itself never shows them (GDI and
+//! the VM framebuffer are clean), and neither does this API, which delivers what DWM composed.
+
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::{Duration, Instant};
+use std::{io, slice};
+
+use windows::core::Interface;
+use windows::Foundation::TypedEventHandler;
+use windows::Graphics::Capture::{Direct3D11CaptureFramePool, GraphicsCaptureItem, GraphicsCaptureSession};
+use windows::Graphics::DirectX::Direct3D11::IDirect3DDevice;
+use windows::Graphics::DirectX::DirectXPixelFormat;
+use windows::Win32::Foundation::HMODULE;
+use windows::Win32::Graphics::Direct3D::D3D_DRIVER_TYPE_HARDWARE;
+use windows::Win32::Graphics::Direct3D11::*;
+use windows::Win32::Graphics::Dxgi::IDXGIDevice;
+use windows::Win32::Graphics::Gdi::HMONITOR;
+use windows::Win32::System::WinRT::Direct3D11::{CreateDirect3D11DeviceFromDXGIDevice, IDirect3DDxgiInterfaceAccess};
+use windows::Win32::System::WinRT::Graphics::Capture::IGraphicsCaptureItemInterop;
+
+#[link(name = "kernel32")]
+extern "system" {
+    fn QueryPerformanceCounter(count: *mut i64) -> i32;
+    fn QueryPerformanceFrequency(freq: *mut i64) -> i32;
+}
+
+fn err(e: windows::core::Error) -> io::Error {
+    io::Error::new(io::ErrorKind::Other, e.to_string())
+}
+
+pub struct Wgc {
+    device: ID3D11Device,
+    context: ID3D11DeviceContext,
+    pool: Direct3D11CaptureFramePool,
+    session: GraphicsCaptureSession,
+    /// Set by FrameArrived, so `frame` can wait for the next picture like AcquireNextFrame.
+    arrived: Arc<(Mutex<bool>, Condvar)>,
+    staging: Option<ID3D11Texture2D>,
+    mapped: bool,
+    width: usize,
+    height: usize,
+}
+
+impl Wgc {
+    /// Capture `monitor` (`width`×`height`). Fails where the API, a borderless capture or the
+    /// monitor is unavailable; the caller then keeps Desktop Duplication.
+    pub fn new(monitor: *mut std::ffi::c_void, width: usize, height: usize) -> io::Result<Wgc> {
+        unsafe {
+            if !GraphicsCaptureSession::IsSupported().map_err(err)? {
+                return Err(io::Error::new(io::ErrorKind::Unsupported, "graphics capture not supported"));
+            }
+            let mut device = None;
+            let mut context = None;
+            D3D11CreateDevice(None, D3D_DRIVER_TYPE_HARDWARE, HMODULE::default(), D3D11_CREATE_DEVICE_BGRA_SUPPORT, None, D3D11_SDK_VERSION, Some(&mut device), None, Some(&mut context)).map_err(err)?;
+            let (device, context): (ID3D11Device, ID3D11DeviceContext) = (device.unwrap(), context.unwrap());
+            let d3d: IDirect3DDevice = CreateDirect3D11DeviceFromDXGIDevice(&device.cast::<IDXGIDevice>().map_err(err)?).map_err(err)?.cast().map_err(err)?;
+            let interop = windows::core::factory::<GraphicsCaptureItem, IGraphicsCaptureItemInterop>().map_err(err)?;
+            let item: GraphicsCaptureItem = interop.CreateForMonitor(HMONITOR(monitor)).map_err(err)?;
+            let size = item.Size().map_err(err)?;
+            if size.Width as usize != width || size.Height as usize != height {
+                return Err(io::Error::new(io::ErrorKind::Other, format!("capture item {}x{} != display {width}x{height}", size.Width, size.Height)));
+            }
+            // One buffer, freed as soon as it is copied: DWM composes at most one capture copy per
+            // encoded frame (each costs CPU on WARP), ready when the encoder asks. Measured on the
+            // VM: frame rate and VM CPU as with Desktop Duplication. Two buffers: a copy at every
+            // composition, +20-50 ms latency. Holding the buffer while encoding: half the frame
+            // rate when the screen changes at 20 fps (a composition during the encode is lost).
+            let pool = Direct3D11CaptureFramePool::CreateFreeThreaded(&d3d, DirectXPixelFormat::B8G8R8A8UIntNormalized, 1, size).map_err(err)?;
+            let session = pool.CreateCaptureSession(&item).map_err(err)?;
+            // The customer must not get a yellow frame around the screen: no capture without this.
+            session.SetIsBorderRequired(false).map_err(err)?;
+            // The cursor goes separately, as with Desktop Duplication.
+            let _ = session.SetIsCursorCaptureEnabled(false);
+            let arrived = Arc::new((Mutex::new(false), Condvar::new()));
+            let a = arrived.clone();
+            pool.FrameArrived(&TypedEventHandler::new(move |_, _| {
+                *a.0.lock().unwrap() = true;
+                a.1.notify_one();
+                Ok(())
+            }))
+            .map_err(err)?;
+            session.StartCapture().map_err(err)?;
+            Ok(Wgc { device, context, pool, session, arrived, staging: None, mapped: false, width, height })
+        }
+    }
+
+    fn unmap(&mut self) {
+        if self.mapped {
+            if let Some(st) = &self.staging {
+                unsafe { self.context.Unmap(st, 0) };
+            }
+            self.mapped = false;
+        }
+    }
+
+    /// The next picture (BGRA, rows of `pitch` bytes), waiting up to `timeout` for one; WouldBlock
+    /// when the screen did not change. Valid until the next call.
+    pub fn frame(&mut self, timeout: Duration) -> io::Result<(&[u8], usize)> {
+        self.unmap();
+        let end = Instant::now() + timeout;
+        let frame = loop {
+            if let Ok(f) = self.pool.TryGetNextFrame() {
+                break f;
+            }
+            let (lock, cv) = &*self.arrived;
+            let mut ready = lock.lock().unwrap();
+            let now = Instant::now();
+            if !*ready {
+                if now >= end {
+                    return Err(io::ErrorKind::WouldBlock.into());
+                }
+                ready = cv.wait_timeout(ready, end - now).unwrap().0;
+            }
+            if !*ready {
+                return Err(io::ErrorKind::WouldBlock.into());
+            }
+            *ready = false;
+        };
+        // Statistics: the frame's composition time is on the QPC clock (100 ns units).
+        let age_us = frame.SystemRelativeTime().ok().and_then(|t| {
+            let (mut now, mut freq) = (0i64, 0i64);
+            unsafe {
+                QueryPerformanceCounter(&mut now);
+                QueryPerformanceFrequency(&mut freq);
+            }
+            (freq > 0).then(|| ((now as i128 * 1_000_000 / freq as i128) as i64 - t.Duration / 10).clamp(0, u32::MAX as i64) as u32)
+        });
+        crate::CAPTURE_AGE_US.store(age_us.unwrap_or(0), std::sync::atomic::Ordering::Relaxed);
+        let t_copy = Instant::now();
+        let size = frame.ContentSize().map_err(err)?;
+        if size.Width as usize != self.width || size.Height as usize != self.height {
+            // Resolution changed: the caller rebuilds the capturer.
+            return Err(io::Error::new(io::ErrorKind::Other, "graphics capture size changed"));
+        }
+        unsafe {
+            let tex: ID3D11Texture2D = frame.Surface().map_err(err)?.cast::<IDirect3DDxgiInterfaceAccess>().map_err(err)?.GetInterface().map_err(err)?;
+            if self.staging.is_none() {
+                let mut desc = D3D11_TEXTURE2D_DESC::default();
+                tex.GetDesc(&mut desc);
+                desc.Usage = D3D11_USAGE_STAGING;
+                desc.BindFlags = 0;
+                desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ.0 as u32;
+                desc.MiscFlags = 0;
+                let mut st = None;
+                self.device.CreateTexture2D(&desc, None, Some(&mut st)).map_err(err)?;
+                self.staging = st;
+            }
+            let st = self.staging.as_ref().unwrap();
+            self.context.CopyResource(st, &tex);
+            let mut m = D3D11_MAPPED_SUBRESOURCE::default();
+            let mapped = self.context.Map(st, 0, D3D11_MAP_READ, 0, Some(&mut m));
+            // Map waited for the copy: give the buffer back for the next composition.
+            drop(tex);
+            let _ = frame.Close();
+            mapped.map_err(err)?;
+            self.mapped = true;
+            crate::CAPTURE_COPY_US.store(t_copy.elapsed().as_micros().min(u32::MAX as u128) as u32, std::sync::atomic::Ordering::Relaxed);
+            let pitch = m.RowPitch as usize;
+            Ok((slice::from_raw_parts(m.pData as *const u8, pitch * self.height), pitch))
+        }
+    }
+}
+
+impl Drop for Wgc {
+    fn drop(&mut self) {
+        self.unmap();
+        let _ = self.session.Close();
+        let _ = self.pool.Close();
+    }
+}
