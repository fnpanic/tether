+/// Tether: remote input is injected on the main queue. With every Tether window minimized for a
+/// session, App Nap throttles that queue and the technician's mouse and keys stop arriving.
+pub fn disable_app_nap() {
+    unsafe {
+        let info: id = msg_send![class!(NSProcessInfo), processInfo];
+        let reason = NSString::alloc(nil).init_str("Remote control");
+        // NSActivityUserInitiatedAllowingIdleSystemSleep | NSActivityLatencyCritical
+        let options: u64 = 0x00EF_FFFF | 0xFF_0000_0000;
+        let token: id = msg_send![info, beginActivityWithOptions: options reason: reason];
+        // Held for the life of the process; the activity ends when the token is released.
+        let _: id = msg_send![token, retain];
+    }
+}
