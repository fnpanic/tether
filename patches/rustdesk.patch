new file mode 100644
index 0000000..09bfe82
--- /dev/null
+++ b/src/server/own_ui_guard.rs
@@ -0,0 +1,905 @@
+//! Tether: input from a remote session never reaches Tether's own windows on this computer (the
+//! incoming-connection window, TetherQS, the main window, Tether Manage). Only the person at the
+//! computer can use them, so a technician cannot grant themselves permissions, approve consent
+//! prompts or change settings.
+//!
+//! The checks run where input is injected (`input_service`, also inside the elevated portable
+//! service), per event: a button press or wheel over a Tether window is dropped together with its
+//! release; keys are dropped while a Tether window is in the foreground, except what is needed to
+//! leave it (modifiers on their own, Alt+Tab, Win+Tab, Cmd+Tab). Pointer moves always pass. A lone
+//! Alt release on a Tether window gets a masking key first, so Windows' menu mode never stalls it.
+//! Local (physical) input never comes through here.
+
+use crate::input::{MOUSE_TYPE_DOWN, MOUSE_TYPE_TRACKPAD, MOUSE_TYPE_UP, MOUSE_TYPE_WHEEL};
+use base::message_proto::{key_event, ControlKey, KeyEvent, KeyboardMode};
+use std::{
+    collections::HashMap,
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicBool, AtomicU8, Ordering},
+        Mutex,
+    },
+    time::{Duration, Instant},
+};
+
+/// Shown to the technician (at most every few seconds) when something was dropped.
+pub const NOTICE: &str =
+    "The Tether window on the remote computer can only be used by the person at that computer.";
+
+/// Buttons pressed over a Tether window; their release is dropped too.
+static SWALLOWED: Mutex<i32> = Mutex::new(0);
+/// Alt / Win / Cmd held by remote input (bit 0 Alt, bit 1 Win/Cmd), for Alt+Tab and friends.
+static HELD: AtomicU8 = AtomicU8::new(0);
+
+/// Whether a remote mouse event may be injected. Call right before injecting it.
+pub fn mouse_allowed(evt_type: i32, buttons: i32) -> bool {
+    let allowed = mouse_step(&mut SWALLOWED.lock().unwrap(), evt_type, buttons, over_own_window);
+    if !allowed {
+        hbb_common::log::debug!("remote mouse event on a Tether window dropped");
+    }
+    allowed
+}
+
+/// Alt is down and no other key reached a window since (see `alt_alone_step`).
+static ALT_ALONE: AtomicBool = AtomicBool::new(false);
+
+/// Whether a remote key event may be injected. Call right before injecting it.
+pub fn key_allowed(evt: &KeyEvent) -> bool {
+    let allowed = key_step(&HELD, evt, foreground_is_own);
+    if alt_alone_step(&ALT_ALONE, evt, allowed, foreground_is_own) {
+        os::menu_mask();
+    }
+    allowed
+}
+
+/// True when this Alt release ends a lone Alt press on a Tether window (e.g. Alt+F4 with F4
+/// dropped). Windows would then put the window into keyboard menu mode and its WebView stalls
+/// until the next key or click; a masking key right before the release prevents that.
+fn alt_alone_step(alone: &AtomicBool, evt: &KeyEvent, allowed: bool, foreground_own: impl FnOnce() -> bool) -> bool {
+    let down = evt.down || evt.press;
+    if switch_modifier_bit(evt) == Some(1) {
+        if down {
+            alone.store(true, Ordering::Relaxed);
+            return false;
+        }
+        return alone.swap(false, Ordering::Relaxed) && foreground_own();
+    }
+    // Any other key that reaches a window (Tab of Alt+Tab, Shift, ...) means no menu mode.
+    if allowed && down {
+        alone.store(false, Ordering::Relaxed);
+    }
+    false
+}
+
+/// Touch zoom (Ctrl+wheel) over a Tether window.
+pub fn scale_allowed() -> bool {
+    !over_own_window()
+}
+
+/// For the technician notice only (no state change): would this event be dropped?
+pub fn would_drop_mouse(evt_type: i32) -> bool {
+    if evt_type != MOUSE_TYPE_DOWN {
+        return false;
+    }
+    // macOS injects on the main queue: look where the moves queued before this click put the pointer.
+    #[cfg(target_os = "macos")]
+    return super::input_service::in_input_order(over_own_window);
+    #[cfg(not(target_os = "macos"))]
+    over_own_window()
+}
+
+pub fn would_drop_key(evt: &KeyEvent) -> bool {
+    (evt.down || evt.press) && !is_exit_key(evt, HELD.load(Ordering::Relaxed) != 0) && foreground_is_own()
+}
+
+fn mouse_step(swallowed: &mut i32, evt_type: i32, buttons: i32, over: impl FnOnce() -> bool) -> bool {
+    match evt_type {
+        MOUSE_TYPE_DOWN => {
+            if over() {
+                *swallowed |= buttons;
+                false
+            } else {
+                *swallowed &= !buttons;
+                true
+            }
+        }
+        // A release whose press was injected always passes, so no button stays stuck.
+        MOUSE_TYPE_UP => {
+            let drop = *swallowed & buttons != 0;
+            *swallowed &= !buttons;
+            !drop
+        }
+        MOUSE_TYPE_WHEEL | MOUSE_TYPE_TRACKPAD => !over(),
+        _ => true,
+    }
+}
+
+fn key_step(held: &AtomicU8, evt: &KeyEvent, foreground_own: impl FnOnce() -> bool) -> bool {
+    let down = evt.down || evt.press;
+    if let Some(bit) = switch_modifier_bit(evt) {
+        if down {
+            held.fetch_or(bit, Ordering::Relaxed);
+        } else {
+            held.fetch_and(!bit, Ordering::Relaxed);
+        }
+    }
+    is_exit_key(evt, held.load(Ordering::Relaxed) != 0) || !foreground_own()
+}
+
+/// Alt (1) or Win/Cmd (2) pressed or released by this event.
+fn switch_modifier_bit(evt: &KeyEvent) -> Option<u8> {
+    match &evt.union {
+        Some(key_event::Union::ControlKey(ck)) => match ck.enum_value_or(ControlKey::Unknown) {
+            ControlKey::Alt | ControlKey::RAlt => Some(1),
+            ControlKey::Meta | ControlKey::RWin => Some(2),
+            _ => None,
+        },
+        Some(key_event::Union::Chr(code)) if !is_legacy(evt) => {
+            match crate::keyboard::keycode_to_rdev_key(*code) {
+                rdev::Key::Alt | rdev::Key::AltGr => Some(1),
+                rdev::Key::MetaLeft | rdev::Key::MetaRight => Some(2),
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+fn is_legacy(evt: &KeyEvent) -> bool {
+    evt.mode.enum_value_or(KeyboardMode::Legacy) == KeyboardMode::Legacy
+}
+
+/// Keys that may reach a Tether window: what it takes to leave it, nothing that types or
+/// activates anything (Enter, Space, Esc, letters, Alt+F4, Cmd+Q are all dropped).
+fn is_exit_key(evt: &KeyEvent, switch_held: bool) -> bool {
+    let switch = switch_held
+        || evt.modifiers.iter().any(|m| {
+            matches!(
+                m.enum_value_or(ControlKey::Unknown),
+                ControlKey::Alt | ControlKey::RAlt | ControlKey::Meta | ControlKey::RWin
+            )
+        });
+    match &evt.union {
+        Some(key_event::Union::ControlKey(ck)) => {
+            let ck = ck.enum_value_or(ControlKey::Unknown);
+            match ck {
+                ControlKey::Alt
+                | ControlKey::RAlt
+                | ControlKey::Shift
+                | ControlKey::RShift
+                | ControlKey::Control
+                | ControlKey::RControl
+                | ControlKey::Meta
+                | ControlKey::RWin
+                // Handled by the system, never by the window in front.
+                | ControlKey::CtrlAltDel
+                | ControlKey::LockScreen => true,
+                ControlKey::Tab => switch,
+                _ => false,
+            }
+        }
+        Some(key_event::Union::Chr(code)) if !is_legacy(evt) => {
+            match crate::keyboard::keycode_to_rdev_key(*code) {
+                rdev::Key::Alt
+                | rdev::Key::AltGr
+                | rdev::Key::ShiftLeft
+                | rdev::Key::ShiftRight
+                | rdev::Key::ControlLeft
+                | rdev::Key::ControlRight
+                | rdev::Key::MetaLeft
+                | rdev::Key::MetaRight => true,
+                rdev::Key::Tab => switch,
+                _ => false,
+            }
+        }
+        _ => false,
+    }
+}
+
+fn over_own_window() -> bool {
+    is_own_pid(os::pid_at_cursor())
+}
+
+fn foreground_is_own() -> bool {
+    is_own_pid(os::foreground_pid())
+}
+
+/// Tether process = same executable as this one, or any `tether*` executable (TetherQS next to an
+/// installed Tether, Tether Manage). Cached briefly per PID: clicks and keys come in bursts.
+fn is_own_pid(pid: u32) -> bool {
+    if pid == 0 {
+        return false;
+    }
+    if pid == std::process::id() {
+        return true;
+    }
+    static CACHE: Mutex<Option<HashMap<u32, (bool, Instant)>>> = Mutex::new(None);
+    const TTL: Duration = Duration::from_secs(2); // short: PIDs get reused
+    let mut cache = CACHE.lock().unwrap();
+    let cache = cache.get_or_insert_with(HashMap::new);
+    if let Some((own, at)) = cache.get(&pid) {
+        if at.elapsed() < TTL {
+            return *own;
+        }
+    }
+    let own = os::exe_of(pid).map_or(false, |exe| {
+        is_own_exe(&exe)
+            // WebView2 popups (dropdowns, context menus) belong to the browser process that the
+            // Tether process started.
+            || (os::is_webview_host(&exe)
+                && os::parent_pid(pid)
+                    .and_then(os::exe_of)
+                    .map_or(false, |p| is_own_exe(&p)))
+    });
+    if cache.len() > 256 {
+        cache.clear();
+    }
+    cache.insert(pid, (own, Instant::now()));
+    own
+}
+
+fn is_own_exe(exe: &Path) -> bool {
+    static ME: Mutex<Option<Option<PathBuf>>> = Mutex::new(None);
+    let me = ME
+        .lock()
+        .unwrap()
+        .get_or_insert_with(|| std::env::current_exe().ok().and_then(|p| p.canonicalize().ok()))
+        .clone();
+    let canon = exe.canonicalize().unwrap_or_else(|_| exe.to_path_buf());
+    if me.map_or(false, |me| same_path(&me, &canon)) {
+        return true;
+    }
+    exe.file_stem()
+        .and_then(|s| s.to_str())
+        .map_or(false, |s| s.to_lowercase().starts_with("tether"))
+}
+
+fn same_path(a: &Path, b: &Path) -> bool {
+    if cfg!(windows) {
+        a.to_string_lossy().to_lowercase() == b.to_string_lossy().to_lowercase()
+    } else {
+        a == b
+    }
+}
+
+/// File transfer must not read or change Tether's own configuration (ID key pair, password,
+/// permissions) or installation. `path` is a peer supplied path on this computer.
+pub fn is_protected_path(path: &str) -> bool {
+    let Some(lower) = parts(Path::new(path)) else {
+        return true;
+    };
+    // Config dirs: %APPDATA%\Tether*, also for the service (ServiceProfiles\LocalService\AppData\
+    // Roaming\Tether) and TetherQS (Tether-QS); macOS ~/Library/Preferences/app.tether.* and
+    // /var/root/Library/Preferences/...
+    let config = lower
+        .windows(2)
+        .any(|w| (w[0] == "roaming" || w[0] == "preferences") && is_config_name(&w[1]));
+    if config {
+        return true;
+    }
+    // This process's config dir wherever it is (a redirected AppData is not called Roaming), and
+    // the installation.
+    [Some(own_config_root()), install_root()].into_iter().flatten().any(|root| {
+        let root = parts(&root).unwrap_or_default();
+        !root.is_empty() && lower.starts_with(&root)
+    })
+}
+
+/// A folder with Tether's configuration (with `install`: or its installation) somewhere below it.
+/// Reading it recursively would take those files along, renaming or removing it would move them.
+/// Listing such a folder (the home folder, AppData) is fine and not checked with this.
+pub fn holds_protected(path: &str, install: bool) -> bool {
+    let Some(lower) = parts(Path::new(path)) else {
+        return true;
+    };
+    config_roots()
+        .into_iter()
+        .chain(install.then(install_root).flatten())
+        .any(|root| {
+            let root = parts(&root).unwrap_or_default();
+            root.len() > lower.len() && root.starts_with(&lower)
+        })
+}
+
+fn is_config_name(lower_name: &str) -> bool {
+    ["tether", "app.tether", "net.tether"].iter().any(|p| lower_name.starts_with(p))
+}
+
+/// The resolved path as lower case components, to compare whatever the spelling. None: a path
+/// that reaches this computer's drives by a name that hides which folder it is (one of its own
+/// shares, a device path); it cannot be checked, so the callers refuse it.
+fn parts(p: &Path) -> Option<Vec<String>> {
+    let full = resolve(p);
+    #[cfg(windows)]
+    let full = by_drive(full)?;
+    Some(
+        full.components()
+            .map(|c| c.as_os_str().to_string_lossy().to_lowercase())
+            .collect(),
+    )
+}
+
+/// `\\localhost\C$\Users` is `C:\Users`: this computer's administrative drive shares become the
+/// drive. Shares of other computers stay as they are.
+#[cfg(windows)]
+fn by_drive(full: PathBuf) -> Option<PathBuf> {
+    use std::path::{Component, Prefix};
+    let mut rest = full.components();
+    let Some(Component::Prefix(prefix)) = rest.next() else {
+        return Some(full); // relative and not existing
+    };
+    let (server, share) = match prefix.kind() {
+        Prefix::Disk(_) | Prefix::VerbatimDisk(_) => return Some(full),
+        Prefix::UNC(server, share) | Prefix::VerbatimUNC(server, share) => {
+            (server.to_string_lossy().into_owned(), share.to_string_lossy().into_owned())
+        }
+        _ => return None,
+    };
+    if !is_this_computer(&server) {
+        return Some(full);
+    }
+    let drive = match share.as_bytes() {
+        [letter, b'$'] if letter.is_ascii_alphabetic() => *letter as char,
+        _ => return None,
+    };
+    let mut local = PathBuf::from(format!("{drive}:\\"));
+    local.extend(rest.filter(|c| matches!(c, Component::Normal(_))));
+    by_drive(resolve(&local))
+}
+
+/// Whether a share's server name means this computer: localhost, its own names and aliases, and
+/// every address it has (only an own address can be bound).
+#[cfg(windows)]
+fn is_this_computer(server: &str) -> bool {
+    use std::net::{IpAddr, ToSocketAddrs, UdpSocket};
+    let server = server.to_lowercase();
+    // UNC spelling of an IPv6 address: `--1.ipv6-literal.net`, `s` for the `%` of a zone.
+    let host = match server.strip_suffix(".ipv6-literal.net") {
+        Some(v6) => v6.replace('-', ":").replace('s', "%"),
+        None => server,
+    };
+    let own_name = |name: String| host.split('.').next() == Some(name.to_lowercase().as_str());
+    if host == "localhost" || std::env::var("COMPUTERNAME").map_or(false, own_name) {
+        return true;
+    }
+    // Link-local IPv6 cannot be bound without its zone: taken as own, to be on the safe side.
+    let own = |ip: IpAddr| {
+        ip.is_loopback()
+            || matches!(ip, IpAddr::V6(a) if a.segments()[0] & 0xffc0 == 0xfe80)
+            || UdpSocket::bind((ip, 0)).is_ok()
+    };
+    match host.split('%').next().unwrap_or_default().parse::<IpAddr>() {
+        Ok(ip) => own(ip),
+        Err(_) => (host.as_str(), 0).to_socket_addrs().map_or(false, |mut a| a.any(|a| own(a.ip()))),
+    }
+}
+
+/// Windows: %APPDATA%\Tether (above `config`); macOS: ~/Library/Preferences/app.tether.*.
+fn own_config_root() -> PathBuf {
+    let mut dir = hbb_common::config::Config::path("");
+    if cfg!(windows) {
+        dir.pop();
+    }
+    dir
+}
+
+/// The installation: Program Files\Tether (installed) or the .app bundle; for a portable exe
+/// (TetherQS in Downloads) only the exe itself.
+fn install_root() -> Option<PathBuf> {
+    let exe = std::env::current_exe().and_then(|p| p.canonicalize()).ok()?;
+    let bundle = exe.ancestors().find(|a| a.extension().map_or(false, |e| e == "app"));
+    Some(match bundle {
+        Some(b) => b.to_path_buf(),
+        None if crate::platform::is_installed() => exe.parent().map(Path::to_path_buf).unwrap_or(exe.clone()),
+        None => exe.clone(),
+    })
+}
+
+/// The config folders of every account on this computer: this process's, each user's and the
+/// service's (the process serving a session is not always the user whose files are asked for).
+fn config_roots() -> Vec<PathBuf> {
+    // (folder of the user profiles, the service's profile, from a profile to its config folders)
+    #[cfg(windows)]
+    let (users, service, sub) = (
+        std::env::var_os("PUBLIC")
+            .map(PathBuf::from)
+            .and_then(|p| p.parent().map(Path::to_path_buf))
+            .unwrap_or_else(|| r"C:\Users".into()),
+        PathBuf::from(std::env::var_os("SystemRoot").unwrap_or_else(|| r"C:\Windows".into()))
+            .join(r"ServiceProfiles\LocalService"),
+        r"AppData\Roaming",
+    );
+    #[cfg(not(windows))]
+    let (users, service, sub) = (PathBuf::from("/Users"), PathBuf::from("/var/root"), "Library/Preferences");
+    let mut roots = vec![own_config_root()];
+    let profiles = std::fs::read_dir(users).into_iter().flatten().flatten().map(|e| e.path());
+    for profile in profiles.chain([service]) {
+        for e in std::fs::read_dir(profile.join(sub)).into_iter().flatten().flatten() {
+            if is_config_name(&e.file_name().to_string_lossy().to_lowercase()) {
+                roots.push(e.path());
+            }
+        }
+    }
+    roots
+}
+
+/// Absolute path with `..` and links resolved as far as the path exists (a file to be created
+/// does not exist yet).
+fn resolve(p: &Path) -> PathBuf {
+    let mut lexical = PathBuf::new();
+    for c in p.components() {
+        match c {
+            std::path::Component::ParentDir => {
+                lexical.pop();
+            }
+            std::path::Component::CurDir => {}
+            c => lexical.push(c),
+        }
+    }
+    let mut existing = lexical.as_path();
+    let mut rest = Vec::new();
+    loop {
+        if let Ok(c) = existing.canonicalize() {
+            let mut out = c;
+            for r in rest.iter().rev() {
+                out.push(r);
+            }
+            return out;
+        }
+        match (existing.parent(), existing.file_name()) {
+            (Some(parent), Some(name)) => {
+                rest.push(name.to_os_string());
+                existing = parent;
+            }
+            _ => return lexical,
+        }
+    }
+}
