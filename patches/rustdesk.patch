+/// Tether: the rendezvous server the last connection went through, asked first next time.
+#[cfg(feature = "tauri")]
+static LAST_GOOD_SERVER: Mutex<String> = Mutex::new(String::new());
+
+/// Head start of each rendezvous server over the next one. A server that fails (down, or the
+/// peer is not registered there) hands over at once; the delay only matters when one hangs, and
+/// keeps a peer registered everywhere from getting a relay request from every server.
+#[cfg(feature = "tauri")]
+const SERVER_STAGGER: Duration = Duration::from_millis(1000);
+
+/// How long to wait on a relay for the host's first message (see `secure_connection`).
+#[cfg(feature = "tauri")]
+const RELAY_PAIR_TIMEOUT: u64 = 5_000;
