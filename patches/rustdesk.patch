+        w.frames += 1;
+        w.keys += frames.iter().filter(|f| f.key).count() as u32;
+        let bytes = frames.iter().map(|f| f.data.len()).sum::<usize>();
+        w.bytes += bytes;
+        w.max_frame = w.max_frame.max(bytes);
+        w.enc_us.push(took.as_micros().min(u32::MAX as _) as u32);
