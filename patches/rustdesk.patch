--- a/libs/scrap/src/common/mod.rs
+++ b/libs/scrap/src/common/mod.rs
@@ -550,3 +550,28 @@ pub fn screen_size() -> (u16, u16, u16) {
 pub fn is_start() -> Option<bool> {
     android::is_start()
 }
+
+/// Tether: the quantizer ceiling for a quality ratio `b` (ratio x 100). At normal quality the
+/// codec's own ceiling stays; once QoS has lowered the ratio below 0.5 because the path cannot
+/// keep up, the ceiling rises towards 63 so heavy content (a photo, a full-screen change) still
+/// fits the bitrate: a coarser picture for a moment instead of multi-second frames and freezes.
+pub fn overload_q_max(b: u32, q_max: u32) -> u32 {
+    const KNEE: u32 = 50;
+    if b >= KNEE || q_max >= 63 {
+        return q_max;
+    }
+    q_max + (63 - q_max) * (KNEE - b) / KNEE
+}
+
+#[cfg(test)]
+mod overload_q_tests {
+    use super::overload_q_max;
+
+    #[test]
+    fn ceiling_only_rises_under_overload() {
+        assert_eq!(overload_q_max(100, 47), 47);
+        assert_eq!(overload_q_max(50, 52), 52);
+        assert_eq!(overload_q_max(0, 56), 63);
+        assert!(overload_q_max(20, 56) > 56 && overload_q_max(20, 56) < 63);
+    }
+}
