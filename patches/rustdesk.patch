+    #[test]
+    fn folders_above_protected_ones() {
+        // This process's config dir counts whatever it and the folder above it are called.
+        let own = own_config_root();
+        let s = |p: &Path| p.to_str().unwrap().to_owned();
+        assert!(is_protected_path(&s(&own)), "the folder itself");
+        assert!(is_protected_path(&s(&own.join("config").join("x.toml"))), "a child");
+        assert!(is_protected_path(&s(&own).to_uppercase()));
+        let above = own.parent().unwrap();
+        for dir in [above, above.parent().unwrap(), above.ancestors().last().unwrap()] {
+            assert!(holds_protected(&s(dir), false), "{dir:?}");
+            assert!(holds_protected(&s(dir).to_uppercase(), false), "{dir:?}");
+            assert!(holds_protected(&format!("{}\\.", s(dir)), false), "{dir:?}");
+            assert!(!is_protected_path(&s(dir)), "listing {dir:?} stays possible");
+            for server in own_servers() {
+                assert!(holds_protected(&unc(&server, &s(dir)), false), "{server} {dir:?}");
+            }
+        }
+        assert!(holds_protected("\\\\localhost\\Users", false), "a share that is not a drive");
+        // A sibling, and a file: nothing below them.
+        let sibling = std::env::temp_dir();
+        assert!(!holds_protected(&s(&sibling), true));
+        assert!(!is_protected_path(&s(&sibling)));
+        let exe = std::env::current_exe().unwrap();
+        assert!(!holds_protected(&s(&exe), true));
+        // The folder with the installation: only where the installation matters (rename, remove).
+        let build = exe.parent().unwrap().parent().unwrap();
+        assert!(holds_protected(&s(build), true));
+        assert!(!holds_protected(&s(build), false));
+    }
