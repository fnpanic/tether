+        ));
+        assert!(is_protected_path(std::env::current_exe().unwrap().to_str().unwrap()));
+        assert!(!is_protected_path(&format!("{appdata}\\Notepad\\x.txt")));
+        assert!(!is_protected_path("C:\\Users\\Public\\Documents\\tether.txt"));
+        // The same folders through this computer's own shares.
+        for server in own_servers() {
+            assert!(is_protected_path(&unc(&server, &format!("{appdata}\\Tether\\config\\Tether.toml"))), "{server}");
+            assert!(is_protected_path(&unc(&server, std::env::current_exe().unwrap().to_str().unwrap())), "{server}");
+            assert!(!is_protected_path(&unc(&server, &format!("{appdata}\\Notepad\\x.txt"))), "{server}");
+            // A share that is not a drive hides the folder: refused.
+            assert!(is_protected_path(&format!("\\\\{server}\\Users\\Public\\x.txt")), "{server}");
+        }
+        assert_eq!(by_drive(PathBuf::from("\\\\?\\GLOBALROOT\\Device\\x")), None, "a device path");
+        // Another computer's share is none of this (no access to it here: `resolve` would wait).
+        assert!(!is_this_computer("192.0.2.1"));
