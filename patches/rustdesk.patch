+fn entries_json(entries: &[FileEntry]) -> Value {
+    Value::Array(
+        entries
+            .iter()
+            .map(|e| {
+                json!({
+                    "name": e.name,
+                    "type": e.entry_type.value(),
+                    "is_hidden": e.is_hidden,
+                    "size": e.size,
+                    "modified": e.modified_time,
+                })
+            })
+            .collect(),
+    )
+}
