+/// First success of `attempts`, started one after another: the next one starts when the
+/// previous fails or after `stagger`. All failed: the first "peer is offline" answer (the peer
+/// was looked up and is not there), else the first attempt's error.
+#[cfg(feature = "tauri")]
+async fn first_ok_staggered<'a, T: 'a>(
+    attempts: Vec<BoxFuture<'a, ResultType<T>>>,
+    stagger: Duration,
+) -> ResultType<T> {
+    use hbb_common::futures::stream::{FuturesUnordered, StreamExt};
+    let mut pending = attempts.into_iter().enumerate();
+    let mut running = FuturesUnordered::new();
+    let mut errors: Vec<(usize, hbb_common::anyhow::Error)> = Vec::new();
+    let mut start_next = true;
+    loop {
+        if std::mem::take(&mut start_next) {
+            if let Some((i, f)) = pending.next() {
+                running.push(f.map(move |r| (i, r)));
+            }
+        }
+        if running.is_empty() {
+            break;
+        }
+        let more = pending.len() > 0;
+        tokio::select! {
+            Some((i, r)) = running.next() => match r {
+                Ok(v) => return Ok(v),
+                Err(e) => {
+                    errors.push((i, e));
+                    start_next = true;
+                }
+            },
+            _ = tokio::time::sleep(stagger), if more => start_next = true,
+        }
+    }
+    errors.sort_by_key(|(i, _)| *i);
+    let pick = errors
+        .iter()
+        .position(|(_, e)| {
+            let e = e.to_string();
+            e.contains("offline") || e.contains("not exist")
+        })
+        .unwrap_or(0);
+    match errors.into_iter().nth(pick) {
+        Some((_, e)) => Err(e),
+        None => bail!("no rendezvous server"),
+    }
+}
