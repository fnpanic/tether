+    #[test]
+    fn swallowed_press_drops_its_release_only() {
+        let mut s = 0;
+        assert!(!mouse_step(&mut s, MOUSE_TYPE_DOWN, MOUSE_BUTTON_LEFT, || true));
+        assert!(mouse_step(&mut s, MOUSE_TYPE_MOVE, 0, || panic!("moves are not checked")));
+        // Released elsewhere: still dropped, it was never pressed.
+        assert!(!mouse_step(&mut s, MOUSE_TYPE_UP, MOUSE_BUTTON_LEFT, || false));
+        assert_eq!(s, 0);
+        // Pressed outside, released over Tether: passes so the button does not stick.
+        assert!(mouse_step(&mut s, MOUSE_TYPE_DOWN, MOUSE_BUTTON_LEFT, || false));
+        assert!(mouse_step(&mut s, MOUSE_TYPE_UP, MOUSE_BUTTON_LEFT, || true));
+        // Buttons are tracked separately.
+        assert!(!mouse_step(&mut s, MOUSE_TYPE_DOWN, MOUSE_BUTTON_RIGHT, || true));
+        assert!(mouse_step(&mut s, MOUSE_TYPE_DOWN, MOUSE_BUTTON_LEFT, || false));
+        assert!(mouse_step(&mut s, MOUSE_TYPE_UP, MOUSE_BUTTON_LEFT, || true));
+        assert!(!mouse_step(&mut s, MOUSE_TYPE_UP, MOUSE_BUTTON_RIGHT, || false));
+        assert!(!mouse_step(&mut s, MOUSE_TYPE_WHEEL, 0, || true));
+        assert!(mouse_step(&mut s, MOUSE_TYPE_WHEEL, 0, || false));
+    }
+
+    fn ck(k: ControlKey, down: bool, mods: &[ControlKey]) -> KeyEvent {
+        let mut e = KeyEvent::new();
+        e.set_control_key(k);
+        e.down = down;
+        e.modifiers = mods.iter().map(|m| (*m).into()).collect();
+        e
+    }
+
+    fn chr(c: u32, down: bool) -> KeyEvent {
+        let mut e = KeyEvent::new();
+        e.set_chr(c);
+        e.down = down;
+        e
+    }
+
+    #[test]
+    fn keys_on_tether_window() {
+        let held = AtomicU8::new(0);
+        let own = || true;
+        for k in [ControlKey::Return, ControlKey::Space, ControlKey::Escape, ControlKey::F4, ControlKey::Tab, ControlKey::Delete] {
+            assert!(!key_step(&held, &ck(k, true, &[]), own), "{k:?}");
+        }
+        // Alt+F4 / Alt+Space would close or open the window menu.
+        assert!(!key_step(&held, &ck(ControlKey::F4, true, &[ControlKey::Alt]), own));
+        assert!(!key_step(&held, &ck(ControlKey::Space, true, &[ControlKey::Alt]), own));
+        assert!(!key_step(&held, &chr('a' as u32, true), own));
+        let mut seq = KeyEvent::new();
+        seq.set_seq("hello\n".into());
+        seq.press = true;
+        assert!(!key_step(&held, &seq, own));
+        // Leaving the window works.
+        assert!(key_step(&held, &ck(ControlKey::Alt, true, &[]), own));
+        assert!(key_step(&held, &ck(ControlKey::Tab, true, &[]), own), "Tab while Alt is held");
+        assert!(key_step(&held, &ck(ControlKey::Alt, false, &[]), own));
+        assert!(!key_step(&held, &ck(ControlKey::Tab, true, &[]), own), "Tab alone");
+        assert!(key_step(&held, &ck(ControlKey::Tab, true, &[ControlKey::Meta]), own));
+        assert!(key_step(&held, &ck(ControlKey::Meta, true, &[]), own));
+        assert!(key_step(&held, &ck(ControlKey::CtrlAltDel, true, &[]), own));
+        // Other windows get everything.
+        assert!(key_step(&held, &ck(ControlKey::Return, true, &[]), || false));
+        assert!(key_step(&held, &chr('a' as u32, true), || false));
+    }
+
+    #[test]
+    fn lone_alt_on_tether_window_is_masked() {
+        let held = AtomicU8::new(0);
+        let alone = AtomicBool::new(false);
+        // Runs key_step like key_allowed; returns whether the menu mask goes before this event.
+        let step = |e: &KeyEvent, own: bool| {
+            let allowed = key_step(&held, e, || own);
+            alt_alone_step(&alone, e, allowed, || own)
+        };
+        let alt = |down| ck(ControlKey::Alt, down, &[]);
+        // Alt+F4 on Tether: F4 dropped, so the release is masked.
+        assert!(!step(&alt(true), true));
+        assert!(!step(&ck(ControlKey::F4, true, &[ControlKey::Alt]), true));
+        assert!(step(&alt(false), true));
+        // Alt+Tab: Tab reached the system, no mask.
+        assert!(!step(&alt(true), true));
+        assert!(!step(&ck(ControlKey::Tab, true, &[ControlKey::Alt]), true));
+        assert!(!step(&alt(false), true));
+        // A lone Alt on another window keeps its normal meaning (menu bar).
+        assert!(!step(&alt(true), false));
+        assert!(!step(&alt(false), false));
+        // Released with Tether in front after Alt+key on another window: no mask.
+        assert!(!step(&alt(true), false));
+        assert!(!step(&chr('d' as u32, true), false));
+        assert!(!step(&alt(false), true));
+    }
