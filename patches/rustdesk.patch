+            let m = IdPk { id: "123456789".to_owned(), pk: Bytes::from(vec![7u8; 32]), ..Default::default() };
+            sign::sign(&m.write_to_bytes().unwrap(), sk)
+        };
+        let (by_a, by_b) = (id_pk(&sa), id_pk(&sb));
+        let set = |v: &[&String]| *config::POLICY_SERVER_KEYS.write().unwrap() = v.iter().map(|k| k.to_string()).collect();
+        // Before: a client built with A only (no list) presents A and rejects B's signature.
+        set(&[]);
+        assert!(decode_id_pk_any(&by_a, &a).is_some());
+        assert!(decode_id_pk_any(&by_b, &a).is_none());
+        // Phase 1/2: list [A, B]. Still presents A, accepts either signature.
+        set(&[&a, &b]);
+        assert_eq!(config::server_key(), a);
+        assert!(decode_id_pk_any(&by_a, &config::server_key()).is_some());
+        assert_eq!(decode_id_pk_any(&by_b, &config::server_key()).unwrap().0, "123456789");
+        // Phase 3: list [B]. Presents B; a signature by the retired A is rejected.
+        set(&[&b]);
+        assert_eq!(config::server_key(), b);
+        assert!(decode_id_pk_any(&by_b, &config::server_key()).is_some());
+        assert!(decode_id_pk_any(&by_a, &config::server_key()).is_none());
+        // A custom server's own key is not widened by the list.
+        assert!(decode_id_pk_any(&by_b, &a).is_none());
+        set(&[]);
+    }
 }
