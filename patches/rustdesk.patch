+/// Tether: host-side encoder statistics, logged every few seconds while video is being sent, so
+/// slow software encoding or a stalled stream shows up in the host log (docs/performance.md).
+#[cfg(feature = "tauri")]
+mod fluxrt_stats {
+    use super::*;
+
+    #[derive(Default)]
+    struct Window {
+        since: Option<Instant>,
+        frames: u32,
+        keys: u32,
+        bytes: usize,
+        enc: Duration,
+        enc_max: Duration,
+    }
+
+    lazy_static::lazy_static! {
+        static ref WINDOW: Mutex<Window> = Default::default();
+    }
+
+    pub(super) fn encoded(vf: &VideoFrame, took: Duration) {
+        use video_frame::Union::*;
+        let frames = match &vf.union {
+            Some(Vp8s(f)) | Some(Vp9s(f)) | Some(Av1s(f)) | Some(H264s(f)) | Some(H265s(f)) => &f.frames,
+            _ => return,
+        };
+        let mut w = WINDOW.lock().unwrap();
+        let since = *w.since.get_or_insert_with(Instant::now);
+        w.frames += 1;
+        w.keys += frames.iter().filter(|f| f.key).count() as u32;
+        w.bytes += frames.iter().map(|f| f.data.len()).sum::<usize>();
+        w.enc += took;
+        w.enc_max = w.enc_max.max(took);
+        let secs = since.elapsed().as_secs_f64();
+        if secs >= 5.0 {
+            log::info!(
+                "fluxrt encode: {:?} {:.1} fps, encode avg {:.1} ms max {} ms, {:.0} kbit/s, {} key frames",
+                CodecFormat::from(vf),
+                w.frames as f64 / secs,
+                w.enc.as_secs_f64() * 1000.0 / w.frames as f64,
+                w.enc_max.as_millis(),
+                w.bytes as f64 * 8.0 / 1000.0 / secs,
+                w.keys
+            );
+            *w = Window::default();
+        }
+    }
+}
