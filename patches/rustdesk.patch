diff --git a/libs/scrap/examples/tearprobe.rs b/libs/scrap/examples/tearprobe.rs
new file mode 100644
index 0000000..c879fdf
--- /dev/null
+++ b/libs/scrap/examples/tearprobe.rs
@@ -0,0 +1,45 @@
+// Check for the half-drawn-window artifact of Desktop Duplication on GPU-less hosts (see
+// src/dxgi/wgc.rs): capture the primary display for <secs> seconds with the capturer Tether uses
+// and count frames with a full-width light band (#F3F3F3-ish rows over the whole width of
+// y 150..1000) while Edge shows an animated page (e.g. its welcome page) maximized.
+//   tearprobe [secs]   -> "frames N band B (P%) frame() avg T ms"; P must be 0.
+use scrap::{Capturer, Display, Frame, TraitCapturer, TraitPixelBuffer};
+use std::io::ErrorKind::WouldBlock;
+use std::time::{Duration, Instant};
+
+fn band_rows(data: &[u8], w: usize, h: usize) -> usize {
+    let stride = data.len() / h;
+    (150..h.min(1000))
+        .filter(|y| {
+            let row = &data[y * stride..];
+            let xs = (8..w.saturating_sub(20)).step_by(4);
+            let n = xs.len();
+            let flat = xs.filter(|x| row[x * 4..x * 4 + 3].iter().all(|&c| (236..=250).contains(&c))).count();
+            flat * 10 >= n * 9
+        })
+        .count()
+}
+
+fn main() {
+    let secs: u64 = std::env::args().nth(1).and_then(|s| s.parse().ok()).unwrap_or(20);
+    let mut c = Capturer::new(Display::all().unwrap().remove(0)).unwrap();
+    let (w, h) = (c.width(), c.height());
+    let t0 = Instant::now();
+    let (mut frames, mut bad, mut cost) = (0, 0, Duration::ZERO);
+    while t0.elapsed() < Duration::from_secs(secs) {
+        let tc = Instant::now();
+        match c.frame(Duration::from_millis(100)) {
+            Ok(Frame::PixelBuffer(f)) => {
+                cost += tc.elapsed();
+                frames += 1;
+                if band_rows(f.data(), w, h) > 0 {
+                    bad += 1;
+                }
+            }
+            Ok(_) => {}
+            Err(e) if e.kind() == WouldBlock => {}
+            Err(e) => panic!("{e}"),
+        }
+    }
+    println!("frames {frames} band {bad} ({:.1}%) frame() avg {:.1} ms", 100.0 * bad as f64 / frames.max(1) as f64, cost.as_secs_f64() * 1000.0 / frames.max(1) as f64);
+}
