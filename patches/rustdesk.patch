+#[cfg(windows)]
+mod os {
+    use std::path::{Path, PathBuf};
+    use winapi::{
+        shared::windef::{HWND, POINT},
+        um::winuser::{GetAncestor, GetForegroundWindow, GetWindowThreadProcessId, WindowFromPoint, GA_ROOTOWNER},
+    };
+
+    unsafe fn pid_of(w: HWND) -> u32 {
+        if w.is_null() {
+            return 0;
+        }
+        let mut pid = 0;
+        GetWindowThreadProcessId(w, &mut pid);
+        pid
+    }
+
+    pub fn pid_at_cursor() -> u32 {
+        // A SYSTEM process must be on the input desktop to see its windows.
+        crate::platform::windows::try_change_desktop();
+        let Some((x, y)) = crate::platform::windows::get_cursor_pos() else {
+            return 0;
+        };
+        unsafe {
+            let w = WindowFromPoint(POINT { x, y });
+            if w.is_null() {
+                return 0;
+            }
+            // Parents and owners: WebView2 content windows belong to msedgewebview2.exe.
+            pid_of(GetAncestor(w, GA_ROOTOWNER))
+        }
+    }
+
+    pub fn foreground_pid() -> u32 {
+        crate::platform::windows::try_change_desktop();
+        unsafe { pid_of(GetForegroundWindow()) }
+    }
+
+    /// VK 0xE8 is unassigned: the window sees a key between Alt down and up, nothing else happens
+    /// (AutoHotkey's menu mask key).
+    pub fn menu_mask() {
+        use winapi::um::winuser::{keybd_event, KEYEVENTF_KEYUP};
+        unsafe {
+            keybd_event(0xE8, 0, 0, 0);
+            keybd_event(0xE8, 0, KEYEVENTF_KEYUP, 0);
+        }
+    }
+
+    pub fn exe_of(pid: u32) -> Option<PathBuf> {
+        crate::platform::windows::get_process_executable_path(pid).ok()
+    }
+
+    pub fn is_webview_host(exe: &Path) -> bool {
+        exe.file_name()
+            .map_or(false, |n| n.to_string_lossy().eq_ignore_ascii_case("msedgewebview2.exe"))
+    }
+
+    pub fn parent_pid(pid: u32) -> Option<u32> {
+        use windows::Win32::{
+            Foundation::CloseHandle,
+            System::Diagnostics::ToolHelp::{
+                CreateToolhelp32Snapshot, Process32FirstW, Process32NextW, PROCESSENTRY32W,
+                TH32CS_SNAPPROCESS,
+            },
+        };
+        unsafe {
+            let snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0).ok()?;
+            let mut e = PROCESSENTRY32W {
+                dwSize: std::mem::size_of::<PROCESSENTRY32W>() as u32,
+                ..Default::default()
+            };
+            let mut found = None;
+            let mut ok = Process32FirstW(snap, &mut e).is_ok();
+            while ok {
+                if e.th32ProcessID == pid {
+                    found = Some(e.th32ParentProcessID);
+                    break;
+                }
+                ok = Process32NextW(snap, &mut e).is_ok();
+            }
+            let _ = CloseHandle(snap);
+            found
+        }
+    }
+}
