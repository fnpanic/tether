+            }
+            v.sort_unstable();
+            let avg = v.iter().map(|&u| u as f64).sum::<f64>() / v.len() as f64;
+            format!("{:.1} / {:.1}", avg / 1000.0, ms(v[v.len() * 95 / 100]))
+        };
+        log::info!(
+            "fluxrt capture/min: get {} ms (picture age when taken {}, copy {}), convert {}",
+            stat(&mut w.get_us),
+            stat(&mut w.age_us),
+            stat(&mut w.copy_us),
+            stat(&mut w.conv_us),
+        );
+        *w = Window::default();
+    }
+}
