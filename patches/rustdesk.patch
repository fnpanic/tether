new file mode 100644
index 0000000..3f0531f
--- /dev/null
+++ b/src/server/video_service/exact_still.rs
@@ -0,0 +1,383 @@
+//! Tether: the exact pixels of the parts of the picture that stand still.
+//!
+//! Video is lossy and 4:2:0: small coloured text and photos stay a little off however long the
+//! picture stands. The host therefore sends the captured pixels themselves, in strips of a few
+//! rows, for every strip that has not changed for a moment (`STILL`), at a limited byte rate, to
+//! the viewers that asked for them (`SupportedDecoding.exact_stills`).
+//!
+//! A list must never outlive the stream it was sent for. The viewer drops its list at every key
+//! frame (`ExactRows.video` in the app), at every new connection and display switch; so after a
+//! key frame has gone out the host sends its list again (`key_frame_sent`, `relist`). And the
+//! host tells a connection that has just subscribed, before its first frame, even when this
+//! run continues and that frame is no key frame (`exact_before_frame` counts the connections
+//! that still wait for their first frame; other viewers than before => `forget`). Known
+//! limit: a connection that subscribes in the few milliseconds between `exact_before_frame`
+//! and the frame's snapshot of the same pass gets that one frame first; the viewer's own rule
+//! (list dropped at every new connection) is what covers it.
+//!
+//! Every video frame replaces the viewer's whole picture, so the host keeps the viewer told
+//! which strips have not changed since they were sent (`ExactStrips.same`: row and hash, sent
+//! before a frame whenever the list differs from the last one); the viewer puts those back over
+//! every frame from its own copy. A blinking cursor or a clock therefore costs the strips it
+//! touches, not the whole picture, and does not keep the rest from becoming exact.
+//! docs/performance.md "Exact still pictures".
+use base::message_proto::{video_frame, ExactStrip, ExactStrips, Message, VideoFrame};
+use std::time::{Duration, Instant};
+
+/// Rows per strip: small, so that a strip of a photo (which hardly compresses) is a few tens of
+/// kB and the first frame of new motion never waits long behind one.
+pub const ROWS: usize = 8;
+/// A strip is sent once it has not changed for this long (not a whole second: a clock that
+/// ticks every second would have its strip sent and thrown away each time).
+pub(super) const STILL: Duration = Duration::from_millis(1500);
+/// Bytes of strips per loop pass, about: while the whole picture stands, and while something
+/// else on it still changes (then a changed part's next frame waits behind less).
+pub(super) const PASS_BYTES: usize = 32 * 1024;
+pub(super) const PASS_BYTES_BUSY: usize = 8 * 1024;
+/// Bytes per second the strips may use at least; normally the video bitrate of the moment, so a
+/// link the QoS controller has throttled gets its exact picture slowly instead of being flooded.
+pub(super) const MIN_RATE: f64 = 16_000.0;
+
+#[derive(Default)]
+pub(super) struct ExactStill {
+    cur: Vec<u8>,
+    prev: Vec<u8>,
+    stride: usize,
+    w: usize,
+    h: usize, // 0: no pixels kept
+    /// Per strip: the hash of the rows the viewers hold (sent, and unchanged since).
+    held: Vec<Option<u32>>,
+    /// Per strip: when its pixels last changed.
+    changed: Vec<Instant>,
+    /// The list of held strips the viewers were last told; None: they must be told (again).
+    listed: Option<Vec<u32>>,
+    debt: f64, // bytes sent ahead of the rate
+    last: Option<Instant>,
+}
+
+impl ExactStill {
+    /// A captured picture: keep its pixels if a viewer wants them; strips that changed are no
+    /// longer held and start their still time over.
+    pub(super) fn keep(&mut self, frame: &scrap::Frame, wanted: bool) {
+        let px = if wanted { pixels(frame) } else { None };
+        self.keep_pixels(px, Instant::now());
+    }
+
+    fn keep_pixels(&mut self, px: Option<(&[u8], usize, usize, usize)>, now: Instant) {
+        let Some((data, w, h, stride)) = px else {
+            self.h = 0;
+            self.held.clear();
+            self.changed.clear();
+            return;
+        };
+        let same_shape = (self.w, self.h, self.stride) == (w, h, stride);
+        std::mem::swap(&mut self.cur, &mut self.prev);
+        self.cur.clear();
+        self.cur.extend_from_slice(&data[..stride * h]);
+        (self.w, self.h, self.stride) = (w, h, stride);
+        if !same_shape || self.prev.len() != self.cur.len() {
+            self.held = vec![None; h.div_ceil(ROWS)];
+            self.changed = vec![now; h.div_ceil(ROWS)];
+            return;
+        }
+        for i in 0..self.held.len() {
+            // Row by row without the padding behind a row, which a capturer may leave as it is.
+            let differs = (i * ROWS..((i + 1) * ROWS).min(h)).any(|r| {
+                let row = r * stride..r * stride + w * 4;
+                self.cur[row.clone()] != self.prev[row]
+            });
+            if differs {
+                self.held[i] = None;
+                self.changed[i] = now;
+            }
+        }
+    }
+
+    /// Other viewers than before: nobody is known to hold anything, and they are told so.
+    pub(super) fn forget(&mut self) {
+        self.held.iter_mut().for_each(|h| *h = None);
+        self.listed = None;
+    }
+
+    /// A key frame went out: the viewers dropped their list and get it again before the next frame.
+    pub(super) fn relist(&mut self) {
+        self.listed = None;
+    }
+
+    /// The strips the viewers hold: pairs of first row and hash.
+    fn same(&self) -> Vec<u32> {
+        self.held.iter().enumerate().filter_map(|(i, h)| h.map(|h| [(i * ROWS) as u32, h])).flatten().collect()
+    }
+
+    /// For before a video frame: the list of held strips, if it is not the one the viewers were
+    /// told last (an empty one too: a viewer may remember strips from before a restart).
+    pub(super) fn list_if_changed(&mut self, display: usize) -> Option<Message> {
+        let same = self.same();
+        if self.listed.as_ref() == Some(&same) {
+            return None;
+        }
+        self.listed = Some(same.clone());
+        Some(self.message(display, Vec::new(), same))
+    }
+
+    /// The strips the viewers do not hold and that have stood still for `still`, as far as
+    /// `budget` bytes go in this pass and the byte rate allows: one message, or none.
+    pub(super) fn next_strips(&mut self, display: usize, rate: f64, budget: usize, still: Duration) -> Option<Message> {
+        self.strips_at(display, rate, budget, still, Instant::now())
+    }
+
+    fn strips_at(&mut self, display: usize, rate: f64, budget: usize, still: Duration, now: Instant) -> Option<Message> {
+        if self.h == 0 {
+            return None;
+        }
+        if let Some(last) = self.last.replace(now) {
+            self.debt = (self.debt - rate * now.duration_since(last).as_secs_f64().min(1.0)).max(0.0);
+        }
+        if self.debt > 0.0 {
+            return None;
+        }
+        let (mut strips, mut bytes) = (Vec::new(), 0);
+        for i in 0..self.held.len() {
+            if bytes >= budget {
+                break;
+            }
+            if self.held[i].is_some() || now.duration_since(self.changed[i]) < still {
+                continue;
+            }
+            let rows = ROWS.min(self.h - i * ROWS);
+            let raw = filtered(&self.cur, self.stride, self.w, i * ROWS, rows);
+            let data = hbb_common::compress::compress(&raw);
+            if data.is_empty() {
+                continue; // not compressed: not sent, not held
+            }
+            let hash = fnv1a(&raw);
+            bytes += data.len();
+            self.held[i] = Some(hash);
+            strips.push(ExactStrip { y: (i * ROWS) as _, height: rows as _, data: data.into(), hash, ..Default::default() });
+        }
+        self.debt = bytes as f64;
+        (!strips.is_empty()).then(|| self.message(display, strips, Vec::new()))
+    }
+
+    fn message(&self, display: usize, strips: Vec<ExactStrip>, same: Vec<u32>) -> Message {
+        let mut vf = VideoFrame::new();
+        vf.display = display as _;
+        vf.union = Some(video_frame::Union::Exact(ExactStrips {
+            width: self.w as _,
+            rows: ROWS as _,
+            strips,
+            same,
+            ..Default::default()
+        }));
+        let mut msg = Message::new();
+        msg.set_video_frame(vf);
+        msg
+    }
+}
+
+thread_local! {
+    /// The video thread sent a key frame since `key_frame_sent` was last asked.
+    static KEY_SENT: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Called with every encoded frame the video thread sends.
+pub(super) fn note_frame(vf: &VideoFrame) {
+    use video_frame::Union::*;
+    let key = match &vf.union {
+        Some(Vp8s(f)) | Some(Vp9s(f)) | Some(Av1s(f)) | Some(H264s(f)) | Some(H265s(f)) => f.frames.iter().any(|f| f.key),
+        _ => false,
+    };
+    if key {
+        KEY_SENT.with(|k| k.set(true));
+    }
+}
+
+/// Whether this thread sent a key frame since the last call.
+pub(super) fn key_frame_sent() -> bool {
+    KEY_SENT.with(|k| k.replace(false))
+}
+
+/// The CPU pixels of a captured frame (BGRA): data, width, height, stride. None for texture
+/// frames (GPU encoders) and other formats: no exact picture there.
+fn pixels<'a>(frame: &'a scrap::Frame) -> Option<(&'a [u8], usize, usize, usize)> {
+    use scrap::TraitPixelBuffer;
+    let scrap::Frame::PixelBuffer(f) = frame else {
+        return None;
+    };
+    if f.pixfmt() != scrap::Pixfmt::BGRA {
+        return None;
+    }
+    let (w, h) = (f.width(), f.height());
+    let stride = f.stride().first().copied().unwrap_or(0);
+    let data = f.data();
+    (w > 0 && h > 0 && stride >= w * 4 && data.len() >= stride * h).then_some((data, w, h, stride))
+}
+
+/// RGB of `rows` rows from row `y`, each pixel minus the one to its left (wrapping): flat areas
+/// and text become runs of zeros, photos small numbers. `exact_rows` is the inverse.
+fn filtered(bgra: &[u8], stride: usize, w: usize, y: usize, rows: usize) -> Vec<u8> {
+    let mut out = Vec::with_capacity(w * rows * 3);
+    for row in bgra[y * stride..].chunks(stride).take(rows) {
+        let mut prev = [0u8; 3];
+        for p in row[..w * 4].chunks_exact(4) {
+            let rgb = [p[2], p[1], p[0]];
+            for c in 0..3 {
+                out.push(rgb[c].wrapping_sub(prev[c]));
+            }
+            prev = rgb;
+        }
+    }
+    out
+}
+
+fn fnv1a(data: &[u8]) -> u32 {
+    data.iter().fold(0x811c_9dc5u32, |h, b| (h ^ *b as u32).wrapping_mul(0x0100_0193))
+}
+
+/// The viewer side: opaque RGBA rows from a strip's decompressed data; `None` if the size is wrong.
+pub fn exact_rows(filtered: &[u8], w: usize, rows: usize) -> Option<Vec<u8>> {
+    if w == 0 || filtered.len() != w * rows * 3 {
+        return None;
+    }
+    let mut out = Vec::with_capacity(w * rows * 4);
+    for row in filtered.chunks_exact(w * 3) {
+        let mut px = [0u8; 3];
+        for d in row.chunks_exact(3) {
+            for c in 0..3 {
+                px[c] = px[c].wrapping_add(d[c]);
+            }
+            out.extend_from_slice(&[px[0], px[1], px[2], 255]);
+        }
+    }
+    Some(out)
+}
