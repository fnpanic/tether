+/// Tether: an accepted remote session (by click or by password), for `is_resume_of_authed_session`.
+struct ResumeTicket {
+    secret: Vec<u8>,
+    conn_id: i32,
+    /// None while that connection runs.
+    ended: Option<Instant>,
+}
+
+impl ResumeTicket {
+    fn admits(&self, secret: &[u8], conn_alive: bool) -> bool {
+        self.valid(conn_alive) && secret.len() >= 16 && same_secret(&self.secret, secret)
+    }
+    // Never ended but gone: its `on_close` was missed, treat it as expired.
+    fn valid(&self, conn_alive: bool) -> bool {
+        self.ended.map_or(conn_alive, |t| t.elapsed() < RESUME_WINDOW)
+    }
