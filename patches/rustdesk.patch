+#[cfg(target_os = "macos")]
+mod os {
+    use cocoa::{
+        base::{id, nil},
+        foundation::NSString,
+    };
+    use core_foundation::array::{CFArrayGetCount, CFArrayGetValueAtIndex};
+    use core_graphics::{
+        display::{
+            kCGNullWindowID, kCGWindowListExcludeDesktopElements, kCGWindowListOptionOnScreenOnly,
+            CGWindowListCopyWindowInfo,
+        },
+        window::{kCGWindowAlpha, kCGWindowBounds, kCGWindowLayer, kCGWindowOwnerPID},
+    };
+    use objc::{class, msg_send, sel, sel_impl};
+    use std::path::{Path, PathBuf};
+
+    const DOCK: &str = "/System/Library/CoreServices/Dock.app/Contents/MacOS/Dock";
+
+    unsafe fn num(dict: id, key: id) -> Option<f64> {
+        let v: id = msg_send![dict, objectForKey: key];
+        if v == nil {
+            return None;
+        }
+        Some(msg_send![v, doubleValue])
+    }
+
+    /// Owner of the frontmost on-screen window under the pointer (CoreGraphics global
+    /// coordinates, top-left origin, like the window bounds).
+    pub fn pid_at_cursor() -> u32 {
+        let Some((x, y)) = crate::get_cursor_pos() else {
+            return 0;
+        };
+        let (x, y) = (x as f64, y as f64);
+        unsafe {
+            let list = CGWindowListCopyWindowInfo(
+                kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+                kCGNullWindowID,
+            );
+            if list.is_null() {
+                return 0;
+            }
+            let keys: [id; 4] = ["X", "Y", "Width", "Height"].map(|k| NSString::alloc(nil).init_str(k));
+            let mut pid = 0u32;
+            for i in 0..CFArrayGetCount(list) {
+                let w: id = CFArrayGetValueAtIndex(list, i) as _;
+                // Below normal windows (desktop) or invisible overlays: not what a click hits.
+                if num(w, kCGWindowLayer as id).unwrap_or(0.) < 0. || num(w, kCGWindowAlpha as id).unwrap_or(1.) <= 0. {
+                    continue;
+                }
+                let b: id = msg_send![w, objectForKey: kCGWindowBounds as id];
+                if b == nil {
+                    continue;
+                }
+                let (Some(bx), Some(by), Some(bw), Some(bh)) =
+                    (num(b, keys[0]), num(b, keys[1]), num(b, keys[2]), num(b, keys[3]))
+                else {
+                    continue;
+                };
+                if x >= bx && x < bx + bw && y >= by && y < by + bh {
+                    pid = num(w, kCGWindowOwnerPID as id).unwrap_or(0.) as u32;
+                    // The Dock's window covers the whole screen above normal windows; clicks
+                    // outside the Dock itself go through to the window below.
+                    if exe_of(pid).map_or(false, |e| e == Path::new(DOCK)) {
+                        pid = 0;
+                        continue;
+                    }
+                    break;
+                }
+            }
+            for k in keys {
+                let _: () = msg_send![k, release];
+            }
+            core_foundation::base::CFRelease(list as _);
+            pid
+        }
+    }
+
+    pub fn foreground_pid() -> u32 {
+        unsafe {
+            let ws: id = msg_send![class!(NSWorkspace), sharedWorkspace];
+            let app: id = msg_send![ws, frontmostApplication];
+            if app == nil {
+                return 0;
+            }
+            let pid: i32 = msg_send![app, processIdentifier];
+            let pid = pid.max(0) as u32;
+            // Tether stays the active app after it minimizes its windows for a session; keys then
+            // reach no Tether window and must pass.
+            if pid != 0 && !has_window_on_screen(pid) {
+                return 0;
+            }
+            pid
+        }
+    }
+
+    /// An on-screen window of `pid` that takes keys: normal or floating level, not the menu-bar
+    /// status item (level 25) or other system levels, visible and not a 1x1 helper.
+    fn has_window_on_screen(pid: u32) -> bool {
+        unsafe {
+            let list = CGWindowListCopyWindowInfo(
+                kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+                kCGNullWindowID,
+            );
+            if list.is_null() {
+                return true;
+            }
+            let keys: [id; 2] = ["Width", "Height"].map(|k| NSString::alloc(nil).init_str(k));
+            let mut found = false;
+            for i in 0..CFArrayGetCount(list) {
+                let w: id = CFArrayGetValueAtIndex(list, i) as _;
+                if num(w, kCGWindowOwnerPID as id).unwrap_or(0.) as u32 != pid {
+                    continue;
+                }
+                let layer = num(w, kCGWindowLayer as id).unwrap_or(0.);
+                if !(0. ..20.).contains(&layer) || num(w, kCGWindowAlpha as id).unwrap_or(1.) <= 0. {
+                    continue;
+                }
+                let b: id = msg_send![w, objectForKey: kCGWindowBounds as id];
+                if b != nil && num(b, keys[0]).unwrap_or(0.) > 1. && num(b, keys[1]).unwrap_or(0.) > 1. {
+                    found = true;
+                    break;
+                }
+            }
+            for k in keys {
+                let _: () = msg_send![k, release];
+            }
+            core_foundation::base::CFRelease(list as _);
+            found
+        }
+    }
+
+    pub fn exe_of(pid: u32) -> Option<PathBuf> {
+        use hbb_common::libc;
+        let mut buf = vec![0u8; libc::PROC_PIDPATHINFO_MAXSIZE as usize];
+        let n = unsafe { libc::proc_pidpath(pid as _, buf.as_mut_ptr() as _, buf.len() as _) };
+        if n <= 0 {
+            return None;
+        }
+        buf.truncate(n as usize);
+        Some(PathBuf::from(String::from_utf8_lossy(&buf).into_owned()))
+    }
+
+    pub fn is_webview_host(_exe: &Path) -> bool {
+        false // WKWebView menus belong to the app process itself
+    }
+
+    pub fn menu_mask() {} // a lone Option press does nothing on macOS
+
+    pub fn parent_pid(_pid: u32) -> Option<u32> {
+        None
+    }
+}
