+pub(crate) fn conn_type_from_str(s: &str) -> ConnType {
+    match s {
+        "file-transfer" => ConnType::FILE_TRANSFER,
+        "view-camera" => ConnType::VIEW_CAMERA,
+        "port-forward" => ConnType::PORT_FORWARD,
+        "terminal" => ConnType::TERMINAL,
+        _ => ConnType::DEFAULT_CONN,
+    }
+}
