+    assert_eq!(qos.fps(), FPS, "bitrate first: the fps stays");
+    qos.advance_ms(500);
+    assert!(!qos.on_send_backlog(3000), "once a second");
+    qos.advance_ms(500);
+    sync_bitrate(&mut qos);
+    assert!(qos.on_send_backlog(3000));
+    // A stale bad reply right after the cut neither cuts again nor brakes the fps (a reply
+    // with a whole second of excess still halves the fps, as before).
+    let cut = qos.ratio();
