+                w.frames as f64 / secs,
+                w.enc.as_secs_f64() * 1000.0 / w.frames as f64,
+                w.enc_max.as_millis(),
+                w.bytes as f64 * 8.0 / 1000.0 / secs,
+                w.keys
+            );
+            *w = Window::default();
+        }
+    }
+}
