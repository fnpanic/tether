+    /// Tether: to the subscribers among `ids` (as `subscriber_ids` names them); returns those it
+    /// went to (an id may be gone).
+    pub fn send_to_ids(&self, msg: Message, ids: &HashSet<i32>) -> HashSet<i32> {
+        let msg = Arc::new(msg);
+        let mut sent = HashSet::new();
+        let mut lock = self.0.write().unwrap();
+        let lock = &mut *lock;
+        for (id, s) in lock.subscribes.iter_mut().chain(lock.new_subscribes.iter_mut()) {
+            if ids.contains(id) {
+                s.send(msg.clone());
+                sent.insert(*id);
+            }
+        }
+        sent
