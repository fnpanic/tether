+/// Delay between starting successive connection routes (Happy Eyeballs uses 250 ms).
+const ROUTE_STAGGER_MS: u64 = 300;
+/// Fallback port of this client's own relay: TLS on 80 gets through networks that allow only
+/// web ports, and through proxies that allow CONNECT to 80.
+const FALLBACK_WSS_PORT: u16 = 80;
+
+#[derive(Clone, Debug, PartialEq)]
+struct Route {
+    url: String,
+    via_proxy: bool,
+}
+
+lazy_static::lazy_static! {
+    /// Last route that worked, per original URL host.
+    static ref GOOD_ROUTE: std::sync::Mutex<std::collections::HashMap<String, Route>> = Default::default();
+}
+
+fn route_key(url: &str) -> String {
+    url::Url::parse(url)
+        .ok()
+        .and_then(|u| u.host_str().map(|h| h.to_ascii_lowercase()))
+        .unwrap_or_default()
+}
+
+fn remember_route(url: &str, route: &Route) {
+    // Store the route for the other path on the same host too: /ws/id and /ws/relay share routes.
+    GOOD_ROUTE.lock().unwrap().insert(route_key(url), route.clone());
+}
+
+/// One connection attempt made by the route racer (Tether diagnostics).
+#[derive(Clone, Debug, serde_derive::Serialize)]
+pub struct RouteAttempt {
+    pub url: String,
+    pub via_proxy: bool,
+    pub ok: bool,
+    pub error: String,
+    pub ms: u64,
+    /// Unix seconds.
+    pub at: u64,
+}
+
+const ROUTE_LOG_LEN: usize = 50;
+
+lazy_static::lazy_static! {
+    static ref ROUTE_LOG: std::sync::Mutex<std::collections::VecDeque<RouteAttempt>> = Default::default();
+}
+
+fn record_attempt(route: &Route, started: std::time::Instant, err: Option<&anyhow::Error>) -> RouteAttempt {
+    let a = RouteAttempt {
+        url: route.url.clone(),
+        via_proxy: route.via_proxy,
+        ok: err.is_none(),
+        error: err.map(|e| e.to_string()).unwrap_or_default(),
+        ms: started.elapsed().as_millis() as u64,
+        at: std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_secs())
+            .unwrap_or_default(),
+    };
+    let mut log = ROUTE_LOG.lock().unwrap();
+    if log.len() >= ROUTE_LOG_LEN {
+        log.pop_front();
+    }
+    log.push_back(a.clone());
+    a
+}
+
+/// The last route attempts of this process, oldest first.
+pub fn route_attempts() -> Vec<RouteAttempt> {
+    ROUTE_LOG.lock().unwrap().iter().cloned().collect()
+}
+
+/// Connect every route to `url` now, in parallel, and report each result (also recorded).
+pub async fn probe_routes(url: &str, ms_timeout: u64) -> Vec<RouteAttempt> {
+    let proxy_conf = Config::get_socks();
+    let routes = connect_routes(url, proxy_conf.is_some());
+    let attempts = routes.iter().map(|route| {
+        let proxy = if route.via_proxy { proxy_conf.clone() } else { None };
+        async move {
+            let started = std::time::Instant::now();
+            let r = WsFramedStream::connect(&route.url, None, proxy.as_ref(), ms_timeout).await;
+            record_attempt(route, started, r.as_ref().err())
+        }
+    });
+    futures::future::join_all(attempts).await
+}
+
+/// Routes to try for `url`, best first. Only `wss://` URLs to this client's own (compiled-in)
+/// server on the default port get alternatives; a peer's server may not listen on port 80.
+fn connect_routes(url: &str, has_proxy: bool) -> Vec<Route> {
+    let single = vec![Route { url: url.to_owned(), via_proxy: has_proxy }];
+    let Ok(parsed) = url::Url::parse(url) else { return single };
+    let Some(host) = parsed.host_str() else { return single };
+    let exe = EXE_RENDEZVOUS_SERVER.read().unwrap().clone();
+    let is_own = crate::config::RENDEZVOUS_SERVERS
+        .iter()
+        .copied()
+        .chain(std::iter::once(exe.as_str()))
+        .filter(|s| !s.is_empty())
+        .any(|s| {
+            split_host_port(s)
+                .map(|(h, _)| h)
+                .unwrap_or_else(|| s.to_owned())
+                .eq_ignore_ascii_case(host)
+        });
+    if parsed.scheme() != "wss" || parsed.port().is_some() || !is_own {
+        return single;
+    }
+    let mut alt = parsed.clone();
+    let _ = alt.set_port(Some(FALLBACK_WSS_PORT));
+    let urls = [url.to_owned(), alt.to_string()];
+    let proxies: &[bool] = if has_proxy { &[true, false] } else { &[false] };
+    let mut routes: Vec<Route> = proxies
+        .iter()
+        .flat_map(|&via_proxy| urls.iter().map(move |u| Route { url: u.clone(), via_proxy }))
+        .collect();
+    let key = route_key(url);
+    if let Some(good) = GOOD_ROUTE.lock().unwrap().get(&key) {
+        // The cached route was stored for one path: map it onto this URL's path.
+        let port = url::Url::parse(&good.url).ok().and_then(|u| u.port());
+        if let Some(i) = routes.iter().position(|r| {
+            r.via_proxy == good.via_proxy && url::Url::parse(&r.url).ok().and_then(|u| u.port()) == port
+        }) {
+            let r = routes.remove(i);
+            routes.insert(0, r);
+        }
+    }
+    routes
+}
