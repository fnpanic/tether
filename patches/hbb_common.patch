+    /// "Always connects": to this client's own relay, try every route (port 443 and 80, through
+    /// the detected proxy and direct), staggered like Happy Eyeballs. The first route that
+    /// completes the TLS + WebSocket handshake wins, and the winner is tried first next time.
+    /// Any other server keeps the single upstream route.
+    async fn race(
+        url: &str,
+        local_addr: Option<SocketAddr>,
+        proxy_conf: Option<Socks5Server>,
+        ms_timeout: u64,
+    ) -> ResultType<(WsStream, SocketAddr)> {
+        let routes = connect_routes(url, proxy_conf.is_some());
+        if routes.len() <= 1 {
+            return Self::connect(url, local_addr, proxy_conf.as_ref(), ms_timeout).await;
+        }
+        let attempts = routes.iter().enumerate().map(|(i, route)| {
+            let route = route.clone();
+            let proxy = if route.via_proxy { proxy_conf.clone() } else { None };
+            Box::pin(async move {
+                tokio::time::sleep(Duration::from_millis(i as u64 * ROUTE_STAGGER_MS)).await;
+                let started = std::time::Instant::now();
+                let r = Self::connect(&route.url, local_addr, proxy.as_ref(), ms_timeout).await;
+                record_attempt(&route, started, r.as_ref().err());
+                if let Err(e) = &r {
+                    log::debug!("route {} (proxy: {}) failed: {}", route.url, route.via_proxy, e);
+                }
+                r.map(|s| (s, route))
+            })
+        });
+        let ((stream, route), _) = futures::future::select_ok(attempts).await?;
+        log::info!("connected via {} (proxy: {})", route.url, route.via_proxy);
+        remember_route(url, &route);
+        Ok(stream)
+    }
