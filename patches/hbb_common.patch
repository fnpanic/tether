+        assert_eq!(
+            got,
+            [
+                ("wss://relay.example.org/ws/id", true),
+                ("wss://relay.example.org:80/ws/id", true),
+                ("wss://relay.example.org/ws/id", false),
+                ("wss://relay.example.org:80/ws/id", false),
+            ]
+        );
+        // Other servers, explicit ports and plain ws keep one route.
+        assert_eq!(connect_routes("wss://peer.example.com/ws/relay", true).len(), 1);
+        // A second server from the policy list is one of our own and gets the fallbacks too.
+        crate::config::POLICY_RENDEZVOUS_SERVERS.write().unwrap().push("relay2.example.org".into());
+        assert_eq!(connect_routes("wss://relay2.example.org/ws/relay", false).len(), 2);
+        // A full-URL entry (one pod of a cluster) makes its host ours; per-pod paths are kept.
+        crate::config::POLICY_RENDEZVOUS_SERVERS.write().unwrap().push("wss://k8s.example.org/ws/id/1".into());
+        let got: Vec<_> = connect_routes("wss://k8s.example.org/ws/relay/2", false).into_iter().map(|r| r.url).collect();
+        assert_eq!(got, ["wss://k8s.example.org/ws/relay/2", "wss://k8s.example.org:80/ws/relay/2"]);
+        crate::config::POLICY_RENDEZVOUS_SERVERS.write().unwrap().clear();
+        assert_eq!(connect_routes("wss://relay.example.org:8443/ws/id", false).len(), 1);
+        // A winner on /ws/relay (direct, port 80) is tried first for /ws/id as well.
+        remember_route(
+            "wss://relay.example.org/ws/relay",
+            &Route { url: "wss://relay.example.org:80/ws/relay".into(), via_proxy: false },
+        );
+        let first = &connect_routes(id, true)[0];
+        assert_eq!((first.url.as_str(), first.via_proxy), ("wss://relay.example.org:80/ws/id", false));
