+/// Tether: `PEER_LOOKUP_FROM`, comma-separated CIDRs (a bare address is a /32 or /128).
+#[allow(dead_code)] // hbbr has no lookup
+pub fn parse_peer_lookup_from(v: &str) -> Result<Vec<ipnetwork::IpNetwork>, String> {
+    v.split(',').map(str::trim).filter(|s| !s.is_empty()).map(|s| s.parse().map_err(|e| format!("{s}: {e}"))).collect()
+}
