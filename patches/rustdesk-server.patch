+#[derive(Default)]
+struct ApiStats {
+    by_status: std::sync::Mutex<HashMap<String, u64>>,
+    errors: AtomicU64,
+    bytes: AtomicU64,
+}
+
+impl ApiStats {
+    fn count(&self, k: String) {
+        *self.by_status.lock().unwrap().entry(k).or_default() += 1;
+    }
+}
