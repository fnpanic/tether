+/// Tether: the `licence_key` check of hbbs and hbbr. `key` is this server's own public key (empty:
+/// no check), `presented` what the client sent; keys in `KEYS_ACCEPT` pass too.
+pub(crate) fn key_accepted(key: &str, presented: &str) -> bool {
+    key_accepted_in(&KEYS_ACCEPT, key, presented)
+}
+
+fn key_accepted_in(extra: &[String], key: &str, presented: &str) -> bool {
+    key.is_empty() || presented == key || extra.iter().any(|k| k == presented)
+}
+
+/// Logged at start, so the operator sees which keys are accepted.
+pub(crate) fn log_keys_accept() {
+    if !KEYS_ACCEPT.is_empty() {
+        log::info!("Also accepting keys (KEYS_ACCEPT): {}", KEYS_ACCEPT.join(", "));
+    }
