+/// Multi-consumer queue on top of tokio's mpsc (hbb_common has no async-channel).
+fn async_channel(cap: usize) -> (tokio::sync::mpsc::Sender<usize>, Rx) {
+    let (tx, rx) = tokio::sync::mpsc::channel(cap);
+    (tx, Rx(Arc::new(Mutex::new(rx))))
+}
+
+#[derive(Clone)]
+struct Rx(Arc<Mutex<tokio::sync::mpsc::Receiver<usize>>>);
+
+impl Rx {
+    async fn recv(&self) -> Result<usize, ()> {
+        self.0.lock().await.recv().await.ok_or(())
+    }
+    fn is_empty(&self) -> bool {
+        self.0.try_lock().map_or(false, |r| r.is_empty())
+    }
+}
