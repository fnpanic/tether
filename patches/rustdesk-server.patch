+    fn value(text: &str, series: &str) -> f64 {
+        text.lines()
+            .find_map(|l| l.strip_prefix(series)?.strip_prefix(' ')?.parse().ok())
+            .unwrap_or_else(|| panic!("{series} missing in\n{text}"))
+    }
+
+    fn now() -> HbbsNow {
+        HbbsNow { peers_online: 5, peers_in_memory: 9, tcp_signalling: 2, turn_enabled: true, turn_open: 1, turn_max: 64 }
+    }
+
+    // Statics are shared by the tests of this module: each test uses its own series.
+    #[test]
+    fn hbbs_counters_move_and_render() {
+        let before = render_hbbs(&now());
+        PUNCH[PUNCH_OFFLINE].inc();
+        register_pk(4);
+        register_pk(99); // out of range: ignored
+        REGISTER_PEER[transport(true)].inc();
+        TURN_BYTES[1].add(1500);
+        let after = render_hbbs(&now());
+        for s in [
+            "hbbs_punch_hole_total{result=\"offline\"}",
+            "hbbs_register_pk_total{result=\"too_frequent\"}",
+            "hbbs_register_peer_total{transport=\"ws\"}",
+        ] {
+            assert_eq!(value(&after, s), value(&before, s) + 1., "{s}");
+        }
+        assert_eq!(value(&after, "hbbs_turn_bytes_total{direction=\"from_peer\"}"), value(&before, "hbbs_turn_bytes_total{direction=\"from_peer\"}") + 1500.);
+        assert_eq!(value(&after, "hbbs_peers_signalling{transport=\"udp\"}"), 3.);
+        assert_eq!(value(&after, "hbbs_turn_allocations_max"), 64.);
+        assert!(value(&after, "process_resident_memory_bytes") > 0.);
+        assert!(value(&after, "process_open_fds") > 0.);
+        assert!(value(&after, "process_start_time_seconds") > 1.6e9);
+        // Every sample line belongs to a declared metric.
+        for l in after.lines().filter(|l| !l.starts_with('#')) {
+            let name = l.split(['{', ' ']).next().unwrap();
+            assert!(after.contains(&format!("# TYPE {name} ")), "undeclared {name}");
+        }
+    }
+
+    #[test]
+    fn relays_health_assignment_and_failover() {
+        let all = vec![("a.example".to_owned(), false), ("b.example".to_owned(), true)];
+        relay_check(&all, &[("a.example".into(), 3, false), ("b.example".into(), 0, true)]);
+        relay_assigned("a.example");
+        relay_assigned("a.example");
+        relay_assigned("");
+        let t = render_hbbs(&now());
+        assert_eq!(value(&t, "hbbs_relay_healthy{relay=\"a.example\",role=\"primary\"}"), 1.);
+        assert_eq!(value(&t, "hbbs_relay_sessions{relay=\"a.example\",role=\"primary\"}"), 3.);
+        assert_eq!(value(&t, "hbbs_relay_assigned_total{relay=\"a.example\",role=\"primary\"}"), 2.);
+        assert_eq!(value(&t, "hbbs_relay_assigned_total{relay=\"none\",role=\"primary\"}"), 1.);
+        relay_check(&all, &[("b.example".into(), 0, true)]);
+        failover(true);
+        failover(true); // no new transition
+        let t = render_hbbs(&now());
+        assert_eq!(value(&t, "hbbs_relay_healthy{relay=\"a.example\",role=\"primary\"}"), 0.);
+        assert_eq!(value(&t, "hbbs_relay_failover"), 1.);
+        assert_eq!(value(&t, "hbbs_relay_failover_transitions_total{to=\"backup\"}"), 1.);
+        failover(false);
+        let t = render_hbbs(&now());
+        assert_eq!(value(&t, "hbbs_relay_failover_transitions_total{to=\"primary\"}"), 1.);
+        // The label set stays bounded whatever names come in.
+        for i in 0..100 {
+            relay_assigned(&format!("r{i}"));
+        }
+        assert!(RELAYS.lock().unwrap().len() <= MAX_RELAYS);
+    }
+
+    #[test]
+    fn hbbr_render() {
+        {
+            let _s = Open::new(&RELAY_SESSIONS[1]);
+            PAIRED[1].inc();
+            RELAY_BYTES.add(10);
+            let t = render_hbbr(true);
+            assert_eq!(value(&t, "hbbr_sessions{transport=\"ws\"}"), 1.);
+            assert_eq!(value(&t, "hbbr_pairs_total{transport=\"ws\"}"), 1.);
+            assert_eq!(value(&t, "hbbr_relayed_bytes_total"), 10.);
+            assert_eq!(value(&t, "hbbr_draining"), 1.);
+        }
+        assert_eq!(value(&render_hbbr(false), "hbbr_sessions{transport=\"ws\"}"), 0.);
+    }
+
+    #[test]
+    fn serves_metrics_on_localhost_only() {
+        hbb_common::tokio::runtime::Runtime::new().unwrap().block_on(async {
+            use hbb_common::tokio::io::{AsyncReadExt, AsyncWriteExt};
+            // Free port, then serve on it (METRICS_PORT is read by serve; this test owns it).
+            let port = std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port();
+            std::env::set_var("METRICS_PORT", port.to_string());
+            hbb_common::tokio::spawn(serve(1, || async { render_hbbr(false) }));
+            let mut got = String::new();
+            for _ in 0..50 {
+                hbb_common::tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+                if let Ok(mut s) = hbb_common::tokio::net::TcpStream::connect(("127.0.0.1", port)).await {
+                    s.write_all(b"GET /metrics HTTP/1.1\r\n\r\n").await.unwrap();
+                    s.read_to_string(&mut got).await.ok();
+                    break;
+                }
+            }
+            assert!(got.starts_with("HTTP/1.1 200 OK"), "{got}");
+            assert!(got.contains("# TYPE hbbr_sessions gauge"));
+        });
+    }
+}
