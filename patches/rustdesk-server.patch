+async fn hosts(a: &Args) {
+    let n = a.num("n", 1000);
+    let ctx = Arc::new(HostCtx {
+        url: a.get("url", "ws://127.0.0.1:21118"),
+        viewer: a.get("viewer", &a.get("url", "ws://127.0.0.1:21118")),
+        key: a.get("key", ""),
+        ips: a.num("ips", 250).max(1),
+        s: HostStats::default(),
+        reg: Hist::new(),
+        rtt: Hist::new(),
+        punch: Hist::new(),
+        rr: Hist::new(),
+        up: (0..n).map(|_| Default::default()).collect(),
+        pending: Mutex::new(HashMap::new()),
+        fails: Default::default(),
+    });
+    let rate = a.num("rate", 500).max(1) as u64;
+    let probes = a.num("probe", 0) as u64;
+    let seconds = a.num("seconds", 60) as u64;
+    let report = a.num("report", 5) as u64;
+    let end = Instant::now() + Duration::from_secs(seconds);
+    let c = ctx.clone();
+    tokio::spawn(async move {
+        for i in 0..n {
+            let c = c.clone();
+            if c.url.starts_with("udp://") {
+                tokio::spawn(host_udp(c, i));
+            } else if c.url.starts_with("tcp://") {
+                tokio::spawn(host_tcp(c, i));
+            } else {
+                tokio::spawn(host_ws(c, i));
+            }
+            // Tokio sleeps in whole milliseconds: above 1000/s start a batch per millisecond.
+            if rate <= 1000 || (i + 1) as u64 % (rate / 1000) == 0 {
+                sleep(Duration::from_micros(1_000_000 / rate.min(1000))).await;
+            }
+        }
+    });
+    if probes > 0 {
+        let c = ctx.clone();
+        tokio::spawn(async move {
+            let mut k = 0usize;
+            let mut tick = interval(Duration::from_micros(1_000_000 / probes));
+            loop {
+                tick.tick().await;
+                let up: Vec<usize> = (0..20)
+                    .map(|_| hbb_common::rand::random::<usize>() % c.up.len())
+                    .filter(|i| c.up[*i].load(Relaxed))
+                    .take(1)
+                    .collect();
+                if let Some(i) = up.first() {
+                    tokio::spawn(probe(c.clone(), k, *i));
+                    k += 1;
+                }
+            }
+        });
+    }
+    let mut tick = interval(Duration::from_secs(report));
+    tick.tick().await;
+    loop {
+        tick.tick().await;
+        let s = &ctx.s;
+        println!(
+            "{}",
+            serde_json::json!({
+                "t": t0().elapsed().as_secs(), "registered": s.registered.load(Relaxed),
+                "connected": s.connected.load(Relaxed), "connects": s.connects.load(Relaxed),
+                "connect_fail": s.connect_fail.load(Relaxed), "too_frequent": s.too_frequent.load(Relaxed),
+                "other_refusal": s.other_refusal.load(Relaxed), "silent_drops": s.silent_drops.load(Relaxed),
+                "closed": s.closed.load(Relaxed), "punch_ok": s.punch_ok.load(Relaxed),
+                "punch_fail": s.punch_fail.load(Relaxed), "rr_ok": s.rr_ok.load(Relaxed),
+                "rr_timeout": s.rr_timeout.load(Relaxed), "punch_failures": ctx.fails.lock().unwrap().clone(),
+                "reg_ms": ctx.reg.take(), "ping_rtt_ms": ctx.rtt.take(),
+                "punchhole_ms": ctx.punch.take(), "relay_response_ms": ctx.rr.take(),
+            })
+        );
+        if Instant::now() >= end {
+            break;
+        }
+    }
+}
