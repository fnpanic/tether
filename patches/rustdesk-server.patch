+/// Plain HTTP health endpoint on HEALTH_PORT (default `default_port`, 0 = off), for Kubernetes
+/// probes and for hbbs checking its relays: `/healthz` is 200 while the process runs, `/readyz`
+/// is 200 `ready sessions=N` or 503 `draining sessions=N`, `/pubkey` (hbbs) the signing public key,
+/// `/peer-pk/<id>` (hbbs, Tether) the key held for an ID, see [`PeerLookup`].
+pub async fn serve_health(default_port: u16, sessions: fn() -> usize, lookup: Option<PeerLookup>) {
+    let port: u16 = std::env::var("HEALTH_PORT").ok().and_then(|v| v.parse().ok()).unwrap_or(default_port);
+    if port == 0 {
+        return;
+    }
+    let listener = match hbb_common::tokio::net::TcpListener::bind(("0.0.0.0", port)).await {
+        Ok(l) => l,
+        Err(err) => {
+            log::error!("health endpoint on :{port} failed: {err}");
+            return;
+        }
+    };
+    log::info!("Health endpoint on http :{port} (/healthz, /readyz, /pubkey{})", if lookup.is_some() { ", /peer-pk" } else { "" });
+    let lookup = std::sync::Arc::new(lookup);
+    while let Ok((mut stream, peer)) = listener.accept().await {
+        let lookup = lookup.clone();
+        tokio::spawn(async move {
+            use hbb_common::tokio::io::{AsyncReadExt, AsyncWriteExt};
+            let mut buf = [0u8; 1024];
+            let n = match hbb_common::timeout(2_000, stream.read(&mut buf)).await {
+                Ok(Ok(n)) => n,
+                _ => return,
+            };
+            let req = String::from_utf8_lossy(&buf[..n]);
+            let path = req.split_whitespace().nth(1).unwrap_or("");
+            let (code, body) = health_response(path, is_draining(), sessions(), SIGNING_PUB_KEY.get().map(String::as_str), peer.ip(), lookup.as_ref().as_ref()).await;
+            let res = format!(
+                "HTTP/1.1 {code}\r\nContent-Type: text/plain\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                body.len()
+            );
+            stream.write_all(res.as_bytes()).await.ok();
+        });
+    }
+}
+
+async fn health_response(path: &str, draining: bool, sessions: usize, pubkey: Option<&str>, peer: std::net::IpAddr, lookup: Option<&PeerLookup>) -> (&'static str, String) {
+    let path = path.split('?').next().unwrap_or("");
+    // Tether: everything refused here falls through to the 404 below.
+    if let (Some(id), Some(l)) = (path.strip_prefix("/peer-pk/"), lookup) {
+        if peer_lookup_allowed(peer, &l.from) && lookup_id_ok(id) {
+            if let Some(pk) = (l.pk)(id.to_owned()).await.filter(|pk| !pk.is_empty()) {
+                return ("200 OK", format!("{}\n", base64::encode(pk)));
+            }
+        }
+    }
+    match path {
+        "/pubkey" if pubkey.is_some() => ("200 OK", format!("{}\n", pubkey.unwrap_or_default())),
+        "/healthz" => ("200 OK", "ok\n".to_owned()),
+        "/readyz" if draining => ("503 Service Unavailable", format!("draining sessions={sessions}\n")),
+        "/readyz" => ("200 OK", format!("ready sessions={sessions}\n")),
+        _ => ("404 Not Found", "not found\n".to_owned()),
+    }
+}
