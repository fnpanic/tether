+        tokio::spawn(async move {
+            let mut c: Option<Http> = None;
+            while Instant::now() < end {
+                if c.is_none() {
+                    c = Http::connect(&addr).await.ok();
+                }
+                let Some(h) = c.as_mut() else {
+                    stats.errors.fetch_add(1, Relaxed);
+                    sleep(Duration::from_millis(200)).await;
+                    continue;
+                };
+                let t = Instant::now();
+                match h.req(&format!("GET {path} HTTP/1.1\r\nHost: {host}\r\n\r\n"), &[], kbps).await {
+                    Ok((st, n)) => {
+                        lat.add(t.elapsed());
+                        stats.bytes.fetch_add(n, Relaxed);
+                        stats.count(st.to_string());
+                    }
+                    Err(_) => {
+                        stats.errors.fetch_add(1, Relaxed);
+                        c = None;
+                    }
+                }
+            }
+        });
+    }
+    let mut tick = interval(Duration::from_secs(a.num("report", 5) as u64));
+    tick.tick().await;
+    let mut last = (0u64, Instant::now());
+    loop {
+        tick.tick().await;
+        let b = stats.bytes.load(Relaxed);
+        let st = std::mem::take(&mut *stats.by_status.lock().unwrap());
+        println!(
+            "{}",
+            serde_json::json!({"t": t0().elapsed().as_secs(), "status": st, "errors": stats.errors.load(Relaxed),
+                "mbit_s": ((b - last.0) as f64 * 8.0 / last.1.elapsed().as_secs_f64() / 1e6).round(), "latency_ms": lat.take()})
+        );
+        last = (b, Instant::now());
+        if Instant::now() >= end {
+            break;
+        }
+    }
+}
