+#[allow(dead_code)]
+const STUN_COOKIE: u32 = 0x2112_A442;
+
+/// Tether: answer a STUN binding request (RFC 5389) with the sender's address, so the hbbs UDP
+/// port doubles as the STUN server for WebRTC's server-reflexive (NAT) candidates. `None` for
+/// anything else, which the rendezvous protocol then handles as before.
+#[allow(dead_code)]
+pub(crate) fn stun_binding_response(req: &[u8], from: SocketAddr) -> Option<Vec<u8>> {
+    if req.len() < 20
+        || req[0..2] != [0x00, 0x01]
+        || req[4..8] != STUN_COOKIE.to_be_bytes()
+        || u16::from_be_bytes([req[2], req[3]]) as usize != req.len() - 20
+    {
+        return None;
+    }
+    let from = hbb_common::try_into_v4(from);
+    let port = from.port() ^ (STUN_COOKIE >> 16) as u16;
+    let mut attr = vec![0x00];
+    match from.ip() {
+        std::net::IpAddr::V4(ip) => {
+            attr.push(0x01);
+            attr.extend(port.to_be_bytes());
+            attr.extend((u32::from(ip) ^ STUN_COOKIE).to_be_bytes());
+        }
+        std::net::IpAddr::V6(ip) => {
+            attr.push(0x02);
+            attr.extend(port.to_be_bytes());
+            let mut key = STUN_COOKIE.to_be_bytes().to_vec();
+            key.extend(&req[8..20]);
+            attr.extend(ip.octets().iter().zip(key).map(|(a, k)| a ^ k));
+        }
+    }
+    let mut res = vec![0x01, 0x01];
+    res.extend((4 + attr.len() as u16).to_be_bytes());
+    res.extend(&req[4..20]); // cookie + transaction id
+    res.extend([0x00, 0x20]); // XOR-MAPPED-ADDRESS
+    res.extend((attr.len() as u16).to_be_bytes());
+    res.extend(attr);
+    Some(res)
+}
+
+#[cfg(test)]
+mod stun_tests {
+    use super::stun_binding_response;
+
+    #[test]
+    fn binding_request_gets_xor_mapped_address() {
+        let mut req = vec![0x00, 0x01, 0x00, 0x00, 0x21, 0x12, 0xA4, 0x42];
+        req.extend(1..=12u8);
+        let res = stun_binding_response(&req, "[::ffff:192.0.2.1]:32853".parse().unwrap()).unwrap();
+        assert_eq!(&res[0..4], &[0x01, 0x01, 0x00, 0x0c]);
+        assert_eq!(&res[4..20], &req[4..20]);
+        // 32853 ^ 0x2112 = 0xA147, 192.0.2.1 ^ 0x2112A442 = 0xE112A643
+        assert_eq!(&res[20..], &[0x00, 0x20, 0x00, 0x08, 0x00, 0x01, 0xA1, 0x47, 0xE1, 0x12, 0xA6, 0x43]);
+        let v6 = stun_binding_response(&req, "[2001:db8::1]:1".parse().unwrap()).unwrap();
+        assert_eq!(v6.len(), 20 + 4 + 20);
+        // Not STUN: a rendezvous message, a STUN response, a wrong length.
+        assert!(stun_binding_response(&[0x0a, 0x02, 0x08, 0x01], "1.2.3.4:5".parse().unwrap()).is_none());
+        let mut resp = req.clone();
+        resp[0] = 0x01;
+        assert!(stun_binding_response(&resp, "1.2.3.4:5".parse().unwrap()).is_none());
+        req.push(0);
+        assert!(stun_binding_response(&req, "1.2.3.4:5".parse().unwrap()).is_none());
+    }
+}
