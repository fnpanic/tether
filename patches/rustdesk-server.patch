+//! Tether relay HA test harness: N host/viewer pairs that connect the way Tether clients do
+//! (host registered over WebSocket at hbbs, viewer asks hbbs for the host, both pair at the relay
+//! hbbs hands out) and stream timestamped frames host -> viewer. When a relay connection drops,
+//! the viewer asks hbbs again and both re-pair on the relay it hands out, like the real client's
+//! reconnect. Prints one JSON report.
+//!
+//!   relay-harness hbbs=ws://proxy/ws/id/0[,ws://proxy/ws/id/1] key=<server pub key> sessions=4 seconds=60
+//!                 [session_seconds=20] [frame_ms=20] [frame_bytes=1024]
+//! session_seconds > 0 ends each session after that long and starts a new one (churn).
+use hbb_common::{
+    futures_util::{SinkExt, StreamExt},
+    protobuf::Message as _,
+    rendezvous_proto::*,
+    tokio::{
+        self,
+        sync::mpsc,
+        time::{interval, sleep, timeout, Duration, Instant},
+    },
+};
+use tokio_tungstenite::tungstenite::Message;
+
+type Ws = tokio_tungstenite::WebSocketStream<tokio::net::TcpStream>;
+type Error = Box<dyn std::error::Error + Send + Sync>;
+
+/// ws:// only (the harness runs next to the proxy); TCP_NODELAY like the real client and hbbr.
+async fn connect_async(url: &str) -> Result<(Ws, ()), Error> {
+    let rest = url.strip_prefix("ws://").ok_or("harness speaks ws:// only")?;
+    let host = rest.split('/').next().unwrap_or(rest);
+    let addr = if host.contains(':') { host.to_owned() } else { format!("{host}:80") };
+    let tcp = tokio::net::TcpStream::connect(addr).await?;
+    tcp.set_nodelay(true)?;
+    let (ws, _) = tokio_tungstenite::client_async(url, tcp).await?;
+    Ok((ws, ()))
+}
+
+#[derive(Clone)]
+struct Cfg {
+    /// Every rendezvous server, like the client's server list.
+    hbbs: Vec<String>,
+    key: String,
+    frame_ms: u64,
+    frame_bytes: usize,
+}
+
+#[derive(Default, Debug, serde_derive::Serialize)]
+struct Report {
+    id: String,
+    frames: u64,
+    /// Relay connections that broke mid-session and were re-paired.
+    reconnects: u32,
+    /// Gap in received frames across each reconnect, ms.
+    gaps_ms: Vec<u64>,
+    max_gap_ms: u64,
+    /// Longest silence between two frames on one connection, ms.
+    max_stall_ms: u64,
+    latency_p50_ms: f64,
+    latency_p99_ms: f64,
+    relays: Vec<String>,
+    completed: bool,
+}
+
+fn t0() -> Instant {
+    static T0: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+    *T0.get_or_init(Instant::now)
+}
+
+fn bin(msg: &RendezvousMessage) -> Message {
+    Message::Binary(msg.write_to_bytes().unwrap_or_default())
+}
+
+async fn recv_msg(ws: &mut Ws, ms: u64) -> Option<RendezvousMessage> {
+    let deadline = Instant::now() + Duration::from_millis(ms);
+    loop {
+        let left = deadline.saturating_duration_since(Instant::now());
+        match timeout(left, ws.next()).await {
+            Ok(Some(Ok(Message::Binary(b)))) if !b.is_empty() => {
+                return RendezvousMessage::parse_from_bytes(&b).ok()
+            }
+            Ok(Some(Ok(_))) => continue,
+            _ => return None,
+        }
+    }
+}
+
+async fn connect_relay(cfg: &Cfg, relay: &str, uuid: &str, id: &str) -> Option<Ws> {
+    let (mut ws, _) = timeout(Duration::from_millis(1000), connect_async(relay)).await.ok()?.ok()?;
+    let mut m = RendezvousMessage::new();
+    m.set_request_relay(RequestRelay {
+        id: id.to_owned(),
+        uuid: uuid.to_owned(),
+        licence_key: cfg.key.clone(),
+        ..Default::default()
+    });
+    ws.send(bin(&m)).await.ok()?;
+    Some(ws)
+}
+
+/// One hbbs registration of the host, kept up like the real client does: re-register at once
+/// when the connection drops (e.g. that hbbs pod restarts). Forwards PunchHole with its hbbs URL.
+async fn registrar(url: String, id: String, ev: mpsc::UnboundedSender<(String, PunchHole)>) {
+    loop {
+        if let Ok(Ok((mut ws, _))) = timeout(Duration::from_millis(1000), connect_async(&url)).await {
+            let mut m = RendezvousMessage::new();
+            m.set_register_pk(RegisterPk {
+                id: id.clone(),
+                uuid: id.as_bytes().to_vec().into(),
+                pk: vec![7u8; 32].into(),
+                ..Default::default()
+            });
+            let mut ok = ws.send(bin(&m)).await.is_ok() && recv_msg(&mut ws, 2000).await.is_some();
+            if ok {
+                let mut m = RendezvousMessage::new();
+                m.set_register_peer(RegisterPeer { id: id.clone(), serial: 0, ..Default::default() });
+                ok = ws.send(bin(&m)).await.is_ok();
+            }
+            // Liveness like the client should do it: WebSocket ping each second (hbbs answers
+            // pongs on its own), dead after 2.5 s of silence. Every 5th tick also the protocol
+            // heartbeat (empty binary frame) that keeps the registration fresh at hbbs.
+            let mut hb = interval(Duration::from_secs(1));
+            let mut n = 0u32;
+            let mut last_rx = Instant::now();
+            while ok {
+                tokio::select! {
+                    _ = hb.tick() => {
+                        n += 1;
+                        let m = if n % 5 == 0 { Message::Binary(Vec::new()) } else { Message::Ping(Vec::new()) };
+                        ok = ws.send(m).await.is_ok() && last_rx.elapsed() < Duration::from_millis(2500);
+                    }
+                    m = ws.next() => match { last_rx = Instant::now(); m } {
+                        Some(Ok(Message::Binary(b))) => {
+                            if let Ok(RendezvousMessage { union: Some(rendezvous_message::Union::PunchHole(ph)), .. }) =
+                                RendezvousMessage::parse_from_bytes(&b)
+                            {
+                                ev.send((url.clone(), ph)).ok();
+                            }
+                        }
+                        Some(Ok(_)) => {}
+                        _ => ok = false,
+                    }
+                }
+            }
+        }
+        sleep(Duration::from_millis(100)).await;
+    }
+}
+
+/// The controlled side: registered at every hbbs, answers each PunchHole by pairing at the relay
+/// it names and streams frames on the newest relay connection.
+async fn host(cfg: Cfg, id: String, mut stop: mpsc::Receiver<()>) {
+    let (ev_tx, mut ev_rx) = mpsc::unbounded_channel();
+    let regs: Vec<_> =
+        cfg.hbbs.iter().map(|u| tokio::spawn(registrar(u.clone(), id.clone(), ev_tx.clone()))).collect();
+    let (relay_tx, mut relay_rx) = mpsc::unbounded_channel::<Ws>();
+    let frame_ms = cfg.frame_ms;
+    let frame_bytes = cfg.frame_bytes.max(16);
+    let streamer = tokio::spawn(async move {
+        let mut cur: Option<Ws> = None;
+        let mut seq = 0u64;
+        let mut tick = interval(Duration::from_millis(frame_ms));
+        loop {
+            tokio::select! {
+                Some(ws) = relay_rx.recv() => { cur = Some(ws); }
+                _ = tick.tick() => {
+                    if let Some(ws) = cur.as_mut() {
+                        let mut f = vec![0u8; frame_bytes];
+                        f[..8].copy_from_slice(&seq.to_le_bytes());
+                        f[8..16].copy_from_slice(&(t0().elapsed().as_micros() as u64).to_le_bytes());
+                        if ws.send(Message::Binary(f)).await.is_err() {
+                            cur = None;
+                        } else {
+                            seq += 1;
+                        }
+                    }
+                }
+            }
+        }
+    });
+    loop {
+        tokio::select! {
+            _ = stop.recv() => break,
+            Some((url, ph)) = ev_rx.recv() => {
+                let (cfg, id, tx) = (cfg.clone(), id.clone(), relay_tx.clone());
+                tokio::spawn(async move {
+                    let uuid = uuid::Uuid::new_v4().to_string();
+                    // RelayResponse goes to the hbbs that sent the PunchHole; it forwards it to the viewer.
+                    if let Ok(Ok((mut ws, _))) = timeout(Duration::from_millis(1000), connect_async(&url)).await {
+                        let mut rr = RelayResponse {
+                            socket_addr: ph.socket_addr.clone(),
+                            uuid: uuid.clone(),
+                            relay_server: ph.relay_server.clone(),
+                            ..Default::default()
+                        };
+                        rr.set_id(id.clone());
+                        let mut m = RendezvousMessage::new();
+                        m.set_relay_response(rr);
+                        ws.send(bin(&m)).await.ok();
+                        ws.close(None).await.ok();
+                    }
+                    if let Some(ws) = connect_relay(&cfg, &ph.relay_server, &uuid, &id).await {
+                        tx.send(ws).ok();
+                    }
+                });
+            }
+        }
+    }
+    streamer.abort();
+    regs.iter().for_each(|r| r.abort());
+}
+
+/// Asks the hbbs servers for the host in turn; returns (uuid, relay) from the host's RelayResponse.
+async fn punch(cfg: &Cfg, id: &str, _start: usize) -> Option<(String, String)> {
+    // Race every hbbs, like the client: first RelayResponse wins.
+    let (tx, mut rx) = mpsc::unbounded_channel();
+    let tasks: Vec<_> = cfg
+        .hbbs
+        .iter()
+        .map(|url| {
+            let (cfg, url, id, tx) = (cfg.clone(), url.clone(), id.to_owned(), tx.clone());
+            tokio::spawn(async move { tx.send(punch_one(&cfg, &url, &id).await).ok() })
+        })
+        .collect();
+    drop(tx);
+    let mut r = None;
+    while let Some(x) = rx.recv().await {
+        if x.is_some() {
+            r = x;
+            break;
+        }
+    }
+    tasks.iter().for_each(|t| t.abort());
+    r
+}
+
+async fn punch_one(cfg: &Cfg, url: &str, id: &str) -> Option<(String, String)> {
+    let (mut ws, _) = timeout(Duration::from_millis(1000), connect_async(url)).await.ok()?.ok()?;
+    let mut m = RendezvousMessage::new();
+    m.set_punch_hole_request(PunchHoleRequest {
+        id: id.to_owned(),
+        nat_type: NatType::SYMMETRIC.into(),
+        licence_key: cfg.key.clone(),
+        ..Default::default()
+    });
+    ws.send(bin(&m)).await.ok()?;
+    let r = match recv_msg(&mut ws, 1500).await?.union {
+        Some(rendezvous_message::Union::RelayResponse(rr)) => Some((rr.uuid, rr.relay_server)),
+        _ => None,
+    };
+    ws.close(None).await.ok();
+    r
+}
+
+async fn viewer(cfg: Cfg, id: String, secs: u64) -> Report {
+    let mut rep = Report { id: id.clone(), ..Default::default() };
+    let end = Instant::now() + Duration::from_secs(secs);
+    let mut lat = Vec::new();
+    let mut last_frame: Option<Instant> = None;
+    let mut first = true;
+    while Instant::now() < end {
+        // Ask the hbbs servers in turn, starting with a different one per session.
+        let start = id.bytes().map(|b| b as usize).sum::<usize>();
+        let Some((uuid, relay)) = punch(&cfg, &id, start).await else {
+            sleep(Duration::from_millis(50)).await;
+            continue;
+        };
+        let Some(mut ws) = connect_relay(&cfg, &relay, &uuid, &id).await else { continue };
+        let mut got_one = false;
+        loop {
+            if Instant::now() >= end {
+                rep.completed = true;
+                break;
+            }
+            // Before the first frame, give up sooner: the pairing may have gone to a dead relay.
+            let wait = if got_one { 1000 } else { 700 };
+            match timeout(Duration::from_millis(wait), ws.next()).await {
+                Ok(Some(Ok(Message::Binary(f)))) if f.len() >= 16 => {
+                    let now = Instant::now();
+                    let sent = u64::from_le_bytes(f[8..16].try_into().unwrap());
+                    lat.push((t0().elapsed().as_micros() as u64).saturating_sub(sent) as f64 / 1000.);
+                    if let Some(prev) = last_frame {
+                        let gap = now.duration_since(prev).as_millis() as u64;
+                        if !got_one && !first {
+                            rep.gaps_ms.push(gap);
+                            rep.max_gap_ms = rep.max_gap_ms.max(gap);
+                        } else if got_one {
+                            rep.max_stall_ms = rep.max_stall_ms.max(gap);
+                        }
+                    }
+                    if !got_one {
+                        rep.relays.push(relay.clone());
+                    }
+                    got_one = true;
+                    last_frame = Some(now);
+                    rep.frames += 1;
+                }
+                Ok(Some(Ok(_))) => {}
+                _ => break,
+            }
+        }
+        if rep.completed {
+            break;
+        }
+        if got_one {
+            rep.reconnects += 1;
+            first = false;
+        }
+    }
+    lat.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    if !lat.is_empty() {
+        rep.latency_p50_ms = lat[lat.len() / 2];
+        rep.latency_p99_ms = lat[(lat.len() * 99 / 100).min(lat.len() - 1)];
+    }
+    rep
+}
+
+
+async fn session(cfg: Cfg, id: String, secs: u64) -> Report {
+    let (stop_tx, stop_rx) = mpsc::channel(1);
+    let h = tokio::spawn(host(cfg.clone(), id.clone(), stop_rx));
+    // Let the host register before the first request.
+    sleep(Duration::from_millis(300)).await;
+    let rep = viewer(cfg, id, secs).await;
+    stop_tx.send(()).await.ok();
+    h.await.ok();
+    rep
+}
+
+#[tokio::main]
+async fn main() {
+    let mut a = std::collections::HashMap::new();
+    for kv in std::env::args().skip(1) {
+        if let Some((k, v)) = kv.split_once('=') {
+            a.insert(k.to_owned(), v.to_owned());
+        }
+    }
+    let get = |k: &str, d: &str| a.get(k).cloned().unwrap_or_else(|| d.to_owned());
+    let cfg = Cfg {
+        hbbs: get("hbbs", "ws://127.0.0.1:21118").split(',').map(|s| s.to_owned()).collect(),
+        key: get("key", ""),
+        frame_ms: get("frame_ms", "20").parse().unwrap_or(20),
+        frame_bytes: get("frame_bytes", "1024").parse().unwrap_or(1024),
+    };
+    let sessions: usize = get("sessions", "4").parse().unwrap_or(4);
+    let seconds: u64 = get("seconds", "60").parse().unwrap_or(60);
+    let per: u64 = get("session_seconds", "0").parse().unwrap_or(0);
+    let run = format!("{:06x}", rand_suffix());
+    t0();
+    let started = std::time::SystemTime::now();
+    let mut tasks = Vec::new();
+    for i in 0..sessions {
+        let cfg = cfg.clone();
+        let run = run.clone();
+        tasks.push(tokio::spawn(async move {
+            let end = Instant::now() + Duration::from_secs(seconds);
+            let mut out = Vec::new();
+            let mut n = 0;
+            loop {
+                let left = end.saturating_duration_since(Instant::now()).as_secs();
+                if left == 0 {
+                    break;
+                }
+                let secs = if per > 0 { per.min(left) } else { left };
+                out.push(session(cfg.clone(), format!("h{run}{i:02}{n:03}"), secs).await);
+                n += 1;
+                if per == 0 {
+                    break;
+                }
+            }
+            out
+        }));
+    }
+    let mut all = Vec::new();
+    for t in tasks {
+        all.extend(t.await.unwrap_or_default());
+    }
+    let reconnects: u32 = all.iter().map(|r| r.reconnects).sum();
+    let max_gap = all.iter().map(|r| r.max_gap_ms).max().unwrap_or(0);
+    let max_stall = all.iter().map(|r| r.max_stall_ms).max().unwrap_or(0);
+    let incomplete = all.iter().filter(|r| !r.completed || r.frames == 0).count();
+    let out = serde_json::json!({
+        "started_unix": started.duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0),
+        "hbbs": cfg.hbbs, "sessions": all.len(), "seconds": seconds,
+        "frame_ms": cfg.frame_ms, "frame_bytes": cfg.frame_bytes,
+        "reconnects": reconnects, "max_gap_ms": max_gap, "max_stall_ms": max_stall,
+        "incomplete_sessions": incomplete,
+        "per_session": all,
+    });
+    println!("{}", serde_json::to_string_pretty(&out).unwrap_or_default());
+}
+
+fn rand_suffix() -> u32 {
+    use hbb_common::rand::Rng;
+    hbb_common::rand::thread_rng().gen::<u32>() & 0xffffff
+}
