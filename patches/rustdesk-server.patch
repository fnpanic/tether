+/// Serves `GET /metrics` with `render()` on METRICS_ADDR:METRICS_PORT (default 127.0.0.1 and
+/// `default_port`; port 0 = off). Never bind it to a public address: docs/monitoring.md.
+pub async fn serve<F, Fut>(default_port: u16, render: F)
+where
+    F: Fn() -> Fut + Send + Sync + Clone + 'static,
+    Fut: std::future::Future<Output = String> + Send,
+{
+    use hbb_common::tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let port: u16 = std::env::var("METRICS_PORT").ok().and_then(|v| v.parse().ok()).unwrap_or(default_port);
+    if port == 0 {
+        return;
+    }
+    let addr = std::env::var("METRICS_ADDR").ok().filter(|v| !v.trim().is_empty()).unwrap_or_else(|| "127.0.0.1".into());
+    let listener = match hbb_common::tokio::net::TcpListener::bind((addr.trim(), port)).await {
+        Ok(l) => l,
+        Err(err) => {
+            hbb_common::log::error!("metrics endpoint on {addr}:{port} failed: {err}");
+            return;
+        }
+    };
+    hbb_common::log::info!("Metrics endpoint on http://{addr}:{port}/metrics");
+    while let Ok((mut stream, _)) = listener.accept().await {
+        let render = render.clone();
+        hbb_common::tokio::spawn(async move {
+            let mut buf = [0u8; 1024];
+            let n = match hbb_common::timeout(2_000, stream.read(&mut buf)).await {
+                Ok(Ok(n)) => n,
+                _ => return,
+            };
+            let req = String::from_utf8_lossy(&buf[..n]);
+            let path = req.split_whitespace().nth(1).unwrap_or("");
+            let (code, body) = if path.split('?').next() == Some("/metrics") {
+                ("200 OK", render().await)
+            } else {
+                ("404 Not Found", "not found\n".to_owned())
+            };
+            let res = format!(
+                "HTTP/1.1 {code}\r\nContent-Type: text/plain; version=0.0.4\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                body.len()
+            );
+            stream.write_all(res.as_bytes()).await.ok();
+        });
+    }
+}
