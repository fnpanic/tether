@@ -0,0 +1,768 @@
+//! Tether: a TURN server (RFC 5766, UDP) inside hbbs, on hbbs's own UDP port (21116), so a
+//! WebRTC session that cannot form a direct pair is relayed over UDP instead of hbbr's
+//! TCP/WebSocket leg. The core's WebRTC data channel (KCP-style SCTP, see
+//! vendor/rustdesk/Cargo.toml) recovers a loss within about an RTT, where TCP holds every later
+//! byte back (head-of-line blocking) and shrinks its window.
+//!
+//! Single port: every allocation's relayed address is `<public IP>:21116`, the port the relays
+//! already open. hbbs hands each datagram to `Turn::dispatch` first: TURN requests and the
+//! ChannelData of known TURN clients go to the TURN server, datagrams from a peer an allocation
+//! has sent to go to that allocation, everything else (rendezvous, STUN binding) stays with hbbs.
+//! Peers are told apart by their address, which is what a relayed address normally does by port.
+//!
+//! Credentials follow the TURN REST API (draft-uberti-behave-turn-rest): username
+//! `<unix expiry>:<tag>`, password `base64(HMAC-SHA1(secret, username))`. The secret is random per
+//! hbbs process and never leaves it: hbbs issues a credential for itself in `PunchHole.turn_server`
+//! (over the host's TLS WebSocket) for each WebRTC offer. Clients carry no TURN secret.
+//!
+//! Abuse limits (a TURN server sends wherever it is told): no relaying to or from private,
+//! loopback, link-local, CGNAT, multicast or reserved addresses, IPv4-mapped/embedded forms of
+//! those, or the relay's own public address; at most `TURN_MAX_ALLOCATIONS` allocations and
+//! `MAX_PEERS` peers per allocation; a per-allocation bandwidth cap; a credential opens new
+//! allocations only for `CREDENTIAL_TTL`.
+
+use async_trait::async_trait;
+use hbb_common::log;
+use tokio::{net::UdpSocket, sync::mpsc};
+use std::collections::HashMap;
+use std::net::{IpAddr, Ipv4Addr, SocketAddr};
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+use turn::auth::{generate_auth_key, AuthHandler};
+use turn::relay::RelayAddressGenerator;
+use turn::server::config::{ConnConfig, ServerConfig};
+use turn::server::Server;
+use webrtc_util::Conn;
+
+/// How long a credential handed out by hbbs opens new allocations.
+pub const CREDENTIAL_TTL: u64 = 300;
+/// After expiry the allocation made with a credential may keep refreshing (same client address
+/// only) this long, so a session outlives its credential.
+const SESSION_MAX: u64 = 12 * 3600;
+/// Peers one allocation may send to (a session needs the other side's few candidates).
+const MAX_PEERS: usize = 16;
+const QUEUE: usize = 512;
+/// Unauthenticated TURN requests (the first Allocate of each session) per second, all clients.
+const UNAUTH_PER_SEC: usize = 50;
+pub const REALM: &str = "tether";
+
+pub fn now_secs() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_secs())
+}
+
+fn password(secret: &str, username: &str) -> String {
+    let key = ring::hmac::Key::new(ring::hmac::HMAC_SHA1_FOR_LEGACY_USE_ONLY, secret.as_bytes());
+    base64::encode(ring::hmac::sign(&key, username.as_bytes()).as_ref())
+}
+
+/// A fresh credential pair. Compatible with coturn's `use-auth-secret`.
+pub fn credential(secret: &str, tag: &str, now: u64) -> (String, String) {
+    let username = format!("{}:{}", now + CREDENTIAL_TTL, tag);
+    let pass = password(secret, &username);
+    (username, pass)
+}
+
+fn pct(s: &str) -> String {
+    s.bytes()
+        .map(|b| match b {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' => (b as char).to_string(),
+            _ => format!("%{:02X}", b),
+        })
+        .collect()
+}
+
+/// `turn://user:pass@host:port`, the form the core's `get_ice_server_from_url` takes.
+pub fn turn_url(host: &str, port: u16, secret: &str, tag: &str) -> String {
+    let (u, p) = credential(secret, tag, now_secs());
+    format!("turn://{}:{}@{}:{}", pct(&u), pct(&p), host, port)
+}
+
+/// Addresses a public TURN relay must never send to or accept from.
+pub fn forbidden_peer(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v4) => forbidden_v4(v4),
+        IpAddr::V6(v6) => {
+            if let Some(v4) = v6.to_ipv4_mapped() {
+                return forbidden_v4(v4);
+            }
+            let s = v6.segments();
+            v6.is_loopback()
+                || v6.is_unspecified()
+                || v6.is_multicast()
+                || s[0] & 0xfe00 == 0xfc00 // unique local
+                || s[0] & 0xffc0 == 0xfe80 // link local
+                || s[0] == 0x2001 && s[1] == 0x0db8 // documentation
+                || s[0..6] == [0, 0, 0, 0, 0, 0] // IPv4-compatible (deprecated)
+                || s[0] == 0x0064 && s[1] == 0xff9b // NAT64 well-known prefix, embeds any IPv4
+                || s[0] == 0x2002 // 6to4, embeds any IPv4
+        }
+    }
+}
+
+fn forbidden_v4(ip: Ipv4Addr) -> bool {
+    let o = ip.octets();
+    ip.is_private()
+        || ip.is_loopback()
+        || ip.is_link_local()
+        || ip.is_broadcast()
+        || ip.is_multicast()
+        || ip.is_unspecified()
+        || ip.is_documentation()
+        || o[0] == 0
+        || o[0] >= 240
+        || o[0] == 100 && o[1] & 0xc0 == 64 // 100.64.0.0/10 CGNAT
+        || o[0] == 192 && o[1] == 0 && o[2] == 0 // 192.0.0.0/24
+        || o[0] == 198 && o[1] & 0xfe == 18 // 198.18.0.0/15 benchmarking
+}
+
+fn v4(addr: SocketAddr) -> SocketAddr {
+    match addr {
+        SocketAddr::V6(a) => match a.ip().to_ipv4_mapped() {
+            Some(ip) => SocketAddr::new(IpAddr::V4(ip), a.port()),
+            None => addr,
+        },
+        _ => addr,
+    }
+}
+
+/// STUN method of a STUN-framed datagram (magic cookie present), `None` for anything else.
+fn stun_method(b: &[u8]) -> Option<u16> {
+    if b.len() < 20 || b[0] & 0xc0 != 0 || b[4..8] != [0x21, 0x12, 0xA4, 0x42] {
+        return None;
+    }
+    let t = u16::from_be_bytes([b[0], b[1]]);
+    Some(((t & 0x3e00) >> 2) | ((t & 0x00e0) >> 1) | (t & 0x000f))
+}
+
+/// Whether a STUN message carries MESSAGE-INTEGRITY, i.e. is an authenticated request.
+fn has_integrity(b: &[u8]) -> bool {
+    let mut i = 20;
+    while i + 4 <= b.len() {
+        let t = u16::from_be_bytes([b[i], b[i + 1]]);
+        if t == 0x0008 {
+            return true;
+        }
+        i += 4 + ((u16::from_be_bytes([b[i + 2], b[i + 3]]) as usize + 3) & !3);
+    }
+    false
+}
+
+fn is_channel_data(b: &[u8]) -> bool {
+    b.len() >= 4 && (0x40..=0x4f).contains(&b[0]) && {
+        let n = u16::from_be_bytes([b[2], b[3]]) as usize;
+        n + 4 <= b.len() && b.len() <= (n + 4 + 3) & !3
+    }
+}
+
+/// Validates TURN REST credentials. A credential opens allocations until it expires; after that
+/// only the client address that used it first may go on refreshing, up to `SESSION_MAX`.
+pub struct RestAuth {
+    secret: String,
+    first_use: Mutex<HashMap<String, SocketAddr>>,
+}
+
+impl RestAuth {
+    pub fn new(secret: String) -> Self {
+        Self { secret, first_use: Default::default() }
+    }
+
+    pub fn check(&self, username: &str, src: SocketAddr, now: u64) -> Result<String, String> {
+        let expiry: u64 = username
+            .split(':')
+            .next()
+            .and_then(|e| e.parse().ok())
+            .ok_or("malformed username")?;
+        let mut first = self.first_use.lock().unwrap();
+        if expiry >= now {
+            if expiry > now + CREDENTIAL_TTL + 60 {
+                return Err("credential lifetime too long".into());
+            }
+            // shortcut: recorded before MESSAGE-INTEGRITY is verified, so someone who saw the
+            // username (not the password) could claim it first; the host allocates within ms.
+            first.entry(username.to_owned()).or_insert(src);
+            if first.len() > 100_000 {
+                first.retain(|u, _| {
+                    u.split(':').next().and_then(|e| e.parse::<u64>().ok()).map_or(false, |e| e + SESSION_MAX >= now)
+                });
+            }
+        } else if expiry + SESSION_MAX < now || first.get(username) != Some(&src) {
+            return Err(format!("expired credential {username}"));
+        }
+        Ok(password(&self.secret, username))
+    }
+}
+
+impl AuthHandler for RestAuth {
+    fn auth_handle(&self, username: &str, realm: &str, src: SocketAddr) -> Result<Vec<u8>, turn::Error> {
+        match self.check(username, src, now_secs()) {
+            Ok(pass) => Ok(generate_auth_key(username, realm, &pass)),
+            Err(e) => {
+                log::debug!("TURN auth from {src} refused: {e}");
+                Err(turn::Error::Other(e))
+            }
+        }
+    }
+}
+
+/// Byte budget per second, refilled continuously. Over budget the datagram is dropped (UDP).
+struct Bucket {
+    rate: f64,
+    tokens: f64,
+    at: Instant,
+}
+
+impl Bucket {
+    fn new(rate: usize) -> Mutex<Self> {
+        Mutex::new(Self { rate: rate as f64, tokens: rate as f64 / 4., at: Instant::now() })
+    }
+    fn take(&mut self, n: usize) -> bool {
+        let now = Instant::now();
+        self.tokens = (self.tokens + now.duration_since(self.at).as_secs_f64() * self.rate).min(self.rate / 4.);
+        self.at = now;
+        if self.tokens < n as f64 {
+            return false;
+        }
+        self.tokens -= n as f64;
+        true
+    }
+}
+
+type Tx = mpsc::Sender<(Vec<u8>, SocketAddr)>;
+type Rx = tokio::sync::Mutex<mpsc::Receiver<(Vec<u8>, SocketAddr)>>;
+
+pub struct TurnConfig {
+    /// Name clients reach this hbbs at (RELAY_HOST), used in the handed-out URL.
+    pub host: String,
+    pub port: u16,
+    /// Fixed relay address; otherwise `host` is resolved every minute (DuckDNS follows the VM).
+    pub public_ip: Option<Ipv4Addr>,
+    pub max_allocations: usize,
+    /// Per allocation, bytes per second in each direction.
+    pub bandwidth: usize,
+    /// Lab only: relay to private addresses and to the relay's own address (local and VM tests).
+    pub allow_private: bool,
+}
+
+impl TurnConfig {
+    /// From hbbs's environment: on when `RELAY_HOST` is set, unless `TURN=0`.
+    pub fn from_env(port: u16) -> Option<Self> {
+        let var = |k: &str| std::env::var(k).ok().map(|v| v.trim().to_owned()).filter(|v| !v.is_empty());
+        if var("TURN").as_deref() == Some("0") {
+            return None;
+        }
+        Some(Self {
+            host: var("RELAY_HOST")?,
+            port,
+            public_ip: var("TURN_PUBLIC_IP").and_then(|v| v.parse().ok()),
+            max_allocations: var("TURN_MAX_ALLOCATIONS").and_then(|v| v.parse().ok()).unwrap_or(64),
+            bandwidth: var("TURN_BANDWIDTH_MBPS")
+                .and_then(|v| v.parse::<f64>().ok())
+                .map_or(4 << 20, |m| (m * 1024. * 1024. / 8.) as usize),
+            allow_private: var("TURN_ALLOW_PRIVATE_PEERS").as_deref() == Some("1"),
+        })
+    }
+}
+
+pub struct Turn {
+    cfg: TurnConfig,
+    secret: String,
+    public_ip: AtomicU32,
+    /// A duplicate of hbbs's UDP socket, for sending from the TURN tasks.
+    sock: Mutex<Option<Arc<UdpSocket>>>,
+    control: Tx,
+    clients: Mutex<HashMap<SocketAddr, Instant>>,
+    /// Peer address -> (allocation id, its queue).
+    peers: Mutex<HashMap<SocketAddr, (u64, Tx)>>,
+    live: AtomicUsize,
+    next_id: AtomicU64,
+    server: Mutex<Option<Server>>,
+    /// Unauthenticated TURN requests per second (see `dispatch`).
+    unauth: Mutex<Bucket>,
+}
+
+static TURN: once_cell::sync::OnceCell<Arc<Turn>> = once_cell::sync::OnceCell::new();
+
+/// The running TURN server, if hbbs started one.
+pub fn get() -> Option<&'static Arc<Turn>> {
+    TURN.get()
+}
+
+impl Turn {
+    /// Builds and starts the server; `set_socket` must follow before anything is relayed.
+    pub async fn start(cfg: TurnConfig) -> Result<Arc<Self>, turn::Error> {
+        let secret = hex(&sodiumoxide::randombytes::randombytes(32));
+        let (control, rx) = mpsc::channel(QUEUE);
+        let t = Arc::new(Self {
+            public_ip: AtomicU32::new(cfg.public_ip.map_or(0, u32::from)),
+            cfg,
+            secret: secret.clone(),
+            sock: Default::default(),
+            control,
+            clients: Default::default(),
+            peers: Default::default(),
+            live: AtomicUsize::new(0),
+            next_id: AtomicU64::new(1),
+            server: Default::default(),
+            unauth: Bucket::new(UNAUTH_PER_SEC),
+        });
+        let server = Server::new(ServerConfig {
+            conn_configs: vec![ConnConfig {
+                conn: Arc::new(ControlConn { turn: t.clone(), rx: tokio::sync::Mutex::new(rx) }),
+                relay_addr_generator: Box::new(Relays(t.clone())),
+            }],
+            realm: REALM.to_owned(),
+            auth_handler: Arc::new(RestAuth::new(secret)),
+            channel_bind_timeout: Duration::from_secs(600),
+            alloc_close_notify: None,
+        })
+        .await?;
+        *t.server.lock().unwrap() = Some(server);
+        if t.cfg.public_ip.is_none() {
+            let w = Arc::downgrade(&t);
+            tokio::spawn(async move {
+                while let Some(t) = w.upgrade() {
+                    match tokio::net::lookup_host((t.cfg.host.as_str(), 0)).await {
+                        Ok(mut a) => {
+                            if let Some(IpAddr::V4(ip)) = a.find(|a| a.is_ipv4()).map(|a| a.ip()) {
+                                if t.public_ip.swap(ip.into(), Ordering::SeqCst) != u32::from(ip) {
+                                    log::info!("TURN relay address {ip}");
+                                }
+                            }
+                        }
+                        Err(e) => log::warn!("TURN: cannot resolve {}: {e}", t.cfg.host),
+                    }
+                    drop(t);
+                    tokio::time::sleep(Duration::from_secs(60)).await;
+                }
+            });
+        }
+        log::info!(
+            "TURN on udp :{} for {} (max {} allocations, {} Mbit/s each){}",
+            t.cfg.port,
+            t.cfg.host,
+            t.cfg.max_allocations,
+            t.cfg.bandwidth * 8 / 1024 / 1024,
+            if t.cfg.allow_private { ", private peers allowed: lab only" } else { "" }
+        );
+        Ok(t)
+    }
+
+    /// Registers the process-wide instance used by `get`.
+    pub fn install(t: Arc<Self>) {
+        TURN.set(t).ok();
+    }
+
+    pub async fn close(&self) {
+        let server = self.server.lock().unwrap().take();
+        if let Some(s) = server {
+            s.close().await.ok();
+        }
+    }
+
+    /// hbbs's UDP socket (again after hbbs re-created it).
+    pub fn set_socket(&self, sock: &UdpSocket) {
+        let dup = socket2::SockRef::from(sock).try_clone().and_then(|s| {
+            let s: std::net::UdpSocket = s.into();
+            s.set_nonblocking(true)?;
+            UdpSocket::from_std(s)
+        });
+        match dup {
+            Ok(s) => *self.sock.lock().unwrap() = Some(Arc::new(s)),
+            Err(e) => log::error!("TURN: cannot share the UDP socket: {e}"),
+        }
+    }
+
+    fn public_ip(&self) -> Option<Ipv4Addr> {
+        Some(Ipv4Addr::from(self.public_ip.load(Ordering::SeqCst))).filter(|ip| !ip.is_unspecified())
+    }
+
+    /// A `turn://` URL with a fresh credential, or empty while the relay address is unknown.
+    pub fn url(&self, tag: &str) -> String {
+        if self.public_ip().is_none() || self.sock.lock().unwrap().is_none() {
+            return String::new();
+        }
+        let tag: String = tag.chars().filter(|c| c.is_ascii_alphanumeric()).take(32).collect();
+        turn_url(&self.cfg.host, self.cfg.port, &self.secret, &tag)
+    }
+
+    fn allowed(&self, peer: SocketAddr) -> bool {
+        let ip = v4(peer).ip();
+        // Lab mode (all on one machine) also allows the relay's own address.
+        self.cfg.allow_private || (Some(ip) != self.public_ip().map(IpAddr::V4) && !forbidden_peer(ip))
+    }
+
+    /// Takes the datagram if it is TURN's; `false` leaves it to hbbs.
+    pub fn dispatch(&self, b: &[u8], from: SocketAddr) -> bool {
+        let from = v4(from);
+        let to_control = match stun_method(b) {
+            // The TURN crate keeps every nonce it hands out for an hour; unauthenticated requests
+            // (each gets one) are capped so a flood cannot grow that map without bound.
+            Some(3) | Some(4) | Some(8) | Some(9) if !has_integrity(b) && !self.unauth.lock().unwrap().take(1) => {
+                return true;
+            }
+            Some(3) | Some(4) | Some(6) | Some(8) | Some(9) => {
+                let mut c = self.clients.lock().unwrap();
+                if c.len() > 10_000 {
+                    c.retain(|_, at| at.elapsed() < Duration::from_secs(900));
+                }
+                if c.len() < 10_000 {
+                    c.insert(from, Instant::now());
+                }
+                true
+            }
+            _ => is_channel_data(b) && self.clients.lock().unwrap().contains_key(&from),
+        };
+        if to_control {
+            if self.control.try_send((b.to_vec(), from)).is_err() {
+                log::debug!("TURN control queue full, dropped");
+            }
+            return true;
+        }
+        let peers = self.peers.lock().unwrap();
+        let tx = peers.get(&from).map(|p| &p.1).or_else(|| {
+            // A peer behind a NAT that maps per destination answers from a port the allocation
+            // has not sent to yet; take it when exactly one allocation knows that address.
+            let mut same_ip = peers.iter().filter(|(a, _)| a.ip() == from.ip());
+            let first = same_ip.next()?;
+            if same_ip.all(|(_, p)| p.0 == (first.1).0) {
+                Some(&(first.1).1)
+            } else {
+                None
+            }
+        });
+        match tx {
+            Some(tx) => {
+                tx.try_send((b.to_vec(), from)).ok();
+                true
+            }
+            None => false,
+        }
+    }
+
+    async fn send_to(&self, b: &[u8], to: SocketAddr) -> std::io::Result<usize> {
+        let sock = self.sock.lock().unwrap().clone();
+        let Some(sock) = sock else { return Ok(b.len()) };
+        let to = match (sock.local_addr()?, to) {
+            (SocketAddr::V6(_), SocketAddr::V4(a)) => SocketAddr::new(IpAddr::V6(a.ip().to_ipv6_mapped()), a.port()),
+            _ => to,
+        };
+        sock.send_to(b, to).await
+    }
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+fn unsupported<T>() -> webrtc_util::Result<T> {
+    Err(webrtc_util::Error::Other("not supported".into()))
+}
+
+/// The TURN server's listener: what `dispatch` routed to it, answers out of hbbs's socket.
+struct ControlConn {
+    turn: Arc<Turn>,
+    rx: Rx,
+}
+
+#[async_trait]
+impl Conn for ControlConn {
+    async fn connect(&self, _: SocketAddr) -> webrtc_util::Result<()> {
+        unsupported()
+    }
+    async fn recv(&self, _: &mut [u8]) -> webrtc_util::Result<usize> {
+        unsupported()
+    }
+    async fn recv_from(&self, buf: &mut [u8]) -> webrtc_util::Result<(usize, SocketAddr)> {
+        match self.rx.lock().await.recv().await {
+            Some((b, from)) => {
+                let n = b.len().min(buf.len());
+                buf[..n].copy_from_slice(&b[..n]);
+                Ok((n, from))
+            }
+            None => Err(webrtc_util::Error::Other("closed".into())),
+        }
+    }
+    async fn send(&self, _: &[u8]) -> webrtc_util::Result<usize> {
+        unsupported()
+    }
+    async fn send_to(&self, b: &[u8], to: SocketAddr) -> webrtc_util::Result<usize> {
+        Ok(self.turn.send_to(b, to).await?)
+    }
+    fn local_addr(&self) -> webrtc_util::Result<SocketAddr> {
+        Ok(SocketAddr::new(IpAddr::V4(self.turn.public_ip().unwrap_or(Ipv4Addr::UNSPECIFIED)), self.turn.cfg.port))
+    }
+    fn remote_addr(&self) -> Option<SocketAddr> {
+        None
+    }
+    async fn close(&self) -> webrtc_util::Result<()> {
+        Ok(())
+    }
+    fn as_any(&self) -> &(dyn std::any::Any + Send + Sync) {
+        self
+    }
+}
+
+/// One allocation's relayed side: sends out of hbbs's socket, receives what `dispatch` routes
+/// to it, with the peer filter, peer cap and bandwidth cap applied.
+struct RelayConn {
+    id: u64,
+    turn: Arc<Turn>,
+    tx: Tx,
+    rx: Rx,
+    send: Mutex<Bucket>,
+    recv: Mutex<Bucket>,
+    closed: AtomicBool,
+}
+
+impl RelayConn {
+    fn release(&self) {
+        if !self.closed.swap(true, Ordering::SeqCst) {
+            self.turn.live.fetch_sub(1, Ordering::SeqCst);
+            self.turn.peers.lock().unwrap().retain(|_, p| p.0 != self.id);
+        }
+    }
+}
+
+impl Drop for RelayConn {
+    fn drop(&mut self) {
+        self.release();
+    }
+}
+
+#[async_trait]
+impl Conn for RelayConn {
+    async fn connect(&self, _: SocketAddr) -> webrtc_util::Result<()> {
+        unsupported()
+    }
+    async fn recv(&self, _: &mut [u8]) -> webrtc_util::Result<usize> {
+        unsupported()
+    }
+    async fn recv_from(&self, buf: &mut [u8]) -> webrtc_util::Result<(usize, SocketAddr)> {
+        loop {
+            let Some((b, from)) = self.rx.lock().await.recv().await else {
+                return Err(webrtc_util::Error::Other("closed".into()));
+            };
+            if self.turn.allowed(from) && self.recv.lock().unwrap().take(b.len()) {
+                let n = b.len().min(buf.len());
+                buf[..n].copy_from_slice(&b[..n]);
+                return Ok((n, from));
+            }
+        }
+    }
+    async fn send(&self, _: &[u8]) -> webrtc_util::Result<usize> {
+        unsupported()
+    }
+    async fn send_to(&self, b: &[u8], to: SocketAddr) -> webrtc_util::Result<usize> {
+        let to = v4(to);
+        if self.closed.load(Ordering::SeqCst) || !self.turn.allowed(to) {
+            return Ok(b.len()); // dropped like any lost datagram
+        }
+        {
+            let mut peers = self.turn.peers.lock().unwrap();
+            if !peers.contains_key(&to) {
+                if peers.values().filter(|p| p.0 == self.id).count() >= MAX_PEERS {
+                    return Ok(b.len());
+                }
+                peers.insert(to, (self.id, self.tx.clone()));
+            }
+        }
+        if !self.send.lock().unwrap().take(b.len()) {
+            return Ok(b.len());
+        }
+        Ok(self.turn.send_to(b, to).await?)
+    }
+    fn local_addr(&self) -> webrtc_util::Result<SocketAddr> {
+        Ok(SocketAddr::new(IpAddr::V4(self.turn.public_ip().unwrap_or(Ipv4Addr::UNSPECIFIED)), self.turn.cfg.port))
+    }
+    fn remote_addr(&self) -> Option<SocketAddr> {
+        None
+    }
+    async fn close(&self) -> webrtc_util::Result<()> {
+        self.release();
+        Ok(())
+    }
+    fn as_any(&self) -> &(dyn std::any::Any + Send + Sync) {
+        self
+    }
+}
+
+struct Relays(Arc<Turn>);
+
+#[async_trait]
+impl RelayAddressGenerator for Relays {
+    fn validate(&self) -> Result<(), turn::Error> {
+        Ok(())
+    }
+
+    async fn allocate_conn(
+        &self,
+        use_ipv4: bool,
+        _requested_port: u16,
+    ) -> Result<(Arc<dyn Conn + Send + Sync>, SocketAddr), turn::Error> {
+        let t = &self.0;
+        let Some(ip) = t.public_ip().filter(|_| use_ipv4) else {
+            return Err(turn::Error::Other("IPv4 relays only".into()));
+        };
+        if t.live.fetch_add(1, Ordering::SeqCst) >= t.cfg.max_allocations {
+            t.live.fetch_sub(1, Ordering::SeqCst);
+            log::warn!("TURN allocation refused: {} allocations open", t.cfg.max_allocations);
+            return Err(turn::Error::Other("allocation limit".into()));
+        }
+        let (tx, rx) = mpsc::channel(QUEUE);
+        let conn = RelayConn {
+            id: t.next_id.fetch_add(1, Ordering::SeqCst),
+            turn: t.clone(),
+            tx,
+            rx: tokio::sync::Mutex::new(rx),
+            send: Bucket::new(t.cfg.bandwidth),
+            recv: Bucket::new(t.cfg.bandwidth),
+            closed: Default::default(),
+        };
+        Ok((Arc::new(conn), SocketAddr::new(IpAddr::V4(ip), t.cfg.port)))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn peers_filtered() {
+        for a in [
+            "10.0.0.5", "172.16.1.1", "192.168.1.1", "127.0.0.1", "169.254.169.254", "100.64.0.1",
+            "0.0.0.0", "255.255.255.255", "224.0.0.1", "240.0.0.1", "::1", "fe80::1", "fd00::1",
+            "::ffff:10.0.0.1", "::ffff:127.0.0.1", "::ffff:169.254.169.254", "64:ff9b::a00:1", "2002:a00:1::",
+            "::a00:1", "198.18.0.1",
+        ] {
+            assert!(forbidden_peer(a.parse().unwrap()), "{a}");
+        }
+        for a in ["8.8.8.8", "92.5.231.71", "2a01:4f8::1", "::ffff:8.8.8.8", "100.128.0.1"] {
+            assert!(!forbidden_peer(a.parse().unwrap()), "{a}");
+        }
+    }
+
+    #[test]
+    fn rest_credentials() {
+        let auth = RestAuth::new("0123456789abcdef".into());
+        let a: SocketAddr = "203.0.113.7:4000".parse().unwrap();
+        let b: SocketAddr = "203.0.113.8:4000".parse().unwrap();
+        let (u, p) = credential("0123456789abcdef", "s1", 1000);
+        assert_eq!(auth.check(&u, a, 1000).unwrap(), p);
+        assert_ne!(credential("fedcba9876543210", "s1", 1000).1, p);
+        // after expiry: the first client keeps refreshing, nobody else gets in
+        assert!(auth.check(&u, a, 1000 + CREDENTIAL_TTL + 10).is_ok());
+        assert!(auth.check(&u, b, 1000 + CREDENTIAL_TTL + 10).is_err());
+        assert!(auth.check(&u, a, 1000 + CREDENTIAL_TTL + SESSION_MAX + 1).is_err());
+        // a second socket inside the validity window is accepted (same session)
+        assert!(auth.check(&u, b, 1001).is_ok());
+        assert!(auth.check("nonsense", a, 1000).is_err());
+        assert!(auth.check(&format!("{}:x", 1000 + 86400), a, 1000).is_err());
+    }
+
+    #[test]
+    fn url_and_framing() {
+        let url = turn_url("tether-desk.duckdns.org", 21116, "0123456789abcdef", "123456789");
+        let userinfo = &url["turn://".len()..url.rfind('@').unwrap()];
+        assert!(url.ends_with("@tether-desk.duckdns.org:21116"), "{url}");
+        assert_eq!(userinfo.matches(':').count(), 1, "{url}");
+        assert!(!userinfo.contains(['+', '/', '=']), "{url}");
+        // Allocate request header; a rendezvous protobuf whose first byte looks like ChannelData.
+        let mut alloc = vec![0x00, 0x03, 0x00, 0x00, 0x21, 0x12, 0xA4, 0x42];
+        alloc.extend([0u8; 12]);
+        assert_eq!(stun_method(&alloc), Some(3));
+        assert_eq!(stun_method(&[0x0a, 0x02, 0x08, 0x01]), None);
+        assert!(is_channel_data(&[0x40, 0x00, 0x00, 0x02, 1, 2, 0, 0]));
+        assert!(!is_channel_data(&[0x42, 0x10, 0x0a, 0x0e, 1, 2]));
+        assert!(!has_integrity(&alloc));
+        let mut signed = alloc.clone();
+        signed.extend([0x00, 0x19, 0x00, 0x04, 17, 0, 0, 0, 0x00, 0x08, 0x00, 0x14]);
+        signed.extend([0u8; 20]);
+        assert!(has_integrity(&signed));
+    }
+
+    async fn roundtrip(allow_private: bool) -> bool {
+        let hbbs = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let port = hbbs.local_addr().unwrap().port();
+        let t = Turn::start(TurnConfig {
+            host: "127.0.0.1".into(),
+            port,
+            public_ip: Some(Ipv4Addr::LOCALHOST),
+            max_allocations: 2,
+            bandwidth: 1 << 20,
+            allow_private,
+        })
+        .await
+        .unwrap();
+        t.set_socket(&hbbs);
+        // hbbs's loop: TURN first, the rest would be rendezvous.
+        let t2 = t.clone();
+        let hbbs_loop = tokio::spawn(async move {
+            let mut buf = vec![0u8; 2048];
+            loop {
+                let (n, from) = hbbs.recv_from(&mut buf).await.unwrap();
+                t2.dispatch(&buf[..n], from);
+            }
+        });
+        let url = t.url("t");
+        let userinfo = url["turn://".len()..].rsplit_once('@').unwrap().0;
+        let (user, pass) = userinfo.split_once(':').unwrap();
+        let (user, pass) = (percent_decode(user), percent_decode(pass));
+        let client = turn::client::Client::new(turn::client::ClientConfig {
+            stun_serv_addr: format!("127.0.0.1:{port}"),
+            turn_serv_addr: format!("127.0.0.1:{port}"),
+            username: user,
+            password: pass,
+            realm: REALM.to_owned(),
+            software: String::new(),
+            rto_in_ms: 0,
+            conn: Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap()),
+            vnet: None,
+        })
+        .await
+        .unwrap();
+        client.listen().await.unwrap();
+        let relay = client.allocate().await.unwrap();
+        assert_eq!(relay.local_addr().unwrap().port(), port);
+        assert_eq!(t.live.load(Ordering::SeqCst), 1);
+        let peer = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        relay.send_to(b"hi", peer.local_addr().unwrap()).await.unwrap();
+        let mut buf = [0u8; 64];
+        let got = tokio::time::timeout(Duration::from_millis(500), peer.recv_from(&mut buf)).await;
+        let ok = matches!(got, Ok(Ok((2, from))) if from.port() == port);
+        if ok {
+            for _ in 0..3 {
+                peer.send_to(b"back", ("127.0.0.1", port)).await.unwrap();
+            }
+            let (n, _) = tokio::time::timeout(Duration::from_secs(1), relay.recv_from(&mut buf)).await.unwrap().unwrap();
+            assert_eq!(&buf[..n], b"back");
+        }
+        relay.close().await.unwrap();
+        client.close().await.unwrap();
+        t.close().await;
+        hbbs_loop.abort();
+        ok
+    }
+
+    fn percent_decode(s: &str) -> String {
+        let b = s.as_bytes();
+        let mut out = Vec::new();
+        let mut i = 0;
+        while i < b.len() {
+            if b[i] == b'%' {
+                out.push(u8::from_str_radix(&s[i + 1..i + 3], 16).unwrap());
+                i += 3;
+            } else {
+                out.push(b[i]);
+                i += 1;
+            }
+        }
+        String::from_utf8(out).unwrap()
+    }
+
+    #[tokio::test(flavor = "multi_thread")]
+    async fn relays_on_the_shared_port_only_where_allowed() {
+        assert!(roundtrip(true).await, "lab mode relays to 127.0.0.1");
+        assert!(!roundtrip(false).await, "a loopback peer must be refused");
+    }
+}
