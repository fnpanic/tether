+
+fn parse_keys_accept(v: &str) -> Vec<String> {
+    v.split(',')
+        .map(str::trim)
+        .filter(|k| !k.is_empty())
+        .filter(|k| {
+            let ok = base64::decode(k).map_or(false, |b| b.len() == sign::PUBLICKEYBYTES);
+            if !ok {
+                log::error!("KEYS_ACCEPT: ignoring {:.8}…, not a base64 Ed25519 public key", k);
+            }
+            ok
+        })
+        .map(str::to_owned)
+        .collect()
+}
