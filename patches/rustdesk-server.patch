+}
+/// Set on SIGTERM: the process reports not-ready and finishes what it has (Tether HA).
+static DRAIN_STARTED: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+
+pub fn is_draining() -> bool {
+    DRAIN_STARTED.get().is_some()
+}
+
+/// How long ago draining started, if it has.
+pub fn draining_for() -> Option<std::time::Duration> {
+    DRAIN_STARTED.get().map(|t| t.elapsed())
+}
+
+/// Waits for SIGTERM/SIGINT, then drains: report not-ready at once and keep serving until
+/// `idle()` or DRAIN_TIMEOUT seconds pass (default 0: stop at once). A second signal stops now.
+pub async fn listen_signal_and_drain(idle: fn() -> bool) -> Result<()> {
+    listen_signal().await?;
+    DRAIN_STARTED.get_or_init(Instant::now);
+    let secs: u64 = std::env::var("DRAIN_TIMEOUT").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+    if secs == 0 {
+        return Ok(());
+    }
+    log::info!("draining: not ready, waiting up to {secs}s for open sessions to end");
+    tokio::select! {
+        _ = async { while !idle() { tokio::time::sleep(std::time::Duration::from_millis(200)).await } } => {
+            log::info!("drained");
+        }
+        _ = tokio::time::sleep(std::time::Duration::from_secs(secs)) => {
+            log::info!("drain timeout, closing remaining sessions");
+        }
+        _ = listen_signal() => {
+            log::info!("second signal, stopping now");
+        }
+    }
+    Ok(())
+}
+
+/// Plain HTTP health endpoint on HEALTH_PORT (default `default_port`, 0 = off), for Kubernetes
+/// probes and for hbbs checking its relays: `/healthz` is 200 while the process runs, `/readyz`
+/// is 200 `ready sessions=N` or 503 `draining sessions=N`.
+pub async fn serve_health(default_port: u16, sessions: fn() -> usize) {
+    let port: u16 = std::env::var("HEALTH_PORT").ok().and_then(|v| v.parse().ok()).unwrap_or(default_port);
+    if port == 0 {
+        return;
+    }
+    let listener = match hbb_common::tokio::net::TcpListener::bind(("0.0.0.0", port)).await {
+        Ok(l) => l,
+        Err(err) => {
+            log::error!("health endpoint on :{port} failed: {err}");
+            return;
+        }
+    };
+    log::info!("Health endpoint on http :{port} (/healthz, /readyz)");
+    while let Ok((mut stream, _)) = listener.accept().await {
+        tokio::spawn(async move {
+            use hbb_common::tokio::io::{AsyncReadExt, AsyncWriteExt};
+            let mut buf = [0u8; 1024];
+            let n = match hbb_common::timeout(2_000, stream.read(&mut buf)).await {
+                Ok(Ok(n)) => n,
+                _ => return,
+            };
+            let req = String::from_utf8_lossy(&buf[..n]);
+            let path = req.split_whitespace().nth(1).unwrap_or("");
+            let (code, body) = health_response(path, is_draining(), sessions());
+            let res = format!(
+                "HTTP/1.1 {code}\r\nContent-Type: text/plain\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                body.len()
+            );
+            stream.write_all(res.as_bytes()).await.ok();
+        });
+    }
+}
+
+fn health_response(path: &str, draining: bool, sessions: usize) -> (&'static str, String) {
+    match path.split('?').next().unwrap_or("") {
+        "/healthz" => ("200 OK", "ok\n".to_owned()),
+        "/readyz" if draining => ("503 Service Unavailable", format!("draining sessions={sessions}\n")),
+        "/readyz" => ("200 OK", format!("ready sessions={sessions}\n")),
+        _ => ("404 Not Found", "not found\n".to_owned()),
+    }
+}
+
+#[cfg(test)]
+mod health_tests {
+    use super::health_response;
+
+    #[test]
+    fn readyz_reflects_drain_and_load() {
+        assert_eq!(health_response("/readyz", false, 3), ("200 OK", "ready sessions=3\n".to_owned()));
+        assert_eq!(health_response("/readyz", true, 1).0, "503 Service Unavailable");
+        assert_eq!(health_response("/healthz", true, 0).0, "200 OK");
+        assert_eq!(health_response("/x", false, 0).0, "404 Not Found");
+    }
+}
