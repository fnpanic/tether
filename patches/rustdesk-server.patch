+    /// A TCP/WebSocket host is online while its connection lives: refresh what the UDP path
+    /// refreshes on every RegisterPeer.
+    async fn touch_tcp_peer(pm: &PeerMap, id: &str, addr: SocketAddr) {
+        if let Some(peer) = pm.get_in_memory(id).await {
+            let mut peer = peer.write().await;
+            peer.socket_addr = addr;
+            peer.last_reg_time = Instant::now();
+        }
+    }
