+        let t = lab_turn_max(64).await;
+        let relays = Relays(t.clone());
+        let (a, b): (IpAddr, IpAddr) = ("198.51.100.60".parse().unwrap(), "198.51.100.61".parse().unwrap());
+        *t.handling.lock().unwrap() = a;
+        let mut conns = Vec::new();
+        for _ in 0..t.cfg.max_allocations_per_ip {
+            conns.push(relays.allocate_conn(true, 0).await.unwrap().0);
+        }
+        assert!(relays.allocate_conn(true, 0).await.is_err(), "one client IP took more than its share");
+        assert_eq!(t.live.load(Ordering::SeqCst), t.cfg.max_allocations_per_ip);
+        // Another client IP is not affected, and an allocation that ends makes room again.
+        *t.handling.lock().unwrap() = b;
+        let other = relays.allocate_conn(true, 0).await.unwrap().0;
+        *t.handling.lock().unwrap() = a;
+        conns.pop().unwrap().close().await.unwrap();
+        conns.push(relays.allocate_conn(true, 0).await.unwrap().0);
+        drop((conns, other));
+        assert!(t.per_ip.lock().unwrap().is_empty());
+        t.close().await;
+    }
+
+    #[test]
+    fn unverified_request_does_not_claim_a_credential() {
+        let auth = RestAuth::new("0123456789abcdef".into());
+        let a: SocketAddr = "203.0.113.7:4000".parse().unwrap();
+        let (u, _) = credential("0123456789abcdef", "s1", 1000);
+        // The password lookup happens before MESSAGE-INTEGRITY is checked: it must not record `a`.
+        assert!(auth.check(&u, a, 1000).is_ok());
+        assert!(auth.check(&u, a, 1000 + CREDENTIAL_TTL + 10).is_err());
+    }
+
+    #[tokio::test(flavor = "multi_thread")]
+    async fn relays_on_the_shared_port_only_where_allowed() {
+        assert!(roundtrip(true).await, "lab mode relays to 127.0.0.1");
+        assert!(!roundtrip(false).await, "a loopback peer must be refused");
+    }
+}
