+/// Tether: the `/metrics` page (crate::metrics) with the values read at scrape time.
+async fn render_metrics(pm: &PeerMap) -> String {
+    let (peers_online, peers_in_memory) = pm.count_online(REG_TIMEOUT as u128).await;
+    let tcp_signalling = TCP_PEERS.lock().await.len();
+    let turn = crate::turn::get();
+    crate::metrics::render_hbbs(&crate::metrics::HbbsNow {
+        peers_online,
+        peers_in_memory,
+        tcp_signalling,
+        turn_enabled: turn.is_some(),
+        turn_open: turn.map_or(0, |t| t.open_allocations()),
+        turn_max: turn.map_or(0, |t| t.max_allocations()),
+    })
+}
