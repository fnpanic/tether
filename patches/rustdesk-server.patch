+#[cfg(test)]
+mod norm_ip_tests {
+    use super::norm_ip;
+
+    #[test]
+    fn mapped_v4_equals_plain_v4() {
+        assert_eq!(norm_ip("::ffff:91.41.2.18"), "91.41.2.18");
+        assert_eq!(norm_ip("91.41.2.18"), "91.41.2.18");
+        assert_eq!(norm_ip("2001:db8::1"), "2001:db8::1");
+        assert_eq!(norm_ip("not-an-ip"), "not-an-ip");
+    }
