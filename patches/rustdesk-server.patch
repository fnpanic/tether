+    use super::*;
+
+    #[test]
+    fn entries_and_load() {
+        let url = Some("https://a.example/readyz/relay");
+        assert_eq!(relay_entry("a.example"), ("a.example", None, false));
+        assert_eq!(relay_entry("a.example:21117"), ("a.example:21117", None, false));
+        assert_eq!(relay_entry("a.example|https://a.example/readyz/relay"), ("a.example", url, false));
+        assert_eq!(relay_entry(" a.example | https://a.example/readyz/relay |backup"), ("a.example", url, true));
+        assert_eq!(relay_entry("a.example:21117|backup"), ("a.example:21117", None, true));
+        assert_eq!(relay_entry("a.example|BACKUP"), ("a.example", None, true));
+        let ws = "wss://k8s.example/ws/relay/1";
+        assert_eq!(relay_entry(ws), (ws, None, false));
+        assert_eq!(relay_entry("wss://k8s.example/ws/relay/1|backup"), (ws, None, true));
+        assert_eq!(
+            relay_entry("ws://10.0.0.1:21119/r|http://10.0.0.1:21121/readyz|backup"),
+            ("ws://10.0.0.1:21119/r", Some("http://10.0.0.1:21121/readyz"), true)
+        );
+        assert_eq!(parse_sessions("ready sessions=7\n"), 7);
+        assert_eq!(parse_sessions("Tether relay"), 0);
+    }
+
+    #[test]
+    fn least_loaded_then_rotation() {
+        let rs = vec![r("a", 2, false), r("b", 0, false), r("c", 0, false)];
+        assert_eq!(pick_relay(&rs, 0), "b");
+        assert_eq!(pick_relay(&rs, 1), "c");
+        assert_eq!(pick_relay(&rs, 2), "b");
+        assert_eq!(pick_relay(&[], 0), "");
+    }
+
+    fn r(a: &str, n: usize, backup: bool) -> (String, usize, bool) {
+        (a.to_owned(), n, backup)
+    }
+
+    #[test]
+    fn primary_before_backup() {
+        // Primary wins even when more loaded; rotation stays among equally loaded primaries.
+        let rs = vec![r("p1", 5, false), r("p2", 5, false), r("o1", 0, true), r("o2", 0, true)];
+        assert_eq!(pick_relay(&rs, 0), "p1");
+        assert_eq!(pick_relay(&rs, 1), "p2");
+        assert_eq!(pick_relay(&rs, 2), "p1");
