+
+/// Open sessions from a relay's `/readyz` body (`ready sessions=N`); 0 if it does not say.
+fn parse_sessions(body: &str) -> usize {
+    body.split_whitespace()
+        .find_map(|w| w.strip_prefix("sessions=")?.parse().ok())
+        .unwrap_or(0)
+}
+
+/// The least loaded healthy primary relay, or backup relay when no primary is healthy;
+/// `rotation` spreads new sessions over equally loaded ones.
+// shortcut: load is sampled every 3 s, so a burst inside one interval goes to the same relay;
+// count handed-out sessions locally if bursts matter.
+fn pick_relay(relays: &[(String, usize, bool)], rotation: usize) -> String {
+    let backup = !has_primary(relays);
+    let pool: Vec<_> = relays.iter().filter(|r| r.2 == backup).collect();
+    let Some(min) = pool.iter().map(|r| r.1).min() else {
+        return "".to_owned();
+    };
+    let best: Vec<&String> = pool.iter().filter(|r| r.1 == min).map(|r| &r.0).collect();
+    best[rotation % best.len()].clone()
+}
+
+/// Canonical text form of an IP: IPv4-mapped IPv6 (`::ffff:a.b.c.d`) becomes `a.b.c.d`.
+fn norm_ip(ip: &str) -> String {
+    match ip.parse::<std::net::IpAddr>() {
+        Ok(std::net::IpAddr::V6(v6)) => match v6.to_ipv4_mapped() {
+            Some(v4) => v4.to_string(),
+            None => v6.to_string(),
+        },
+        Ok(v4) => v4.to_string(),
+        Err(_) => ip.to_owned(),
+    }
+}
