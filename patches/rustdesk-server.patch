+    /// RegisterPk handling shared by UDP and TCP/WebSocket clients. None = ignore the request.
+    async fn register_pk(&mut self, rk: RegisterPk, addr: SocketAddr) -> Option<RendezvousMessage> {
+        if rk.uuid.is_empty() || rk.pk.is_empty() {
+            return None;
+        }
+        let id = rk.id;
+        // One canonical form per address: UDP sees IPv4 clients as ::ffff:a.b.c.d, the WebSocket
+        // path (X-Forwarded-For) as a.b.c.d. Unnormalised, a host moving between them looks like
+        // an ip+key change and is rejected.
