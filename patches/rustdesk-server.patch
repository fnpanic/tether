+//! Tether: Prometheus metrics of hbbs and hbbr (text exposition format 0.0.4), served on
+//! `METRICS_ADDR`:`METRICS_PORT` (default 127.0.0.1, hbbs 21123, hbbr 21124; port 0 = off).
+//! Labels come from fixed sets only (no peer IDs, IPs or keys); the one exception is the relay
+//! name, which comes from hbbs's own `-r` list (bounded by MAX_RELAYS). docs/monitoring.md.
+#![allow(dead_code)] // one module for both binaries; each uses its half
+
+use std::fmt::Write as _;
+use std::sync::atomic::{AtomicI64, AtomicU64, Ordering::Relaxed};
+use std::sync::Mutex;
+
+pub struct Counter(AtomicU64);
+
+impl Counter {
+    pub const fn new() -> Self {
+        Self(AtomicU64::new(0))
+    }
+    pub fn inc(&self) {
+        self.0.fetch_add(1, Relaxed);
+    }
+    pub fn add(&self, n: u64) {
+        self.0.fetch_add(n, Relaxed);
+    }
+    pub fn get(&self) -> u64 {
+        self.0.load(Relaxed)
+    }
+}
+
+pub struct Gauge(AtomicI64);
+
+impl Gauge {
+    pub const fn new() -> Self {
+        Self(AtomicI64::new(0))
+    }
+    pub fn inc(&self) {
+        self.0.fetch_add(1, Relaxed);
+    }
+    pub fn dec(&self) {
+        self.0.fetch_sub(1, Relaxed);
+    }
+    pub fn set(&self, v: i64) {
+        self.0.store(v, Relaxed);
+    }
+    pub fn get(&self) -> i64 {
+        self.0.load(Relaxed)
+    }
+}
+
+/// Decrements a gauge when dropped (open connections, sessions).
+pub struct Open(&'static Gauge);
+
+impl Open {
+    pub fn new(g: &'static Gauge) -> Self {
+        g.inc();
+        Self(g)
+    }
+}
+
+impl Drop for Open {
+    fn drop(&mut self) {
+        self.0.dec();
+    }
+}
+
+// ---- hbbs ----
+
+pub const TRANSPORTS: [&str; 3] = ["udp", "tcp", "ws"];
+pub fn transport(ws: bool) -> usize {
+    if ws { 2 } else { 1 }
+}
+/// RegisterPeer messages by transport (TRANSPORTS).
+pub static REGISTER_PEER: [Counter; 3] = [Counter::new(), Counter::new(), Counter::new()];
+/// Open TCP / WebSocket connections to hbbs's rendezvous ports (index transport()).
+pub static CONNECTIONS: [Gauge; 3] = [Gauge::new(), Gauge::new(), Gauge::new()];
+/// RegisterPk answers by register_pk_response::Result value (0..=8; 1 is unused).
+pub static REGISTER_PK: [Counter; 9] = [
+    Counter::new(), Counter::new(), Counter::new(), Counter::new(), Counter::new(),
+    Counter::new(), Counter::new(), Counter::new(), Counter::new(),
+];
+const REGISTER_PK_RESULTS: [&str; 9] = [
+    "ok", "1", "uuid_mismatch", "id_exists", "too_frequent", "invalid_id_format", "not_support", "server_error", "not_deployed",
+];
+pub fn register_pk(result: i32) {
+    if let Some(c) = REGISTER_PK.get(result as usize) {
+        c.inc();
+    }
+}
+
+pub const PUNCH_OK: usize = 0;
+pub const PUNCH_LAN: usize = 1;
+pub const PUNCH_OFFLINE: usize = 2;
+pub const PUNCH_NOT_EXIST: usize = 3;
+pub const PUNCH_KEY_MISMATCH: usize = 4;
+const PUNCH_RESULTS: [&str; 5] = ["ok", "lan", "offline", "id_not_exist", "key_mismatch"];
+/// PunchHoleRequest outcomes.
+pub static PUNCH: [Counter; 5] = [Counter::new(), Counter::new(), Counter::new(), Counter::new(), Counter::new()];
+/// RegisterPk refused by the per-IP brute-force guard: [too many requests, too many IDs].
+pub static IP_BLOCKED: [Counter; 2] = [Counter::new(), Counter::new()];
+
+/// 1 while hbbs hands out backup relays because no primary is healthy.
+pub static FAILOVER: Gauge = Gauge::new();
+/// Failover transitions: [to backup, back to primary].
+pub static FAILOVER_TRANSITIONS: [Counter; 2] = [Counter::new(), Counter::new()];
+pub static RELAY_CHECKS: Counter = Counter::new();
+
+pub const MAX_RELAYS: usize = 16;
+
+#[derive(Default, Clone)]
+struct Relay {
+    name: String,
+    backup: bool,
+    healthy: bool,
+    sessions: usize,
+    assigned: u64,
+}
+
+static RELAYS: Mutex<Vec<Relay>> = Mutex::new(Vec::new());
+
+fn relay_slot<'a>(v: &'a mut Vec<Relay>, name: &str) -> Option<&'a mut Relay> {
+    if let Some(i) = v.iter().position(|r| r.name == name) {
+        return v.get_mut(i);
+    }
+    if v.len() >= MAX_RELAYS {
+        return None;
+    }
+    v.push(Relay { name: name.to_owned(), ..Default::default() });
+    v.last_mut()
+}
+
+/// Result of one health round: every configured relay (address, backup) and the healthy ones
+/// (address, open sessions, backup).
+pub fn relay_check(all: &[(String, bool)], healthy: &[(String, usize, bool)]) {
+    RELAY_CHECKS.inc();
+    let mut v = RELAYS.lock().unwrap_or_else(|e| e.into_inner());
+    for (name, backup) in all {
+        if let Some(r) = relay_slot(&mut v, name) {
+            let h = healthy.iter().find(|h| &h.0 == name);
+            r.backup = *backup;
+            r.healthy = h.is_some();
+            r.sessions = h.map_or(0, |h| h.1);
+        }
+    }
+}
+
+/// A relay handed out to a pair of peers ("" = none available).
+pub fn relay_assigned(name: &str) {
+    let mut v = RELAYS.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(r) = relay_slot(&mut v, if name.is_empty() { "none" } else { name }) {
+        r.assigned += 1;
+    }
+}
+
+pub fn failover(using_backup: bool) {
+    if (FAILOVER.get() == 1) != using_backup {
+        FAILOVER_TRANSITIONS[if using_backup { 0 } else { 1 }].inc();
+    }
+    FAILOVER.set(using_backup as i64);
+}
+
+pub static TURN_ALLOCATIONS: Counter = Counter::new();
+pub static TURN_ALLOCATIONS_REFUSED: Counter = Counter::new();
+/// TURN control requests (Allocate, Refresh, CreatePermission, ChannelBind, Send, ChannelData).
+pub static TURN_REQUESTS: Counter = Counter::new();
+/// Unauthenticated TURN requests dropped by the rate limit.
+pub static TURN_UNAUTH_DROPPED: Counter = Counter::new();
+pub static TURN_QUEUE_DROPPED: Counter = Counter::new();
+/// Datagrams dropped by an allocation's bandwidth cap: [to peer, from peer].
+pub static TURN_BANDWIDTH_DROPPED: [Counter; 2] = [Counter::new(), Counter::new()];
+/// Relayed bytes: [to peer, from peer].
+pub static TURN_BYTES: [Counter; 2] = [Counter::new(), Counter::new()];
+
+/// Values hbbs reads at scrape time.
+pub struct HbbsNow {
+    pub peers_online: usize,
+    pub peers_in_memory: usize,
+    pub tcp_signalling: usize,
+    pub turn_enabled: bool,
+    pub turn_open: usize,
+    pub turn_max: usize,
+}
+
+/// Tether release push (docs/update-design.md): G read from tether-api's `release-generation`.
+pub static RELEASE_GENERATION: Gauge = Gauge::new();
+/// ReleaseHint frames sent: [0] after a change of G, [1] right after a host registered.
+pub static RELEASE_HINTS: [Counter; 2] = [Counter::new(), Counter::new()];
+/// Registered WebSocket hosts that got the current G (reset when G changes).
+pub static RELEASE_HINT_PEERS: Gauge = Gauge::new();
+
+pub fn render_hbbs(now: &HbbsNow) -> String {
+    let mut o = String::new();
+    header(&mut o, "hbbs_release_generation", "gauge", "Release generation G pushed to hosts (tether-api release-generation; 0 = none).");
+    sample(&mut o, "hbbs_release_generation", "", RELEASE_GENERATION.get() as f64);
+    header(&mut o, "hbbs_release_hints_sent_total", "counter", "ReleaseHint frames sent to registered WebSocket hosts (reason change: G changed; register: after a registration).");
+    sample(&mut o, "hbbs_release_hints_sent_total", "reason=\"change\"", RELEASE_HINTS[0].get() as f64);
+    sample(&mut o, "hbbs_release_hints_sent_total", "reason=\"register\"", RELEASE_HINTS[1].get() as f64);
+    header(&mut o, "hbbs_release_hint_peers_notified", "gauge", "Registered WebSocket hosts that got the current release generation.");
+    sample(&mut o, "hbbs_release_hint_peers_notified", "", RELEASE_HINT_PEERS.get() as f64);
+    header(&mut o, "hbbs_peers_online", "gauge", "Hosts registered within the last 30 s (REG_TIMEOUT).");
+    sample(&mut o, "hbbs_peers_online", "", now.peers_online as f64);
+    header(&mut o, "hbbs_peers_signalling", "gauge", "Online hosts by signalling path: tcp = over a TCP or WebSocket connection, udp = the rest.");
+    sample(&mut o, "hbbs_peers_signalling", "transport=\"tcp_ws\"", now.tcp_signalling as f64);
+    sample(&mut o, "hbbs_peers_signalling", "transport=\"udp\"", now.peers_online.saturating_sub(now.tcp_signalling) as f64);
+    header(&mut o, "hbbs_peers_in_memory", "gauge", "Peers held in memory (online or not).");
+    sample(&mut o, "hbbs_peers_in_memory", "", now.peers_in_memory as f64);
+    header(&mut o, "hbbs_connections", "gauge", "Open connections to the rendezvous ports.");
+    for i in 1..3 {
+        sample(&mut o, "hbbs_connections", &format!("transport=\"{}\"", TRANSPORTS[i]), CONNECTIONS[i].get() as f64);
+    }
+    header(&mut o, "hbbs_register_peer_total", "counter", "RegisterPeer messages received.");
+    for (i, t) in TRANSPORTS.iter().enumerate() {
+        sample(&mut o, "hbbs_register_peer_total", &format!("transport=\"{t}\""), REGISTER_PEER[i].get() as f64);
+    }
+    header(&mut o, "hbbs_register_pk_total", "counter", "RegisterPk answers by result.");
+    for (i, r) in REGISTER_PK_RESULTS.iter().enumerate() {
+        if i != 1 {
+            sample(&mut o, "hbbs_register_pk_total", &format!("result=\"{r}\""), REGISTER_PK[i].get() as f64);
+        }
+    }
+    header(&mut o, "hbbs_punch_hole_total", "counter", "PunchHoleRequest outcomes (ok = punch hole sent, lan = local address fetch).");
+    for (i, r) in PUNCH_RESULTS.iter().enumerate() {
+        sample(&mut o, "hbbs_punch_hole_total", &format!("result=\"{r}\""), PUNCH[i].get() as f64);
+    }
+    header(&mut o, "hbbs_ip_blocked_total", "counter", "RegisterPk refused by the per-IP brute-force guard.");
+    sample(&mut o, "hbbs_ip_blocked_total", "reason=\"rate\"", IP_BLOCKED[0].get() as f64);
+    sample(&mut o, "hbbs_ip_blocked_total", "reason=\"ids\"", IP_BLOCKED[1].get() as f64);
+
+    header(&mut o, "hbbs_relay_failover", "gauge", "1 while no primary relay is healthy and backups are handed out.");
+    sample(&mut o, "hbbs_relay_failover", "", FAILOVER.get() as f64);
+    header(&mut o, "hbbs_relay_failover_transitions_total", "counter", "Switches between primary and backup relays.");
+    sample(&mut o, "hbbs_relay_failover_transitions_total", "to=\"backup\"", FAILOVER_TRANSITIONS[0].get() as f64);
+    sample(&mut o, "hbbs_relay_failover_transitions_total", "to=\"primary\"", FAILOVER_TRANSITIONS[1].get() as f64);
+    header(&mut o, "hbbs_relay_checks_total", "counter", "Relay health rounds (every 3 s with more than one relay).");
+    sample(&mut o, "hbbs_relay_checks_total", "", RELAY_CHECKS.get() as f64);
+    let relays = RELAYS.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    header(&mut o, "hbbs_relay_healthy", "gauge", "1 if the relay passed the last health check.");
+    for r in relays.iter().filter(|r| r.name != "none") {
+        let l = relay_labels(r);
+        sample(&mut o, "hbbs_relay_healthy", &l, r.healthy as u8 as f64);
+    }
+    header(&mut o, "hbbs_relay_sessions", "gauge", "Open sessions the relay reported in the last health check.");
+    for r in relays.iter().filter(|r| r.name != "none") {
+        sample(&mut o, "hbbs_relay_sessions", &relay_labels(r), r.sessions as f64);
+    }
+    header(&mut o, "hbbs_relay_assigned_total", "counter", "Relay handed out to a pair of peers (relay=\"none\": none available).");
+    for r in relays.iter() {
+        sample(&mut o, "hbbs_relay_assigned_total", &relay_labels(r), r.assigned as f64);
+    }
+
+    header(&mut o, "hbbs_turn_enabled", "gauge", "1 if hbbs runs the TURN server.");
+    sample(&mut o, "hbbs_turn_enabled", "", now.turn_enabled as u8 as f64);
+    header(&mut o, "hbbs_turn_allocations", "gauge", "Open TURN allocations.");
+    sample(&mut o, "hbbs_turn_allocations", "", now.turn_open as f64);
+    header(&mut o, "hbbs_turn_allocations_max", "gauge", "TURN_MAX_ALLOCATIONS.");
+    sample(&mut o, "hbbs_turn_allocations_max", "", now.turn_max as f64);
+    header(&mut o, "hbbs_turn_allocations_total", "counter", "TURN allocations made.");
+    sample(&mut o, "hbbs_turn_allocations_total", "", TURN_ALLOCATIONS.get() as f64);
+    header(&mut o, "hbbs_turn_allocations_refused_total", "counter", "TURN allocations refused at TURN_MAX_ALLOCATIONS or the limit per client IP.");
+    sample(&mut o, "hbbs_turn_allocations_refused_total", "", TURN_ALLOCATIONS_REFUSED.get() as f64);
+    header(&mut o, "hbbs_turn_requests_total", "counter", "TURN control datagrams (requests and channel data) taken.");
+    sample(&mut o, "hbbs_turn_requests_total", "", TURN_REQUESTS.get() as f64);
+    header(&mut o, "hbbs_turn_dropped_total", "counter", "TURN datagrams dropped: unauthenticated over the rate limit, control queue full, bandwidth cap.");
+    sample(&mut o, "hbbs_turn_dropped_total", "reason=\"unauth_rate\"", TURN_UNAUTH_DROPPED.get() as f64);
+    sample(&mut o, "hbbs_turn_dropped_total", "reason=\"queue_full\"", TURN_QUEUE_DROPPED.get() as f64);
+    sample(&mut o, "hbbs_turn_dropped_total", "reason=\"bandwidth_to_peer\"", TURN_BANDWIDTH_DROPPED[0].get() as f64);
+    sample(&mut o, "hbbs_turn_dropped_total", "reason=\"bandwidth_from_peer\"", TURN_BANDWIDTH_DROPPED[1].get() as f64);
+    header(&mut o, "hbbs_turn_bytes_total", "counter", "Bytes relayed by TURN allocations.");
+    sample(&mut o, "hbbs_turn_bytes_total", "direction=\"to_peer\"", TURN_BYTES[0].get() as f64);
+    sample(&mut o, "hbbs_turn_bytes_total", "direction=\"from_peer\"", TURN_BYTES[1].get() as f64);
+    common(&mut o);
+    o
+}
+
+fn relay_labels(r: &Relay) -> String {
+    let name: String = r.name.chars().filter(|c| !matches!(c, '"' | '\\' | '\n')).take(128).collect();
+    format!("relay=\"{name}\",role=\"{}\"", if r.backup { "backup" } else { "primary" })
+}
+
+// ---- hbbr ----
+
+/// Relay requests waiting for their peer.
+pub static PAIR_WAITING: Gauge = Gauge::new();
+/// Waiting relay requests whose peer never came (30 s).
+pub static PAIR_TIMEOUTS: Counter = Counter::new();
+/// New relay requests refused while draining.
+pub static PAIR_REFUSED_DRAINING: Counter = Counter::new();
+/// Pairs made by transport: [tcp (both raw), ws (either side WebSocket)].
+pub static PAIRED: [Counter; 2] = [Counter::new(), Counter::new()];
+/// Open sessions by transport, as PAIRED.
+pub static RELAY_SESSIONS: [Gauge; 2] = [Gauge::new(), Gauge::new()];
+/// Bytes relayed (each byte is received from one side and sent to the other once).
+pub static RELAY_BYTES: Counter = Counter::new();
+/// Sessions slowed to LIMIT_SPEED after exceeding the downgrade threshold.
+pub static DOWNGRADES: Counter = Counter::new();
+/// Connections or sessions closed because the IP is on the blocklist.
+pub static BLOCKED: Counter = Counter::new();
+
+pub fn render_hbbr(draining: bool) -> String {
+    let mut o = String::new();
+    header(&mut o, "hbbr_sessions", "gauge", "Paired sessions being relayed.");
+    sample(&mut o, "hbbr_sessions", "transport=\"tcp\"", RELAY_SESSIONS[0].get() as f64);
+    sample(&mut o, "hbbr_sessions", "transport=\"ws\"", RELAY_SESSIONS[1].get() as f64);
+    header(&mut o, "hbbr_pairs_total", "counter", "Relay requests paired with their peer.");
+    sample(&mut o, "hbbr_pairs_total", "transport=\"tcp\"", PAIRED[0].get() as f64);
+    sample(&mut o, "hbbr_pairs_total", "transport=\"ws\"", PAIRED[1].get() as f64);
+    header(&mut o, "hbbr_pair_waiting", "gauge", "Relay requests waiting for their peer.");
+    sample(&mut o, "hbbr_pair_waiting", "", PAIR_WAITING.get() as f64);
+    header(&mut o, "hbbr_pair_timeouts_total", "counter", "Relay requests whose peer did not come within 30 s.");
+    sample(&mut o, "hbbr_pair_timeouts_total", "", PAIR_TIMEOUTS.get() as f64);
+    header(&mut o, "hbbr_pair_refused_draining_total", "counter", "New relay requests refused while draining.");
+    sample(&mut o, "hbbr_pair_refused_draining_total", "", PAIR_REFUSED_DRAINING.get() as f64);
+    header(&mut o, "hbbr_relayed_bytes_total", "counter", "Bytes relayed between the two sides of all sessions.");
+    sample(&mut o, "hbbr_relayed_bytes_total", "", RELAY_BYTES.get() as f64);
+    header(&mut o, "hbbr_downgrades_total", "counter", "Sessions slowed to LIMIT_SPEED by the bandwidth limiter.");
+    sample(&mut o, "hbbr_downgrades_total", "", DOWNGRADES.get() as f64);
+    header(&mut o, "hbbr_blocked_total", "counter", "Connections or sessions closed for a blocklisted IP.");
+    sample(&mut o, "hbbr_blocked_total", "", BLOCKED.get() as f64);
+    header(&mut o, "hbbr_draining", "gauge", "1 while hbbr drains (stopping, takes no new sessions).");
+    sample(&mut o, "hbbr_draining", "", draining as u8 as f64);
+    common(&mut o);
+    o
+}
+
+// ---- shared ----
+
+fn header(o: &mut String, name: &str, typ: &str, help: &str) {
+    let _ = writeln!(o, "# HELP {name} {help}\n# TYPE {name} {typ}");
+}
+
+fn sample(o: &mut String, name: &str, labels: &str, v: f64) {
+    if labels.is_empty() {
+        let _ = writeln!(o, "{name} {v}");
+    } else {
+        let _ = writeln!(o, "{name}{{{labels}}} {v}");
+    }
+}
+
+fn common(o: &mut String) {
+    header(o, "tether_build_info", "gauge", "Build version.");
+    sample(o, "tether_build_info", &format!("version=\"{}\"", crate::version::VERSION), 1.);
+    process(o);
+}
+
+/// Clock ticks per second of /proc/self/stat (USER_HZ), read once; 100 if sysconf fails.
+fn clk_tck() -> f64 {
+    static HZ: std::sync::OnceLock<f64> = std::sync::OnceLock::new();
+    #[cfg(unix)]
+    let ticks = || unsafe { hbb_common::libc::sysconf(hbb_common::libc::_SC_CLK_TCK) } as i64;
+    #[cfg(not(unix))]
+    let ticks = || -1i64;
+    *HZ.get_or_init(|| hz_or_default(ticks()))
+}
