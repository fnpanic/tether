+    #[test]
+    fn primary_before_backup() {
+        // Primary wins even when more loaded; rotation stays among equally loaded primaries.
+        let rs = vec![r("p1", 5, false), r("p2", 5, false), r("o1", 0, true), r("o2", 0, true)];
+        assert_eq!(pick_relay(&rs, 0), "p1");
+        assert_eq!(pick_relay(&rs, 1), "p2");
+        assert_eq!(pick_relay(&rs, 2), "p1");
+        // No primary healthy (absent from the healthy set): least loaded backup, ties rotate.
+        let rs = vec![r("o1", 1, true), r("o2", 0, true), r("o3", 0, true)];
+        assert_eq!(pick_relay(&rs, 0), "o2");
+        assert_eq!(pick_relay(&rs, 1), "o3");
+        assert!(!has_primary(&rs));
+        // Primary healthy again: back to it.
+        let rs = vec![r("p1", 9, false), r("o2", 0, true)];
+        assert_eq!(pick_relay(&rs, 0), "p1");
+        assert_eq!(pick_relay(&rs, 1), "p1");
