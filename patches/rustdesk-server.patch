+/// Tether: text fields hbbs passes on between peers, capped like ICE candidates.
+fn oversized(msg: &RendezvousMessage) -> bool {
+    use rendezvous_message::Union::*;
+    let (sdp, relay) = match &msg.union {
+        Some(PunchHoleRequest(m)) => (m.webrtc_sdp_offer.len(), 0),
+        Some(PunchHoleSent(m)) => (m.webrtc_sdp_answer.len(), m.relay_server.len()),
+        Some(RelayResponse(m)) => (m.webrtc_sdp_answer.len(), m.relay_server.len()),
+        Some(RequestRelay(m)) => (0, m.relay_server.len()),
+        Some(LocalAddr(m)) => (0, m.relay_server.len()),
+        _ => (0, 0),
+    };
+    sdp > MAX_SDP_LEN || relay > MAX_RELAY_SERVER_LEN
