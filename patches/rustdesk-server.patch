+lazy_static::lazy_static! {
+    /// Tether: public keys accepted besides this server's own during a server key rotation
+    /// (`KEYS_ACCEPT`, comma-separated base64; docs/key-rotation.md).
+    static ref KEYS_ACCEPT: Vec<String> = parse_keys_accept(&std::env::var("KEYS_ACCEPT").unwrap_or_default());
