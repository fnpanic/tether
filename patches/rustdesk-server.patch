+/// They take the client IP from X-Forwarded-For / X-Real-IP, which only the reverse proxy in
+/// front (Caddy/nginx on the same host) may set; where the proxy runs elsewhere (Kubernetes),
+/// set `WS_BIND=0.0.0.0` and keep the port off the public network.
+pub fn ws_bind() -> String {
+    std::env::var("WS_BIND").ok().filter(|v| !v.trim().is_empty()).unwrap_or_else(|| "127.0.0.1".into())
+}
+
+/// The WebSocket listener on `ws_bind()`:`port`.
+pub async fn listen_ws(port: u16) -> hbb_common::ResultType<hbb_common::tokio::net::TcpListener> {
+    let addr = ws_bind();
+    let addr = if addr.contains(':') { format!("[{addr}]:{port}") } else { format!("{addr}:{port}") };
+    hbb_common::tcp::new_listener(addr, true).await
+}
