+        key: get("key", ""),
+        frame_ms: get("frame_ms", "20").parse().unwrap_or(20),
+        frame_bytes: get("frame_bytes", "1024").parse().unwrap_or(1024),
+    };
+    let sessions: usize = get("sessions", "4").parse().unwrap_or(4);
+    let seconds: u64 = get("seconds", "60").parse().unwrap_or(60);
+    let per: u64 = get("session_seconds", "0").parse().unwrap_or(0);
+    let run = format!("{:06x}", rand_suffix());
+    t0();
+    let started = std::time::SystemTime::now();
+    let mut tasks = Vec::new();
+    for i in 0..sessions {
+        let cfg = cfg.clone();
+        let run = run.clone();
+        tasks.push(tokio::spawn(async move {
+            let end = Instant::now() + Duration::from_secs(seconds);
+            let mut out = Vec::new();
+            let mut n = 0;
+            loop {
+                let left = end.saturating_duration_since(Instant::now()).as_secs();
+                if left == 0 {
+                    break;
+                }
+                let secs = if per > 0 { per.min(left) } else { left };
+                out.push(session(cfg.clone(), format!("h{run}{i:02}{n:03}"), secs).await);
+                n += 1;
+                if per == 0 {
+                    break;
+                }
+            }
+            out
+        }));
+    }
+    let mut all = Vec::new();
+    for t in tasks {
+        all.extend(t.await.unwrap_or_default());
+    }
+    let reconnects: u32 = all.iter().map(|r| r.reconnects).sum();
+    let max_gap = all.iter().map(|r| r.max_gap_ms).max().unwrap_or(0);
+    let max_stall = all.iter().map(|r| r.max_stall_ms).max().unwrap_or(0);
+    let incomplete = all.iter().filter(|r| !r.completed || r.frames == 0).count();
+    let out = serde_json::json!({
+        "started_unix": started.duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0),
+        "hbbs": cfg.hbbs, "sessions": all.len(), "seconds": seconds,
+        "frame_ms": cfg.frame_ms, "frame_bytes": cfg.frame_bytes,
+        "reconnects": reconnects, "max_gap_ms": max_gap, "max_stall_ms": max_stall,
+        "incomplete_sessions": incomplete,
+        "per_session": all,
+    });
+    println!("{}", serde_json::to_string_pretty(&out).unwrap_or_default());
+}
