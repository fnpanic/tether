new file mode 100644
index 0000000..b660d01
--- /dev/null
+++ b/src/bin/tether-load.rs
@@ -0,0 +1,1006 @@
+//! Tether server load generator (docs/scaling.md). One process, several modes; every mode prints a
+//! JSON line per report interval and a final summary line.
+//!
+//!   tether-load mode=hosts url=ws://127.0.0.1:21118|tcp://127.0.0.1:21116|udp://127.0.0.1:21116
+//!               n=10000 rate=500 seconds=120 ips=250 key=<hbbs pub key> [probe=10] [viewer=ws://...]
+//!     n hosts register like the Tether client (RegisterPk; over WebSocket a ping every second and
+//!     the empty-frame heartbeat echoed; over TCP/UDP RegisterPeer every 12 s), from `ips` loopback
+//!     source addresses (127.1.x.y, i.e. hosts behind NATs). `probe` viewers per second ask hbbs
+//!     for a random registered host (PunchHoleRequest over `viewer`, default `url`); the host gets
+//!     PunchHole and answers RelayResponse through hbbs, as a real host does.
+//!     Reports registration latency and refusals, ping RTT (the client drops a WebSocket after 3 s
+//!     of silence), PunchHole and RelayResponse latency.
+//!   tether-load mode=relay url=ws://127.0.0.1:21119 pairs=500 kbps=1000 up_kbps=50 fps=30
+//!               seconds=60 rate=100 key=<key>
+//!     pairs host/viewer pairs at hbbr (RequestRelay with a shared uuid), host->viewer `kbps` in
+//!     `fps` frames, viewer->host `up_kbps`; reports throughput, frame latency and stalls.
+//!   tether-load mode=api addr=127.0.0.1:21120 devices=10000 period=900 seconds=120 ips=200 conns=32
+//!     each device once per `period` s: GET /api/server-keys, GET /api/policy (If-None-Match),
+//!     POST /api/heartbeat, X-Forwarded-For from `ips` addresses (tether-api trusts it from
+//!     loopback, as from Caddy); `burst=1` puts every device's cycle into the first `period` s.
+//!   tether-load mode=get addr=127.0.0.1:8080 path=/download/x.exe conns=50 seconds=60 [kbps=0]
+//!     `conns` clients download `path` over and over (kbps > 0: each reads at most that fast).
+use hbb_common::{
+    bytes::{Bytes, BytesMut},
+    bytes_codec::BytesCodec,
+    futures_util::{SinkExt, StreamExt},
+    protobuf::Message as _,
+    rendezvous_proto::*,
+    tokio::{
+        self,
+        io::{AsyncReadExt, AsyncWriteExt},
+        net::{TcpSocket, TcpStream, UdpSocket},
+        sync::Mutex,
+        time::{interval, sleep, timeout, Duration, Instant},
+    },
+    tokio_util::codec::Framed,
+};
+use std::{
+    collections::HashMap,
+    net::{IpAddr, Ipv4Addr, SocketAddr},
+    sync::{
+        atomic::{AtomicU64, AtomicUsize, Ordering::Relaxed},
+        Arc, OnceLock,
+    },
+};
+use tokio_tungstenite::tungstenite::Message;
+
+type Ws = tokio_tungstenite::WebSocketStream<TcpStream>;
+type Error = Box<dyn std::error::Error + Send + Sync>;
+
+#[global_allocator]
+static GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;
+
+// ------------------------------------------------------------------ histogram
+
+/// Latency histogram, 0.1 ms buckets to 10 ms, 1 ms to 100 ms, 10 ms to 1 s, 100 ms to 60 s.
+struct Hist(Vec<AtomicU64>);
+
+impl Hist {
+    const N: usize = 100 + 90 + 90 + 590;
+    fn new() -> Self {
+        Hist((0..Self::N).map(|_| AtomicU64::new(0)).collect())
+    }
+    fn idx(us: u64) -> usize {
+        match us {
+            0..=9_999 => (us / 100) as usize,
+            10_000..=99_999 => 100 + ((us - 10_000) / 1_000) as usize,
+            100_000..=999_999 => 190 + ((us - 100_000) / 10_000) as usize,
+            _ => (280 + ((us - 1_000_000) / 100_000) as usize).min(Self::N - 1),
+        }
+    }
+    fn upper_ms(i: usize) -> f64 {
+        match i {
+            0..=99 => (i + 1) as f64 * 0.1,
+            100..=189 => 10.0 + (i - 99) as f64,
+            190..=279 => 100.0 + (i - 189) as f64 * 10.0,
+            _ => 1000.0 + (i - 279) as f64 * 100.0,
+        }
+    }
+    fn add(&self, d: Duration) {
+        self.0[Self::idx(d.as_micros() as u64)].fetch_add(1, Relaxed);
+    }
+    /// (count, p50, p99, max) in ms, and resets the histogram.
+    fn take(&self) -> serde_json::Value {
+        let v: Vec<u64> = self.0.iter().map(|a| a.swap(0, Relaxed)).collect();
+        let n: u64 = v.iter().sum();
+        let q = |p: f64| {
+            let want = ((n as f64) * p).ceil().max(1.0) as u64;
+            let mut acc = 0;
+            for (i, c) in v.iter().enumerate() {
+                acc += c;
+                if acc >= want {
+                    return Self::upper_ms(i);
+                }
+            }
+            0.0
+        };
+        let max = v.iter().rposition(|c| *c > 0).map_or(0.0, Self::upper_ms);
+        serde_json::json!({"n": n, "p50": q(0.5), "p99": q(0.99), "max": max})
+    }
+}
+
+fn t0() -> Instant {
+    static T0: OnceLock<Instant> = OnceLock::new();
+    *T0.get_or_init(Instant::now)
+}
+
+fn now_us() -> u64 {
+    t0().elapsed().as_micros() as u64
+}
+
+/// Loopback source address number `i` (127.1.0.1, 127.1.0.2, ...): Linux answers on all of 127/8.
+fn src_ip(base: u8, i: usize) -> IpAddr {
+    IpAddr::V4(Ipv4Addr::new(127, base, (i / 250) as u8, (i % 250 + 1) as u8))
+}
+
+async fn tcp_from(src: IpAddr, dst: &str) -> Result<TcpStream, Error> {
+    let dst: SocketAddr = tokio::net::lookup_host(dst).await?.find(|a| a.is_ipv4()).ok_or("no IPv4 address")?;
+    let s = TcpSocket::new_v4()?;
+    s.bind(SocketAddr::new(src, 0))?;
+    let t = timeout(Duration::from_secs(10), s.connect(dst)).await??;
+    t.set_nodelay(true)?;
+    Ok(t)
+}
+
+async fn ws_from(src: IpAddr, url: &str) -> Result<Ws, Error> {
+    let rest = url.strip_prefix("ws://").ok_or("ws:// only")?;
+    let host = rest.split('/').next().unwrap_or(rest);
+    let tcp = tcp_from(src, host).await?;
+    let (ws, _) = timeout(Duration::from_secs(10), tokio_tungstenite::client_async(url, tcp)).await??;
+    Ok(ws)
+}
+
+fn bin(msg: &RendezvousMessage) -> Vec<u8> {
+    msg.write_to_bytes().unwrap_or_default()
+}
+
+fn parse(b: &[u8]) -> Option<rendezvous_message::Union> {
+    RendezvousMessage::parse_from_bytes(b).ok()?.union
+}
+
+fn register_pk(id: &str, i: usize) -> Vec<u8> {
+    let mut pk = [0u8; 32];
+    pk[..8].copy_from_slice(&(i as u64).to_le_bytes());
+    let mut m = RendezvousMessage::new();
+    m.set_register_pk(RegisterPk {
+        id: id.to_owned(),
+        uuid: format!("uuid-{id}").into_bytes().into(),
+        pk: pk.to_vec().into(),
+        ..Default::default()
+    });
+    bin(&m)
+}
+
+fn register_peer(id: &str) -> Vec<u8> {
+    let mut m = RendezvousMessage::new();
+    m.set_register_peer(RegisterPeer { id: id.to_owned(), serial: 0, ..Default::default() });
+    bin(&m)
+}
+
+// ------------------------------------------------------------------ hosts
+
+#[derive(Default)]
+struct HostStats {
+    registered: AtomicUsize,
+    connected: AtomicUsize,
+    connects: AtomicU64,
+    connect_fail: AtomicU64,
+    too_frequent: AtomicU64,
+    other_refusal: AtomicU64,
+    silent_drops: AtomicU64,
+    closed: AtomicU64,
+    punch_ok: AtomicU64,
+    punch_fail: AtomicU64,
+    rr_ok: AtomicU64,
+    rr_timeout: AtomicU64,
+}
+
+struct HostCtx {
+    url: String,
+    viewer: String,
+    key: String,
+    ips: usize,
+    s: HostStats,
+    reg: Hist,
+    rtt: Hist,
+    punch: Hist,
+    rr: Hist,
+    /// Registered host ids (index = host number).
+    up: Vec<std::sync::atomic::AtomicBool>,
+    /// Probe start per host id.
+    pending: Mutex<HashMap<String, Instant>>,
+    /// PunchHoleResponse failures by kind.
+    fails: std::sync::Mutex<HashMap<String, u64>>,
+}
+
+fn host_id(i: usize) -> String {
+    format!("lt{i:07}")
+}
+
+/// Answers a PunchHole like the client: RelayResponse to hbbs on a new connection.
+async fn answer_punch(ctx: Arc<HostCtx>, src: IpAddr, id: String, ph: PunchHole) {
+    if let Some(t) = ctx.pending.lock().await.get(&id) {
+        ctx.punch.add(t.elapsed());
+        ctx.s.punch_ok.fetch_add(1, Relaxed);
+    }
+    let mut rr = RelayResponse {
+        socket_addr: ph.socket_addr,
+        uuid: format!("u-{id}"),
+        relay_server: ph.relay_server,
+        ..Default::default()
+    };
+    rr.set_id(id);
+    let mut m = RendezvousMessage::new();
+    m.set_relay_response(rr);
+    let url = if ctx.url.starts_with("ws://") { ctx.url.clone() } else { ctx.viewer.clone() };
+    if let Ok(mut ws) = ws_from(src, &url).await {
+        ws.send(Message::Binary(bin(&m))).await.ok();
+        sleep(Duration::from_millis(200)).await;
+        ws.close(None).await.ok();
+    }
+}
+
+async fn host_ws(ctx: Arc<HostCtx>, i: usize) {
+    let id = host_id(i);
+    let src = src_ip(1, i % ctx.ips);
+    loop {
+        ctx.s.connects.fetch_add(1, Relaxed);
+        let t = Instant::now();
+        let Ok(mut ws) = ws_from(src, &ctx.url).await else {
+            ctx.s.connect_fail.fetch_add(1, Relaxed);
+            sleep(Duration::from_secs(2)).await;
+            continue;
+        };
+        ctx.s.connected.fetch_add(1, Relaxed);
+        let mut registered = false;
+        let mut tick = interval(Duration::from_secs(1));
+        let mut last_reg = Instant::now();
+        let mut last_rx = Instant::now();
+        let mut ping_sent: Option<Instant> = None;
+        let mut ok = ws.send(Message::Binary(register_pk(&id, i))).await.is_ok();
+        while ok {
+            tokio::select! {
+                _ = tick.tick() => {
+                    // Client: ping every second, silent for 3 s = dead; RegisterPk again every 15 s
+                    // until the server confirmed it.
+                    if last_rx.elapsed() > Duration::from_secs(3) {
+                        ctx.s.silent_drops.fetch_add(1, Relaxed);
+                        break;
+                    }
+                    if ping_sent.is_none() {
+                        ping_sent = Some(Instant::now());
+                    }
+                    ok = ws.send(Message::Ping(Vec::new())).await.is_ok();
+                    if !registered && last_reg.elapsed() >= Duration::from_secs(15) {
+                        last_reg = Instant::now();
+                        ok &= ws.send(Message::Binary(register_pk(&id, i))).await.is_ok();
+                    }
+                }
+                m = ws.next() => {
+                    last_rx = Instant::now();
+                    match m {
+                        Some(Ok(Message::Pong(_))) => {
+                            if let Some(p) = ping_sent.take() { ctx.rtt.add(p.elapsed()); }
+                        }
+                        Some(Ok(Message::Binary(b))) if b.is_empty() => {
+                            ok = ws.send(Message::Binary(Vec::new())).await.is_ok();
+                        }
+                        Some(Ok(Message::Binary(b))) => match parse(&b) {
+                            Some(rendezvous_message::Union::RegisterPkResponse(r)) => {
+                                match r.result.enum_value() {
+                                    Ok(register_pk_response::Result::OK) => {
+                                        if !registered {
+                                            registered = true;
+                                            ctx.reg.add(t.elapsed());
+                                            ctx.s.registered.fetch_add(1, Relaxed);
+                                            ctx.up[i].store(true, Relaxed);
+                                        }
+                                    }
+                                    Ok(register_pk_response::Result::TOO_FREQUENT) => { ctx.s.too_frequent.fetch_add(1, Relaxed); }
+                                    _ => { ctx.s.other_refusal.fetch_add(1, Relaxed); }
+                                }
+                            }
+                            Some(rendezvous_message::Union::PunchHole(ph)) => {
+                                tokio::spawn(answer_punch(ctx.clone(), src, id.clone(), ph));
+                            }
+                            _ => {}
+                        },
+                        Some(Ok(_)) => {}
+                        _ => { ctx.s.closed.fetch_add(1, Relaxed); break; }
+                    }
+                }
+            }
+        }
+        ctx.s.connected.fetch_sub(1, Relaxed);
+        if registered {
+            ctx.s.registered.fetch_sub(1, Relaxed);
+            ctx.up[i].store(false, Relaxed);
+        }
+        sleep(Duration::from_millis(200)).await;
+    }
+}
+
+/// TCP host: framed like the client, kept fresh by RegisterPeer every 12 s (hbbs closes a TCP
+/// connection after 30 s of silence).
+async fn host_tcp(ctx: Arc<HostCtx>, i: usize) {
+    let id = host_id(i);
+    let src = src_ip(1, i % ctx.ips);
+    let dst = ctx.url.trim_start_matches("tcp://").to_owned();
+    loop {
+        ctx.s.connects.fetch_add(1, Relaxed);
+        let t = Instant::now();
+        let Ok(tcp) = tcp_from(src, &dst).await else {
+            ctx.s.connect_fail.fetch_add(1, Relaxed);
+            sleep(Duration::from_secs(2)).await;
+            continue;
+        };
+        ctx.s.connected.fetch_add(1, Relaxed);
+        let mut f = Framed::new(tcp, BytesCodec::new());
+        let mut registered = false;
+        let mut tick = interval(Duration::from_secs(12));
+        let mut ok = f.send(Bytes::from(register_pk(&id, i))).await.is_ok();
+        tick.tick().await;
+        while ok {
+            tokio::select! {
+                _ = tick.tick() => {
+                    let m = if registered { register_peer(&id) } else { register_pk(&id, i) };
+                    ok = f.send(Bytes::from(m)).await.is_ok();
+                }
+                m = f.next() => match m {
+                    Some(Ok(b)) => match parse(&b) {
+                        Some(rendezvous_message::Union::RegisterPkResponse(r)) => match r.result.enum_value() {
+                            Ok(register_pk_response::Result::OK) if !registered => {
+                                registered = true;
+                                ctx.reg.add(t.elapsed());
+                                ctx.s.registered.fetch_add(1, Relaxed);
+                                ctx.up[i].store(true, Relaxed);
+                            }
+                            Ok(register_pk_response::Result::OK) => {}
+                            Ok(register_pk_response::Result::TOO_FREQUENT) => { ctx.s.too_frequent.fetch_add(1, Relaxed); }
+                            _ => { ctx.s.other_refusal.fetch_add(1, Relaxed); }
+                        },
+                        Some(rendezvous_message::Union::PunchHole(ph)) => {
+                            tokio::spawn(answer_punch(ctx.clone(), src, id.clone(), ph));
+                        }
+                        _ => {}
+                    },
+                    _ => { ctx.s.closed.fetch_add(1, Relaxed); break; }
+                }
+            }
+        }
+        ctx.s.connected.fetch_sub(1, Relaxed);
+        if registered {
+            ctx.s.registered.fetch_sub(1, Relaxed);
+            ctx.up[i].store(false, Relaxed);
+        }
+        sleep(Duration::from_millis(200)).await;
+    }
+}
+
+/// UDP host like the stock client: RegisterPk, then RegisterPeer every 12 s.
+async fn host_udp(ctx: Arc<HostCtx>, i: usize) {
+    let id = host_id(i);
+    let src = src_ip(1, i % ctx.ips);
+    let dst: SocketAddr = ctx.url.trim_start_matches("udp://").parse().expect("udp://ip:port");
+    let Ok(sock) = UdpSocket::bind(SocketAddr::new(src, 0)).await else {
+        ctx.s.connect_fail.fetch_add(1, Relaxed);
+        return;
+    };
+    ctx.s.connected.fetch_add(1, Relaxed);
+    let t = Instant::now();
+    let mut registered = false;
+    let mut tick = interval(Duration::from_secs(12));
+    let mut buf = vec![0u8; 4096];
+    let mut sent_pk = Instant::now() - Duration::from_secs(60);
+    loop {
+        tokio::select! {
+            _ = tick.tick() => {
+                if !registered && sent_pk.elapsed() >= Duration::from_secs(5) {
+                    sent_pk = Instant::now();
+                    sock.send_to(&register_pk(&id, i), dst).await.ok();
+                }
+                sock.send_to(&register_peer(&id), dst).await.ok();
+            }
+            r = sock.recv_from(&mut buf) => {
+                let Ok((n, _)) = r else { continue };
+                match parse(&buf[..n]) {
+                    Some(rendezvous_message::Union::RegisterPkResponse(r)) => match r.result.enum_value() {
+                        Ok(register_pk_response::Result::OK) if !registered => {
+                            registered = true;
+                            ctx.reg.add(t.elapsed());
+                            ctx.s.registered.fetch_add(1, Relaxed);
+                            ctx.up[i].store(true, Relaxed);
+                        }
+                        Ok(register_pk_response::Result::TOO_FREQUENT) => { ctx.s.too_frequent.fetch_add(1, Relaxed); }
+                        Ok(register_pk_response::Result::OK) => {}
+                        _ => { ctx.s.other_refusal.fetch_add(1, Relaxed); }
+                    },
+                    Some(rendezvous_message::Union::RegisterPeerResponse(r)) if r.request_pk && registered => {
+                        sock.send_to(&register_pk(&id, i), dst).await.ok();
+                    }
+                    Some(rendezvous_message::Union::PunchHole(ph)) => {
+                        tokio::spawn(answer_punch(ctx.clone(), src, id.clone(), ph));
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+}
+
+/// One viewer request for host `i`: PunchHoleRequest, wait for the RelayResponse.
+async fn probe(ctx: Arc<HostCtx>, n: usize, i: usize) {
+    let id = host_id(i);
+    let src = src_ip(2, n % 250);
+    let Ok(mut ws) = ws_from(src, &ctx.viewer).await else {
+        ctx.s.punch_fail.fetch_add(1, Relaxed);
+        return;
+    };
+    let mut m = RendezvousMessage::new();
+    m.set_punch_hole_request(PunchHoleRequest {
+        id: id.clone(),
+        nat_type: NatType::SYMMETRIC.into(),
+        licence_key: ctx.key.clone(),
+        ..Default::default()
+    });
+    let t = Instant::now();
+    ctx.pending.lock().await.insert(id.clone(), t);
+    if ws.send(Message::Binary(bin(&m))).await.is_err() {
+        ctx.s.punch_fail.fetch_add(1, Relaxed);
+        return;
+    }
+    let r = timeout(Duration::from_secs(10), async {
+        while let Some(Ok(m)) = ws.next().await {
+            if let Message::Binary(b) = m {
+                match parse(&b) {
+                    Some(rendezvous_message::Union::RelayResponse(_)) => return true,
+                    Some(rendezvous_message::Union::PunchHoleResponse(r)) => {
+                        *ctx.fails.lock().unwrap().entry(format!("{:?}", r.failure.enum_value())).or_default() += 1;
+                        return false;
+                    }
+                    _ => {}
+                }
+            }
+        }
+        false
+    })
+    .await;
+    match r {
+        Ok(true) => {
+            ctx.rr.add(t.elapsed());
+            ctx.s.rr_ok.fetch_add(1, Relaxed);
+        }
+        Ok(false) => {
+            ctx.s.punch_fail.fetch_add(1, Relaxed);
+        }
+        Err(_) => {
+            ctx.s.rr_timeout.fetch_add(1, Relaxed);
+        }
+    }
+    ctx.pending.lock().await.remove(&id);
+    ws.close(None).await.ok();
+}
