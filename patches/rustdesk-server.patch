+/// The host id this connection is the signalling path of, if any.
+async fn registered_id(addr: SocketAddr, peer_tx: &TcpPeerTx) -> Option<String> {
+    TCP_PEERS
+        .lock()
+        .await
+        .get(&try_into_v4(addr))
