+/// Set on SIGTERM: the process reports not-ready and finishes what it has (Tether HA).
+static DRAIN_STARTED: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+
+pub fn is_draining() -> bool {
+    DRAIN_STARTED.get().is_some()
+}
+
+/// How long ago draining started, if it has.
+pub fn draining_for() -> Option<std::time::Duration> {
+    DRAIN_STARTED.get().map(|t| t.elapsed())
+}
+
+/// Waits for SIGTERM/SIGINT, then drains: report not-ready at once and keep serving until
+/// `idle()` or DRAIN_TIMEOUT seconds pass (default 0: stop at once). A second signal stops now.
+pub async fn listen_signal_and_drain(idle: fn() -> bool) -> Result<()> {
+    listen_signal().await?;
+    DRAIN_STARTED.get_or_init(Instant::now);
+    let secs: u64 = std::env::var("DRAIN_TIMEOUT").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+    if secs == 0 {
+        return Ok(());
+    }
+    log::info!("draining: not ready, waiting up to {secs}s for open sessions to end");
+    tokio::select! {
+        _ = async { while !idle() { tokio::time::sleep(std::time::Duration::from_millis(200)).await } } => {
+            log::info!("drained");
+        }
+        _ = tokio::time::sleep(std::time::Duration::from_secs(secs)) => {
+            log::info!("drain timeout, closing remaining sessions");
+        }
+        _ = listen_signal() => {
+            log::info!("second signal, stopping now");
+        }
+    }
+    Ok(())
+}
