+// ------------------------------------------------------------------ HTTP (tether-api, downloads)
+
+/// Minimal HTTP/1.1 keep-alive client: (status, body bytes read).
+struct Http {
+    s: TcpStream,
+    buf: BytesMut,
+}
+
+impl Http {
+    async fn connect(addr: &str) -> Result<Http, Error> {
+        let s = TcpStream::connect(addr).await?;
+        s.set_nodelay(true)?;
+        Ok(Http { s, buf: BytesMut::with_capacity(16 << 10) })
+    }
+
+    /// Sends one request and reads the whole response; `kbps` > 0 limits the reading speed.
+    async fn req(&mut self, head: &str, body: &[u8], kbps: u64) -> Result<(u16, u64), Error> {
+        let mut out = head.as_bytes().to_vec();
+        out.extend_from_slice(body);
+        self.s.write_all(&out).await?;
+        let (status, len, chunked, hlen) = loop {
+            if let Some(p) = find(&self.buf, b"\r\n\r\n") {
+                let h = std::str::from_utf8(&self.buf[..p]).unwrap_or("").to_ascii_lowercase();
+                let status = h.split(' ').nth(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+                let len = h
+                    .lines()
+                    .find_map(|l| l.strip_prefix("content-length:").map(|v| v.trim().parse::<u64>().unwrap_or(0)))
+                    .unwrap_or(0);
+                break (status, len, h.contains("transfer-encoding: chunked"), p + 4);
+            }
+            if self.s.read_buf(&mut self.buf).await? == 0 {
+                return Err("closed".into());
+            }
+        };
+        let _ = self.buf.split_to(hlen);
+        if chunked {
+            return Err("chunked responses are not supported".into());
+        }
+        let mut left = len;
+        let t = Instant::now();
+        let mut got = 0u64;
+        while left > 0 {
+            if self.buf.is_empty() {
+                if self.s.read_buf(&mut self.buf).await? == 0 {
+                    return Err("closed".into());
+                }
+            }
+            let n = (self.buf.len() as u64).min(left);
+            let _ = self.buf.split_to(n as usize);
+            left -= n;
+            got += n;
+            if kbps > 0 {
+                let due = Duration::from_secs_f64(got as f64 * 8.0 / (kbps as f64 * 1000.0));
+                if let Some(w) = due.checked_sub(t.elapsed()) {
+                    sleep(w).await;
+                }
+            }
+            self.buf.reserve(16 << 10);
+        }
+        Ok((status, len))
+    }
+}
+
+fn find(h: &[u8], n: &[u8]) -> Option<usize> {
+    h.windows(n.len()).position(|w| w == n)
+}
