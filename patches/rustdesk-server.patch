+async fn api(a: &Args) {
+    let addr = a.get("addr", "127.0.0.1:21120");
+    let devices = a.num("devices", 10_000);
+    let period = a.num("period", 900) as f64;
+    let seconds = a.num("seconds", 120) as u64;
+    let ips = a.num("ips", 200).max(1);
+    let conns = a.num("conns", 32).max(1);
+    let burst = a.num("burst", 0) == 1;
+    let host = a.get("host", "localhost");
+    let stats = Arc::new(ApiStats::default());
+    let lat = Arc::new(Hist::new());
+    let (tx, rx) = async_channel(10_000);
+    // Scheduler: device d starts its cycle at phase(d) + k * period.
+    let sched = tokio::spawn(async move {
+        let start = Instant::now();
+        let mut q: Vec<(f64, usize)> = (0..devices)
+            .map(|d| {
+                let p = if burst { hbb_common::rand::random::<f64>() * period.min(seconds as f64) } else { hbb_common::rand::random::<f64>() * period };
+                (p, d)
+            })
+            .collect();
+        q.sort_by(|x, y| x.0.partial_cmp(&y.0).unwrap());
+        let mut round = 0.0;
+        loop {
+            for (p, d) in &q {
+                let at = Duration::from_secs_f64(round + p);
+                if at > Duration::from_secs(seconds) {
+                    return;
+                }
+                if let Some(w) = at.checked_sub(start.elapsed()) {
+                    sleep(w).await;
+                }
+                if tx.send(*d).await.is_err() {
+                    return;
+                }
+            }
+            round += period;
+            if burst {
+                return;
+            }
+        }
+    });
+    for _ in 0..conns {
+        let (rx, stats, lat, addr, host) = (rx.clone(), stats.clone(), lat.clone(), addr.clone(), host.clone());
+        tokio::spawn(async move {
+            let mut c: Option<Http> = None;
+            while let Ok(d) = rx.recv().await {
+                let ip = src_ip(9, d % ips).to_string().replacen("127.9", "10.9", 1);
+                let hb = format!(
+                    r#"{{"uuid":"{d:08}-0000-4000-8000-000000000000","id":"{:09}","profile":"customer","version":"0.5.21","os":"windows 11","serial":1}}"#,
+                    100_000_000 + d
+                );
+                let reqs = [
+                    (format!("GET /api/server-keys HTTP/1.1\r\nHost: {host}\r\nX-Forwarded-For: {ip}\r\nIf-None-Match: \"0\"\r\n\r\n"), Vec::new()),
+                    (format!("GET /api/policy HTTP/1.1\r\nHost: {host}\r\nX-Forwarded-For: {ip}\r\nIf-None-Match: \"1\"\r\n\r\n"), Vec::new()),
+                    (
+                        format!("POST /api/heartbeat HTTP/1.1\r\nHost: {host}\r\nX-Forwarded-For: {ip}\r\nContent-Type: application/json\r\nContent-Length: {}\r\n\r\n", hb.len()),
+                        hb.into_bytes(),
+                    ),
+                ];
+                for (i, (h, b)) in reqs.iter().enumerate() {
+                    let t = Instant::now();
+                    if c.is_none() {
+                        c = Http::connect(&addr).await.ok();
+                    }
+                    let r = match c.as_mut() {
+                        Some(h2) => timeout(Duration::from_secs(30), h2.req(h, b, 0)).await.map_err(|_| "timeout".into()).and_then(|r| r),
+                        None => Err("connect".into()),
+                    };
+                    match r {
+                        Ok((st, n)) => {
+                            lat.add(t.elapsed());
+                            stats.bytes.fetch_add(n, Relaxed);
+                            stats.count(format!("{}:{st}", ["server-keys", "policy", "heartbeat"][i]));
+                        }
+                        Err(e) => {
+                            let _: Error = e;
+                            stats.errors.fetch_add(1, Relaxed);
+                            c = None;
+                        }
+                    }
+                }
+            }
+        });
+    }
+    let mut tick = interval(Duration::from_secs(a.num("report", 5) as u64));
+    tick.tick().await;
+    loop {
+        tick.tick().await;
+        let st = std::mem::take(&mut *stats.by_status.lock().unwrap());
+        println!(
+            "{}",
+            serde_json::json!({"t": t0().elapsed().as_secs(), "status": st, "errors": stats.errors.swap(0, Relaxed), "latency_ms": lat.take()})
+        );
+        if sched.is_finished() && rx.is_empty() {
+            sleep(Duration::from_secs(2)).await;
+            let st = std::mem::take(&mut *stats.by_status.lock().unwrap());
+            println!("{}", serde_json::json!({"t": t0().elapsed().as_secs(), "final": true, "status": st, "errors": stats.errors.load(Relaxed), "latency_ms": lat.take()}));
+            break;
+        }
+    }
+}
