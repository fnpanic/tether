+
+/// A `-r` entry `<address>[|<health URL>][|backup]` as (address, health URL, backup).
+fn relay_entry(entry: &str) -> (&str, Option<&str>, bool) {
+    let mut parts = entry.split('|').map(str::trim);
+    let addr = parts.next().unwrap_or("");
+    let (mut url, mut backup) = (None, false);
+    for p in parts {
+        if p.eq_ignore_ascii_case("backup") {
+            backup = true;
+        } else if !p.is_empty() {
+            url = Some(p);
+        }
+    }
+    (addr, url, backup)
+}
+
+fn has_primary(relays: &[(String, usize, bool)]) -> bool {
+    relays.iter().any(|r| !r.2)
+}
+
+/// Open sessions from a relay's `/readyz` body (`ready sessions=N`); 0 if it does not say.
+fn parse_sessions(body: &str) -> usize {
+    body.split_whitespace()
+        .find_map(|w| w.strip_prefix("sessions=")?.parse().ok())
+        .unwrap_or(0)
+}
+
+/// The least loaded healthy primary relay, or backup relay when no primary is healthy;
+/// `rotation` spreads new sessions over equally loaded ones.
+// shortcut: load is sampled every 3 s, so a burst inside one interval goes to the same relay
+// (moot with one primary, today's setup). Count handed-out sessions locally once two or more
+// primaries run (docs/scaling.md) and a burst can reach a relay's headroom.
+fn pick_relay(relays: &[(String, usize, bool)], rotation: usize) -> String {
+    let backup = !has_primary(relays);
+    let pool: Vec<_> = relays.iter().filter(|r| r.2 == backup).collect();
+    let Some(min) = pool.iter().map(|r| r.1).min() else {
+        return "".to_owned();
+    };
+    let best: Vec<&String> = pool.iter().filter(|r| r.1 == min).map(|r| &r.0).collect();
+    best[rotation % best.len()].clone()
+}
+
+/// Canonical text form of an IP: IPv4-mapped IPv6 (`::ffff:a.b.c.d`) becomes `a.b.c.d`.
+/// Client IP of a WebSocket connection behind the proxy: the last X-Forwarded-For hop, which the
+/// proxy (Caddy) appends itself. X-Real-IP and earlier hops can come from the client.
+fn forwarded_ip(headers: &tokio_tungstenite::tungstenite::http::HeaderMap) -> Option<String> {
+    let xff = headers.get_all("X-Forwarded-For").iter().last()?.to_str().ok()?;
+    Some(xff.rsplit(',').next()?.trim().to_owned()).filter(|ip| !ip.is_empty())
+}
+
+fn norm_ip(ip: &str) -> String {
+    match ip.parse::<std::net::IpAddr>() {
+        Ok(std::net::IpAddr::V6(v6)) => match v6.to_ipv4_mapped() {
+            Some(v4) => v4.to_string(),
+            None => v6.to_string(),
+        },
+        Ok(v4) => v4.to_string(),
+        Err(_) => ip.to_owned(),
+    }
+}
