+#[derive(Default)]
+struct RelayStats {
+    paired: AtomicUsize,
+    pair_fail: AtomicU64,
+    down_bytes: AtomicU64,
+    up_bytes: AtomicU64,
+    stalls: AtomicU64,
+    closed: AtomicU64,
+}
+
+struct RelayCtx {
+    url: String,
+    key: String,
+    s: RelayStats,
+    down: Hist,
+    up: Hist,
+}
+
+async fn relay_conn(ctx: &RelayCtx, src: IpAddr, uuid: &str) -> Option<Ws> {
+    let mut ws = match ws_from(src, &ctx.url).await {
+        Ok(ws) => ws,
+        Err(e) => {
+            eprintln!("relay connect from {src}: {e}");
+            return None;
+        }
+    };
+    let mut m = RendezvousMessage::new();
+    m.set_request_relay(RequestRelay { uuid: uuid.to_owned(), licence_key: ctx.key.clone(), ..Default::default() });
+    ws.send(Message::Binary(bin(&m))).await.ok()?;
+    Some(ws)
+}
+
+/// Sends `bytes_per_frame` every `frame` and receives the other side's frames until `end`.
+async fn pump(ctx: Arc<RelayCtx>, ws: Ws, bytes_per_frame: usize, frame: Duration, end: Instant, down: bool) {
+    let (mut tx, mut rx) = ws.split();
+    let c = ctx.clone();
+    let sender = tokio::spawn(async move {
+        let mut tick = interval(frame);
+        while Instant::now() < end {
+            tick.tick().await;
+            let mut f = vec![0u8; bytes_per_frame.max(16)];
+            f[..8].copy_from_slice(&now_us().to_le_bytes());
+            if tx.send(Message::Binary(f)).await.is_err() {
+                break;
+            }
+        }
+        tx.close().await.ok();
+        drop(c);
+    });
+    let mut last = Instant::now();
+    let mut got = false;
+    loop {
+        match timeout(Duration::from_secs(5), rx.next()).await {
+            Ok(Some(Ok(Message::Binary(f)))) if f.len() >= 16 => {
+                let sent = u64::from_le_bytes(f[..8].try_into().unwrap());
+                let lat = Duration::from_micros(now_us().saturating_sub(sent));
+                // A gap of over 1 s between frames that should come every `frame` is a stall.
+                if got && last.elapsed() > Duration::from_secs(1) {
+                    ctx.s.stalls.fetch_add(1, Relaxed);
+                }
+                got = true;
+                last = Instant::now();
+                if down {
+                    // This side is the viewer: frames from the host.
+                    ctx.down.add(lat);
+                    ctx.s.down_bytes.fetch_add(f.len() as u64, Relaxed);
+                } else {
+                    ctx.up.add(lat);
+                    ctx.s.up_bytes.fetch_add(f.len() as u64, Relaxed);
+                }
+            }
+            Ok(Some(Ok(_))) => {}
+            Err(_) if Instant::now() < end => {
+                ctx.s.stalls.fetch_add(1, Relaxed);
+            }
+            _ => break,
+        }
+        if Instant::now() >= end + Duration::from_secs(1) {
+            break;
+        }
+    }
+    ctx.s.closed.fetch_add(1, Relaxed);
+    sender.abort();
+}
+
+async fn relay(a: &Args) {
+    let pairs = a.num("pairs", 100);
+    let kbps = a.num("kbps", 1000) as f64;
+    let up_kbps = a.num("up_kbps", 50) as f64;
+    let fps = a.num("fps", 30).max(1) as f64;
+    let seconds = a.num("seconds", 60) as u64;
+    let rate = a.num("rate", 100).max(1) as u64;
+    let ctx = Arc::new(RelayCtx {
+        url: a.get("url", "ws://127.0.0.1:21119"),
+        key: a.get("key", ""),
+        s: RelayStats::default(),
+        down: Hist::new(),
+        up: Hist::new(),
+    });
+    let frame = Duration::from_secs_f64(1.0 / fps);
+    let down_b = (kbps * 1000.0 / 8.0 / fps) as usize;
+    let up_b = (up_kbps * 1000.0 / 8.0 / fps) as usize;
+    let ramp = pairs as u64 * 1000 / rate;
+    let end = Instant::now() + Duration::from_millis(ramp) + Duration::from_secs(seconds);
+    for i in 0..pairs {
+        let c = ctx.clone();
+        tokio::spawn(async move {
+            let uuid = format!("lt-{i}-{}", hbb_common::rand::random::<u32>());
+            let host = relay_conn(&c, src_ip(3, i % 250), &uuid).await;
+            sleep(Duration::from_millis(50)).await;
+            let viewer = relay_conn(&c, src_ip(4, i % 250), &uuid).await;
+            let (Some(h), Some(v)) = (host, viewer) else {
+                c.s.pair_fail.fetch_add(1, Relaxed);
+                return;
+            };
+            c.s.paired.fetch_add(1, Relaxed);
+            let c2 = c.clone();
+            let hv = tokio::spawn(pump(c2, h, down_b, frame, end, false));
+            pump(c.clone(), v, up_b, frame, end, true).await;
+            hv.await.ok();
+            c.s.paired.fetch_sub(1, Relaxed);
+        });
+        sleep(Duration::from_micros(1_000_000 / rate)).await;
+    }
+    let report = a.num("report", 5) as u64;
+    let mut tick = interval(Duration::from_secs(report));
+    tick.tick().await;
+    let mut last = (0u64, 0u64, Instant::now());
+    loop {
+        tick.tick().await;
+        let (d, u) = (ctx.s.down_bytes.load(Relaxed), ctx.s.up_bytes.load(Relaxed));
+        let dt = last.2.elapsed().as_secs_f64();
+        println!(
+            "{}",
+            serde_json::json!({
+                "t": t0().elapsed().as_secs(), "paired": ctx.s.paired.load(Relaxed),
+                "pair_fail": ctx.s.pair_fail.load(Relaxed), "stalls": ctx.s.stalls.load(Relaxed),
+                "closed": ctx.s.closed.load(Relaxed),
+                "down_mbit_s": ((d - last.0) as f64 * 8.0 / dt / 1e6 * 10.0).round() / 10.0,
+                "up_mbit_s": ((u - last.1) as f64 * 8.0 / dt / 1e6 * 10.0).round() / 10.0,
+                "down_latency_ms": ctx.down.take(), "up_latency_ms": ctx.up.take(),
+            })
+        );
+        last = (d, u, Instant::now());
+        if Instant::now() >= end + Duration::from_secs(2) {
+            break;
+        }
+    }
+}
