+                let tcp = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+                tokio_tungstenite::client_async(format!("ws://127.0.0.1:{port}/ws/id"), tcp).await.unwrap().0
+            };
+            // The next non-heartbeat message, or None within `ms`.
+            async fn next<S: StreamExt<Item = Result<WsMsg, tungstenite::Error>> + Unpin>(ws: &mut S, ms: u64) -> Option<RendezvousMessage> {
+                loop {
+                    match hbb_common::tokio::time::timeout(Duration::from_millis(ms), ws.next()).await {
+                        Ok(Some(Ok(WsMsg::Binary(b)))) if !b.is_empty() => return RendezvousMessage::parse_from_bytes(&b).ok(),
+                        Ok(Some(Ok(_))) => continue,
+                        _ => return None,
+                    }
+                }
+            }
+            let hint = |m: Option<RendezvousMessage>| match m.and_then(|m| m.union) {
+                Some(rendezvous_message::Union::ReleaseHint(h)) => Some((h.generation, h.spread_secs)),
+                _ => None,
+            };
+
+            assert!(set_release_generation(7));
+            assert!(!set_release_generation(7), "unchanged G is not a change");
+            let mut host = connect().await;
+            let mut idle = connect().await;
+            host.send(WsMsg::Binary(register_pk("hinthost1", b"hint-uuid", b"hint-pk"))).await.unwrap();
+            let r = next(&mut host, 3000).await.expect("RegisterPkResponse");
+            assert!(r.has_register_pk_response());
+            assert_eq!(hint(next(&mut host, 3000).await), Some((7, 60)), "current G after registration");
+            // A connection that never registered (a viewer asking once) gets no push.
+            let mut online = RendezvousMessage::new();
+            online.set_online_request(OnlineRequest { id: "x".into(), peers: vec!["hinthost1".into()], ..Default::default() });
+            idle.send(WsMsg::Binary(online.write_to_bytes().unwrap())).await.unwrap();
+            assert!(next(&mut idle, 3000).await.unwrap().has_online_response());
+
+            let before = crate::metrics::RELEASE_HINTS[0].get();
+            assert!(set_release_generation(8));
+            assert_eq!(hint(next(&mut host, 3000).await), Some((8, 60)), "pushed on change");
+            assert_eq!(crate::metrics::RELEASE_HINTS[0].get(), before + 1);
+            assert_eq!(crate::metrics::RELEASE_HINT_PEERS.get(), 1);
+            assert_eq!(crate::metrics::RELEASE_GENERATION.get(), 8);
+            assert!(next(&mut idle, 500).await.is_none(), "unregistered connection got a hint");
+            assert!(next(&mut host, 500).await.is_none(), "one hint per change");
+        });
+    }
+
+    /// A registered host that stops reading: messages for it are dropped once its queue is full
+    /// (hbbs memory stays bounded), and the blocked write closes the connection after
+    /// PEER_SEND_TIMEOUT_MS, which also ends it as the host's signalling path.
+    #[test]
+    fn stalled_host_queue_is_bounded_and_dropped() {
+        use tokio_tungstenite::tungstenite::Message as WsMsg;
+        let _g = DB_ENV.lock().unwrap_or_else(|e| e.into_inner());
+        tokio::runtime::Runtime::new().unwrap().block_on(async {
+            let db = std::env::temp_dir().join(format!("hbbs-stall-{}.sqlite3", std::process::id()));
+            let _ = std::fs::remove_file(&db);
+            std::env::set_var("DB_URL", db.to_str().unwrap());
+            let rs = server(PeerMap::new().await.unwrap());
+            let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let port = listener.local_addr().unwrap().port();
+            tokio::spawn(async move {
+                loop {
+                    let (stream, addr) = listener.accept().await.unwrap();
+                    let mut rs = rs.clone();
+                    tokio::spawn(async move { rs.handle_listener_inner(stream, addr, "", true).await });
+                }
+            });
+            let pause = || hbb_common::tokio::time::sleep(Duration::from_millis(20));
+            let tcp = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+            let addr = try_into_v4(tcp.local_addr().unwrap());
+            let mut host = tokio_tungstenite::client_async(format!("ws://127.0.0.1:{port}/ws/id"), tcp).await.unwrap().0;
+            host.send(WsMsg::Binary(register_pk("stallhost1", b"stall-uuid", b"stall-pk"))).await.unwrap();
+            let tx = loop {
+                if let Some((tx, _)) = TCP_PEERS.lock().await.get(&addr).cloned() {
+                    break tx;
+                }
+                pause().await;
+            };
+            // The host never reads again. Flood it the way the main loop does (try_send).
+            let mut big = RendezvousMessage::new();
+            big.set_ice_candidate(IceCandidate { candidate: "x".repeat(60_000), ..Default::default() });
+            let mut queued = 0;
+            for _ in 0..2_000 {
+                queued += tx.try_send(big.clone()).is_ok() as usize;
+                hbb_common::tokio::task::yield_now().await;
+            }
+            assert!(queued < 1_000, "{queued} messages of 60 KB queued for a host that does not read");
+            let t = std::time::Instant::now();
+            while is_signalling_path(addr).await {
+                assert!(t.elapsed() < Duration::from_secs(20), "stalled connection still the host's path");
+                pause().await;
+            }
+            drop(host);
+            let _ = std::fs::remove_file(&db);
+        });
+    }
+
+    /// RegisterPk over UDP: the source address is the sender's choice, so it cannot stand in for
+    /// "same machine" when the key changes. First registrations and unchanged keys work as before.
+    #[test]
+    fn udp_register_pk_cannot_replace_a_key() {
+        let _g = DB_ENV.lock().unwrap_or_else(|e| e.into_inner());
+        tokio::runtime::Runtime::new().unwrap().block_on(async {
+            let db = std::env::temp_dir().join(format!("hbbs-udpkey-{}.sqlite3", std::process::id()));
+            let _ = std::fs::remove_file(&db);
+            std::env::set_var("DB_URL", db.to_str().unwrap());
+            let mut rs = server(PeerMap::new().await.unwrap());
+            let id = "udpkey01";
+            let rk = |pk: &'static str| RegisterPk {
+                id: id.into(),
+                uuid: Bytes::from_static(b"host-uuid"),
+                pk: Bytes::from_static(pk.as_bytes()),
+                ..Default::default()
+            };
+            let res = |m: Option<RendezvousMessage>| m.unwrap().register_pk_response().result.enum_value().unwrap();
+            let host: SocketAddr = "198.51.100.90:5000".parse().unwrap();
+            let evil: SocketAddr = "203.0.113.90:5000".parse().unwrap();
+            use register_pk_response::Result::OK;
+            assert_eq!(res(rs.register_pk(rk("host-pk"), host, true).await), OK, "first registration over UDP");
+            // The takeover: the host's uuid in a datagram that claims the host's address.
+            assert_eq!(res(rs.register_pk(rk("evil-pk"), host, true).await), UUID_MISMATCH);
+            assert_eq!(rs.pm.get_in_memory(id).await.unwrap().read().await.pk.as_ref(), b"host-pk");
+            // ... so its second step, the same key from the attacker's own address, fails too.
+            assert_eq!(res(rs.register_pk(rk("evil-pk"), evil, false).await), UUID_MISMATCH);
+            assert_eq!(res(rs.register_pk(rk("host-pk"), host, true).await), OK, "unchanged key over UDP");
+            // A connection's address is real: the host changes its key over TCP/WebSocket as before.
+            assert_eq!(res(rs.register_pk(rk("new-pk"), host, false).await), OK);
+            assert_eq!(rs.pm.get_in_memory(id).await.unwrap().read().await.pk.as_ref(), b"new-pk");
+            let _ = std::fs::remove_file(&db);
+        });
+    }
+
+    /// What hbbs does with datagrams: a forged RegisterPeer or RegisterPk from the IP of a host
+    /// registered over WebSocket neither moves its signalling path nor changes its key, and a
+    /// client whose connection has ended registers over UDP as before.
+    #[test]
+    fn udp_datagrams_do_not_take_over_a_websocket_host() {
+        let _g = DB_ENV.lock().unwrap_or_else(|e| e.into_inner());
+        tokio::runtime::Runtime::new().unwrap().block_on(async {
+            let db = std::env::temp_dir().join(format!("hbbs-udppath-{}.sqlite3", std::process::id()));
+            let _ = std::fs::remove_file(&db);
+            std::env::set_var("DB_URL", db.to_str().unwrap());
+            let mut rs = server(PeerMap::new().await.unwrap());
+            let mut socket = FramedSocket::new("127.0.0.1:0").await.unwrap();
+            // Somewhere for hbbs's answers to go; the sender's address in every datagram below.
+            let sender = hbb_common::tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+            let udp = sender.local_addr().unwrap();
+            let id = "udppath1";
+            let host: SocketAddr = "127.0.0.1:40000".parse().unwrap();
+            let (host_tx, _h) = mpsc::channel(PEER_QUEUE);
+            assert!(rs.handle_tcp(&register_pk(id, b"host-uuid", b"host-pk"), &mut None, host, "", true, &host_tx).await);
+            assert_eq!(path(&rs, id).await, host);
+
+            rs.handle_udp(&BytesMut::from(&register_peer(id)[..]), udp, &mut socket, "").await.unwrap();
+            assert_eq!(path(&rs, id).await, host, "a datagram moved a WebSocket host's path");
+            rs.handle_udp(&BytesMut::from(&register_pk(id, b"host-uuid", b"evil-pk")[..]), udp, &mut socket, "").await.unwrap();
+            assert_eq!(path(&rs, id).await, host);
+            assert_eq!(rs.pm.get_in_memory(id).await.unwrap().read().await.pk.as_ref(), b"host-pk", "a datagram changed the key");
+            // The registered key from another (forged) IP: accepted before, and the path went there.
+            let other: SocketAddr = "127.0.0.2:9".parse().unwrap();
+            rs.handle_udp(&BytesMut::from(&register_pk(id, b"host-uuid", b"host-pk")[..]), other, &mut socket, "").await.unwrap();
+            assert_eq!(path(&rs, id).await, host, "RegisterPk in a datagram moved a WebSocket host's path");
+
+            // The connection ends (handle_listener_inner removes the entry): UDP registers.
+            TCP_PEERS.lock().await.remove(&host);
+            rs.handle_udp(&BytesMut::from(&register_peer(id)[..]), udp, &mut socket, "").await.unwrap();
+            assert_eq!(path(&rs, id).await, udp, "a client that went over to UDP did not register");
+            let _ = std::fs::remove_file(&db);
+        });
+    }
+
+    /// A connected TCP pair: hbbs's sink for it, and the controller's end.
+    async fn punch_pair() -> (Sink, Framed<TcpStream, BytesCodec>) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let client = TcpStream::connect(listener.local_addr().unwrap()).await.unwrap();
+        let (server, _) = listener.accept().await.unwrap();
+        (Sink::TcpStream(Framed::new(server, BytesCodec::new()).split().0), Framed::new(client, BytesCodec::new()))
+    }
+
+    /// Messages for a controller's punch socket arrive in order and the socket is kept; one that
+    /// does not read costs the caller (the main loop, for UDP hosts) no time and loses its socket.
+    #[test]
+    fn punch_socket_writes_do_not_block_the_caller() {
+        let _g = DB_ENV.lock().unwrap_or_else(|e| e.into_inner());
+        tokio::runtime::Runtime::new().unwrap().block_on(async {
+            let db = std::env::temp_dir().join(format!("hbbs-punch-{}.sqlite3", std::process::id()));
+            let _ = std::fs::remove_file(&db);
+            std::env::set_var("DB_URL", db.to_str().unwrap());
+            let mut rs = server(PeerMap::new().await.unwrap());
+            let ice = |c: String| {
+                let mut m = RendezvousMessage::new();
+                m.set_ice_candidate(IceCandidate { candidate: c, ..Default::default() });
+                m
+            };
+            let reader: SocketAddr = "198.51.100.91:5000".parse().unwrap();
+            let (sink, mut controller) = punch_pair().await;
+            rs.tcp_punch.lock().await.insert(reader, RendezvousServer::punch_writer(sink));
+            for i in 0..10 {
+                rs.send_to_tcp_keep(ice(i.to_string()), reader).await;
+            }
+            for i in 0..10 {
+                let bytes = controller.next().await.unwrap().unwrap();
+                let m = RendezvousMessage::parse_from_bytes(&bytes).unwrap();
+                assert_eq!(m.ice_candidate().candidate, i.to_string());
+            }
+            assert!(rs.tcp_punch.lock().await.contains_key(&reader), "a socket that is read is kept");
+
+            let stalled: SocketAddr = "198.51.100.92:5000".parse().unwrap();
+            let (sink, _never_read) = punch_pair().await;
+            rs.tcp_punch.lock().await.insert(stalled, RendezvousServer::punch_writer(sink));
+            let big = ice("x".repeat(60_000));
+            let t = Instant::now();
+            for _ in 0..1_000 {
+                rs.send_to_tcp_keep(big.clone(), stalled).await;
+            }
+            assert!(t.elapsed() < Duration::from_millis(400), "waited {:?} for a controller that does not read", t.elapsed());
+            assert!(!rs.tcp_punch.lock().await.contains_key(&stalled), "stalled punch socket kept");
+            let _ = std::fs::remove_file(&db);
+        });
+    }
+
+    #[test]
+    fn oversized_fields_and_frames_are_refused() {
+        use tokio_tungstenite::tungstenite::Message as WsMsg;
+        let msg = |sdp: usize, relay: usize| {
+            let mut m = RendezvousMessage::new();
+            m.set_punch_hole_sent(PunchHoleSent {
+                webrtc_sdp_answer: "x".repeat(sdp),
+                relay_server: "x".repeat(relay),
+                ..Default::default()
+            });
+            m
+        };
+        assert!(!oversized(&msg(MAX_SDP_LEN, MAX_RELAY_SERVER_LEN)));
+        assert!(oversized(&msg(MAX_SDP_LEN + 1, 0)));
+        assert!(oversized(&msg(0, MAX_RELAY_SERVER_LEN + 1)));
+        let mut m = RendezvousMessage::new();
+        m.set_punch_hole_request(PunchHoleRequest { webrtc_sdp_offer: "x".repeat(MAX_SDP_LEN + 1), ..Default::default() });
+        assert!(oversized(&m));
+
+        let _g = DB_ENV.lock().unwrap_or_else(|e| e.into_inner());
+        tokio::runtime::Runtime::new().unwrap().block_on(async {
+            let db = std::env::temp_dir().join(format!("hbbs-frame-{}.sqlite3", std::process::id()));
+            let _ = std::fs::remove_file(&db);
+            std::env::set_var("DB_URL", db.to_str().unwrap());
+            let rs = server(PeerMap::new().await.unwrap());
+            let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let port = listener.local_addr().unwrap().port();
+            tokio::spawn(async move {
+                loop {
+                    let (stream, addr) = listener.accept().await.unwrap();
+                    let mut rs = rs.clone();
+                    tokio::spawn(async move { rs.handle_listener_inner(stream, addr, "", true).await });
+                }
+            });
+            // An online query hbbs would answer, were it not larger than MAX_FRAME.
+            let online = |id_len: usize| {
+                let mut m = RendezvousMessage::new();
+                m.set_online_request(OnlineRequest { peers: vec!["x".repeat(id_len); 9_000], ..Default::default() });
+                m.write_to_bytes().unwrap()
+            };
+            assert!(online(10).len() < MAX_FRAME && online(60).len() > MAX_FRAME);
+            for (id_len, answered) in [(10, true), (60, false)] {
+                let tcp = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+                let mut ws = tokio_tungstenite::client_async(format!("ws://127.0.0.1:{port}/ws/id"), tcp).await.unwrap().0;
+                // The server may close while the oversized message is still being written.
+                let _ = ws.send(WsMsg::Binary(online(id_len))).await;
+                let got = hbb_common::tokio::time::timeout(Duration::from_secs(5), ws.next()).await.expect("no answer, not closed");
+                let is_answer = matches!(&got, Some(Ok(WsMsg::Binary(b))) if RendezvousMessage::parse_from_bytes(b).map_or(false, |m| m.has_online_response()));
+                assert_eq!(is_answer, answered, "{id_len}-byte ids: {:.80}", format!("{got:?}"));
+            }
+            // The same over plain TCP (stock clients, port 21116).
+            let rs = server(PeerMap::new().await.unwrap());
+            let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let port = listener.local_addr().unwrap().port();
+            tokio::spawn(async move {
+                loop {
+                    let (stream, addr) = listener.accept().await.unwrap();
+                    let mut rs = rs.clone();
+                    tokio::spawn(async move { rs.handle_listener_inner(stream, addr, "", false).await });
+                }
+            });
+            for (id_len, answered) in [(10, true), (60, false)] {
+                let mut tcp = Framed::new(TcpStream::connect(("127.0.0.1", port)).await.unwrap(), BytesCodec::new());
+                let _ = tcp.send(Bytes::from(online(id_len))).await;
+                let got = hbb_common::tokio::time::timeout(Duration::from_secs(5), tcp.next()).await.expect("no answer, not closed");
+                let is_answer = matches!(&got, Some(Ok(b)) if RendezvousMessage::parse_from_bytes(b).map_or(false, |m| m.has_online_response()));
+                assert_eq!(is_answer, answered, "TCP, {id_len}-byte ids");
+            }
+            let _ = std::fs::remove_file(&db);
+        });
+    }
+
+    /// The RegisterPk limiter's table: stale entries go on the timer, and it is bounded while a
+    /// flood of (spoofed) source addresses lasts.
+    #[test]
+    fn ip_limiter_table_is_pruned_and_bounded() {
+        let _g = DB_ENV.lock().unwrap_or_else(|e| e.into_inner());
+        tokio::runtime::Runtime::new().unwrap().block_on(async {
+            let db = std::env::temp_dir().join(format!("hbbs-limiter-{}.sqlite3", std::process::id()));
+            let _ = std::fs::remove_file(&db);
+            std::env::set_var("DB_URL", db.to_str().unwrap());
+            let rs = server(PeerMap::new().await.unwrap());
+            let now = Instant::now();
+            let day_old = now - Duration::from_secs(DAY_SECONDS + 1);
+            let minute_old = now - Duration::from_secs(IP_BLOCK_DUR + 1);
+            IP_BLOCKER.lock().await.insert("stale".to_owned(), ((0, day_old), (Default::default(), day_old)));
+            assert!(rs.check_ip_blocker("192.0.2.200", "limiter01").await);
+            RendezvousServer::prune_limiters().await;
+            {
+                let lock = IP_BLOCKER.lock().await;
+                assert!(!lock.contains_key("stale"), "an entry older than a day survived the timer");
+                assert!(lock.contains_key("192.0.2.200"));
+            }
+            // A flood: more source addresses than the table takes, each seen once, a minute ago.
+            {
+                let mut lock = IP_BLOCKER.lock().await;
+                for i in 0..IP_BLOCKER_MAX {
+                    lock.insert(format!("flood-{i}"), ((0, minute_old), (Default::default(), now)));
+                }
+            }
+            assert!(!rs.check_ip_blocker("192.0.2.201", "limiter02").await, "the table grew past its bound");
+            assert!(!IP_BLOCKER.lock().await.contains_key("192.0.2.201"));
+            RendezvousServer::prune_limiters().await;
+            assert!(!IP_BLOCKER.lock().await.contains_key("flood-0"));
+            assert!(rs.check_ip_blocker("192.0.2.201", "limiter02").await, "no room after the prune");
+            let _ = std::fs::remove_file(&db);
+        });
+    }
+
+    #[test]
+    fn release_generation_file() {
+        let p = std::env::temp_dir().join(format!("hbbs-relgen-{}", std::process::id()));
+        std::fs::write(&p, "42\n").unwrap();
+        assert_eq!(read_release_generation(p.to_str().unwrap()), Some(42));
+        std::fs::write(&p, "garbage").unwrap();
+        assert_eq!(read_release_generation(p.to_str().unwrap()), None);
+        let _ = std::fs::remove_file(&p);
+        assert_eq!(read_release_generation(p.to_str().unwrap()), None);
+    }
+
+    /// What a client without ReleaseHint in its proto does with the frame: it parses, the union is
+    /// empty (unknown field kept aside), so its `handle_resp` falls through `_ => {}`.
+    #[test]
+    fn release_hint_is_an_unknown_field_for_old_clients() {
+        let bytes = release_hint(9).write_to_bytes().unwrap();
+        // Field 1001, wire type 2: tag varint (1001 << 3 | 2) = 0xca 0x3e.
+        assert_eq!(&bytes[..2], &[0xca, 0x3e]);
+        let mut old = RendezvousMessage::new();
+        // An "old" decoder: the same message type with the field stripped from the descriptor is
+        // not available here, so check the wire rule instead: a message type that lacks field
+        // 1001 (RegisterPeer) parses it as an unknown field.
+        let as_old = RegisterPeer::parse_from_bytes(&bytes).unwrap();
+        assert!(as_old.id.is_empty() && as_old.special_fields.unknown_fields().iter().next().is_some());
+        old.merge_from_bytes(&bytes).unwrap();
+        assert!(old.has_release_hint());
+    }
+}
