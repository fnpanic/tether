+/// Tether: the TCP peer of the health connection, never a header: the proxies in front
+/// (server/caddy, server/nginx, the Helm chart) forward only `/rendezvous/pubkey` to this port.
+/// An IPv4-mapped IPv6 address counts as its IPv4 address.
+fn peer_lookup_allowed(peer: std::net::IpAddr, from: &[ipnetwork::IpNetwork]) -> bool {
+    let peer = peer.to_canonical();
+    peer.is_loopback() || from.iter().any(|n| n.contains(peer))
+}
+
+/// Tether: the ID rule of the clients (RustDesk's custom IDs, numeric generated IDs): 6 to 16
+/// of `A-Z a-z 0-9 _ -`. Anything else is not looked up.
+fn lookup_id_ok(id: &str) -> bool {
+    (6..=16).contains(&id.len()) && id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+}
