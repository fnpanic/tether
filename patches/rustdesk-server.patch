+/// Tether: `/peer-pk/<id>` on hbbs's health endpoint, read by tether-api for an enrolment with a
+/// Tether proof: the key hbbs holds for the ID. Answered only to loopback and to the CIDRs in
+/// `from` (`PEER_LOOKUP_FROM`), so the port is no ID-enumeration oracle where it is reachable.
+pub struct PeerLookup {
+    pub from: Vec<ipnetwork::IpNetwork>,
+    /// The key held for an ID, None when the ID is unknown.
+    pub pk: Box<dyn Fn(String) -> std::pin::Pin<Box<dyn std::future::Future<Output = Option<Vec<u8>>> + Send>> + Send + Sync>,
+}
