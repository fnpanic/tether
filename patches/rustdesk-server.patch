+/// A `-r` entry `<address>[|<health URL>][|backup]` as (address, health URL, backup).
+fn relay_entry(entry: &str) -> (&str, Option<&str>, bool) {
+    let mut parts = entry.split('|').map(str::trim);
+    let addr = parts.next().unwrap_or("");
+    let (mut url, mut backup) = (None, false);
+    for p in parts {
+        if p.eq_ignore_ascii_case("backup") {
+            backup = true;
+        } else if !p.is_empty() {
+            url = Some(p);
+        }
+    }
+    (addr, url, backup)
