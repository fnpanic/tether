+    /// An Allocate request with USERNAME and a MESSAGE-INTEGRITY attribute that is not valid.
+    fn bogus_signed_allocate(n: u32) -> Vec<u8> {
+        signed_allocate(n, &format!("{}:x", now_secs() + 100), None)
+    }
+
+    /// An Allocate request with USERNAME and MESSAGE-INTEGRITY, valid under `secret` if given.
+    fn signed_allocate(n: u32, user: &str, secret: Option<&str>) -> Vec<u8> {
+        let mut b = vec![0x00, 0x03, 0x00, 0x00, 0x21, 0x12, 0xA4, 0x42];
+        b.extend(n.to_be_bytes());
+        b.extend([0u8; 8]);
+        b.extend([0x00, 0x06]);
+        b.extend((user.len() as u16).to_be_bytes());
+        b.extend(user.as_bytes());
+        while b.len() % 4 != 0 {
+            b.push(0);
+        }
+        let len = (b.len() - 20 + 24) as u16;
+        b[2..4].copy_from_slice(&len.to_be_bytes());
+        let mac = secret.map_or(vec![0u8; 20], |s| {
+            let key = generate_auth_key(user, REALM, &password(s, user));
+            let key = ring::hmac::Key::new(ring::hmac::HMAC_SHA1_FOR_LEGACY_USE_ONLY, &key);
+            ring::hmac::sign(&key, &b).as_ref().to_vec()
+        });
+        b.extend([0x00, 0x08, 0x00, 0x14]);
+        b.extend(mac);
+        b
+    }
