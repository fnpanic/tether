        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": false,
        "iconColor": "rgba(255, 152, 48, 0.5)",
        "name": "Restarts",
        "expr": "changes(process_start_time_seconds{node=~\"$node\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "{{job}} restarted on {{node}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
