{
  "uid": "tether-signalling",
  "title": "Tether · Signalling (hbbs)",
  "description": "Registrations, punch holes, relay choice and TURN per node.",
  "tags": [
    "tether"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
