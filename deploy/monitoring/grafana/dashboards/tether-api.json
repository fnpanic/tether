{
  "uid": "tether-api",
  "title": "Tether · API",
  "description": "tether-api requests, latency, errors, workers and data, and the front end (Caddy or nginx) in front of it.",
  "tags": [
    "tether"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up, node)",
          "refId": "node"
        },
        "definition": "label_values(up, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": false,
        "iconColor": "rgba(255, 152, 48, 0.5)",
        "name": "Restarts",
        "expr": "changes(process_start_time_seconds{node=~\"$node\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "{{job}} restarted on {{node}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Tether",
      "type": "dashboards",
      "tags": [
        "tether"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
