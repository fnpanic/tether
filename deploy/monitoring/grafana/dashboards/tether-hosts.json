    {
      "type": "stat",
      "title": "Uptime",
      "id": 5,
      "description": "The Hetzner node reboots nightly at 04:00.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (node) (time() - node_boot_time_seconds{job=\"node\",node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true
