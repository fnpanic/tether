          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 0.7
              },
              {
                "color": "#E02F44",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
